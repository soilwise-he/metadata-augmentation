<https://data.geoscience.earth/ncl/ISO11074v2025/3.337>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.337> ;
        skos:definition  "substance which, by its chemical form, <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.86\">concentration <span class=\"sts-tbx-entailedTerm-num\">(3.86)</span></a></span> or presence, can be dangerous for humans or the environment"@en , "substance qui, par sa forme chimique, sa <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.86\">concentration&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.86)</span></a></span> ou sa présence, peut être dangereuse pour les êtres humains ou l'environnement"@fr ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.337" ;
        skos:note        "Note 1 to entry: It can be present naturally or as a result of human activity."@en , "Note 1 à l’article: Elle peut être présente soit du fait de l'activité de l'homme, soit naturellement."@fr ;
        skos:prefLabel   "potentially harmful substance"@en , "substance potentiellement dangereuse"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.211>
        a                skos:Concept ;
