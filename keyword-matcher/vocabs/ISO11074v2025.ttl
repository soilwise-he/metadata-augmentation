        skos:notation    "3.419" ;
        skos:note        "Note 1 à l’article: Adapté de l’ISO 3534-2:2006, 5.4.4."@fr , "Note 1 to entry: Adapted from ISO 3534-2:2006, 5.4.4."@en ;
        skos:prefLabel   "sampling procedure"@en , "procédure d'échantillonnage"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.480>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.480> ;
        skos:altLabel    "Kd"@en , "Kd"@fr ;
        skos:definition  "rapport de la <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.86\">concentration&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.86)</span></a></span> d'une substance dans la phase solide du sol à celle dans la phase liquide du sol"@fr , "ratio of the <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.86\">concentration <span class=\"sts-tbx-entailedTerm-num\">(3.86)</span></a></span> of a substance in the soil solid phase to that in the soil-water phase"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.480" ;
        skos:prefLabel   "soil-water partition coefficient"@en , "coefficient de répartition sol-eau"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.395>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.395> ;
        skos:definition  "processus d'<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.394\">analyse du risque&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.394)</span></a></span> et d'évaluation des effets préjudiciables sur l'homme et l'environnement, eu égard à la nature, à l'étendue et à la probabilité d'occurrence de ces effets"@fr , "process of <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.394\">risk analysis <span class=\"sts-tbx-entailedTerm-num\">(3.394)</span></a></span> and evaluation of the damaging effects on humans and the environment, with respect to the nature, extent, and probability of occurrence of these effects"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.395" ;
        skos:prefLabel   "risk assessment"@en , "appréciation du risque"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.208>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.208> ;
        skos:definition  "ensemble de toutes les substances végétales et animales mortes et des produits organiques de leur transformation, ainsi que les matériaux organiques incorporés par l'activité humaine, qui se retrouvent dans et sur le sol minéral"@fr , "total of all dead plant and animal substances and their organic transformation products, as well as organic material inserted through anthropogenic activities, appearing in and on mineral soil"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.208" ;
        skos:note        "Note 1 à l’article: Les plantes et les organismes vivants du sol, ainsi que le charbon, ne font pas partie de l'humus, bien qu'ils n'en soient souvent pas séparables."@fr , "Note 1 to entry: Living plants and soil organisms, as well as charcoal, are not counted among humus but are often methodically not separable."@en ;
        skos:prefLabel   "humus"@fr , "humus"@en .

