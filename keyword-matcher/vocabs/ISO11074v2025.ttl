<https://data.geoscience.earth/ncl/ISO11074v2025/3.194>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.194> ;
        skos:definition  "augmentation de la <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.47\">biomasse&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.47)</span></a></span> (<a class=\"sts-xref\" href=\"#iso:std:iso:11074:ed-3:v1:fr:sec:3.48\">3.48</a>) (<a class=\"sts-xref\" href=\"#iso:std:iso:11074:ed-3:v1:fr:sec:3.49\">3.49</a>) (c'est-à-dire la masse fraîche des organismes)"@fr , "increase in <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.47\">biomass <span class=\"sts-tbx-entailedTerm-num\">(3.47)</span></a></span> (<a class=\"sts-xref\" href=\"#iso:std:iso:11074:ed-3:v1:en:sec:3.48\">3.48</a>) (<a class=\"sts-xref\" href=\"#iso:std:iso:11074:ed-3:v1:en:sec:3.49\">3.49</a>) (i.e. the fresh mass of organisms)"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.194" ;
        skos:note        "Note 1 à l’article: Elle est exprimée en pourcentage de la masse fraîche des organismes au début de l'essai."@fr , "Note 1 to entry: It is expressed as a percentage of the fresh mass of organisms at the start of the test."@en ;
        skos:prefLabel   "growth"@en , "croissance"@fr .

