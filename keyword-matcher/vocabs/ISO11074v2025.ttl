<https://data.geoscience.earth/ncl/ISO11074v2025/3.323>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.323> ;
        skos:definition  "organic compound comprised of carbon and hydrogen atoms arranged in varying structural configurations which make up the principal constituents of crude oil and petroleum products"@en , "composé organique comprenant des atomes de carbone et d'hydrogène de structures variées et faisant partie des principaux constituants du pétrole brut et des produits pétroliers"@fr ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.323" ;
        skos:note        "Note 1 à l’article: Le terme «huile minérale» est un terme familièrement utilisé pour désigner les hydrocarbures pétroliers ou les produits pétroliers."@fr , "Note 1 to entry: Mineral oil is a colloquial term for petroleum hydrocarbons or petroleum products."@en ;
        skos:prefLabel   "petroleum hydrocarbon"@en , "hydrocarbure pétrolier"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.238>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.238> ;
        skos:definition  "deposition of waste into or onto the land"@en , "dépôts de déchets dans le sol ou sur le sol"@fr ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.238" ;
        skos:note        "Note 1 à l’article: Il peut en résulter un sol utilisable à d'autres fins."@fr , "Note 1 to entry: It can eventually provide land which can be used for another purpose."@en ;
        skos:prefLabel   "décharge"@fr , "landfill"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.68>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.68> ;
        skos:definition  "procédure visant à assurer l'intégrité de l'<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">échantillon&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> (par exemple, lors de son transport du terrain au laboratoire ou de ses déplacements au sein même du laboratoire), et donc à garantir la possibilité d'obtenir à partir de cet échantillon des données défendables d'un point de vue technique et juridique"@fr , "procedure to ensure <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">sample <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> integrity (e.g. when transferred between the field and laboratory and within a laboratory) and to ensure that the sample will provide legally and technically defensible data"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.68" ;
        skos:note        "Note 1 to entry: See ISO 5667-3:2024, 3.2 for a definition of integrity."@en , "Note 1 à l’article: Voir l’ISO 5667-3:2024, 3.2, pour une définition de l’intégrité."@fr ;
        skos:prefLabel   "chain-of-custody procedure"@en , "procédure de chaîne de conservation"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.112>
