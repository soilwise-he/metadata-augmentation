<https://data.geoscience.earth/ncl/ISO11074v2025/3.285>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.285> ;
