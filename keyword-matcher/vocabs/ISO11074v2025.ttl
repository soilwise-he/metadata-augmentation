        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.211" ;
        skos:prefLabel   "hydrolyse"@fr , "hydrolysis"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.41>
        a                skos:Concept ;
