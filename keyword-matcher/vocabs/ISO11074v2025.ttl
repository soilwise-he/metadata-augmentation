        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.414" ;
        skos:prefLabel   "sampling network"@en , "réseau d'échantillonnage"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.329>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.329> ;
        skos:altLabel    "HAP"@fr , "PAH"@en ;
        skos:definition  "composé dont les molécules contiennent deux ou plusieurs noyaux aromatiques simples qui fusionnent ensemble en partageant deux atomes de carbone adjacents"@fr , "compound whose molecules contain two or more simple aromatic rings fused together by sharing two neighbouring carbon atoms"@en ;
        skos:example     "Naphthalene, anthracene, phenanthrene and benzo(a)pyrene."@en , "Naphtalène, anthracène, phénanthrène et benzo(a)pyrène."@fr ;
