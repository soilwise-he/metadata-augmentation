        skos:definition  "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.268\">écrasement&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.268)</span></a></span> de l'<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">échantillon&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> afin de réduire la granulométrie de l'ensemble de l'échantillon (du sous-échantillon) sans <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.372\">réduire&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.372)</span></a></span> sa <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.406\">taille&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.406)</span></a></span> (masse)"@fr , "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.268\">crushing <span class=\"sts-tbx-entailedTerm-num\">(3.268)</span></a></span> of the <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">sample <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> in order to reduce the particle size of the whole (sub)‑sample without <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.372\">reducing <span class=\"sts-tbx-entailedTerm-num\">(3.372)</span></a></span> the <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.406\">sample size <span class=\"sts-tbx-entailedTerm-num\">(3.406)</span></a></span> (mass)"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.308" ;
        skos:prefLabel   "réduction granulométrique"@fr , "particle size reduction"@en .

