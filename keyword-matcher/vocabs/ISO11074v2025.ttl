<https://data.geoscience.earth/ncl/ISO11074v2025/3.254>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.254> ;
        skos:definition  "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.30\">terre anthropique&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.30)</span></a></span> comprenant le matériau placé sans maîtrise technique et/ou produit par l'activité humaine d'une certaine manière, par exemple par <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.268\">concassage&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.268)</span></a></span> ou lavage, ou résultant d'un processus industriel"@fr , "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.30\">anthropogenic ground <span class=\"sts-tbx-entailedTerm-num\">(3.30)</span></a></span> comprising material placed without engineering control and/or manufactured by man in some way, such as through <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.268\">crushing <span class=\"sts-tbx-entailedTerm-num\">(3.268)</span></a></span> or washing, or arising from an industrial process"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.254" ;
        skos:note        "Note 1 to entry: It can comprise mixed natural soil materials (3.286) and/or wastes such as building rubble, timber, refuse and industrial wastes."@en , "Note 1 à l’article: Il peut comprendre un mélange de matériaux naturels du sol (3.286) et/ou de déchets tels que pierraille, bois, rebuts et déchets industriels."@fr ;
        skos:prefLabel   "matériau de remblayage"@fr , "made ground"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.84>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.84> ;
        skos:definition  "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">échantillon&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> constitué d'un certain nombre de <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.218\">prélèvements élémentaires&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.218)</span></a></span>"@fr , "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">sample <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> made of a number of <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.218\">increments <span class=\"sts-tbx-entailedTerm-num\">(3.218)</span></a></span>"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.84" ;
        skos:note        "Note 1 to entry: See cluster sample (3.76)."@en , "Note 1 à l’article: Voir échantillon en grappe (3.76)."@fr ;
        skos:prefLabel   "composite sample"@en , "échantillon composite"@fr ;
        <https://w3id.org/dpv#hasContext>
