        skos:notation    "3.28" ;
        skos:prefLabel   "anthropogenic change"@en , "changement de nature anthropique"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.174>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.174> ;
        skos:definition  "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">échantillon&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> utilisé pour des analyses ou des essais sans <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.135\">séchage&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.135)</span></a></span> préliminaire"@fr , "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">sample <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> used for analysis and testing without preliminary <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.135\">drying <span class=\"sts-tbx-entailedTerm-num\">(3.135)</span></a></span>"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.174" ;
        skos:prefLabel   "échantillon frais"@fr , "fresh sample"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.566>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.566> ;
        skos:altLabel    "semi-variogram"@en , "semi-variogramme"@fr ;
        skos:definition  "measure of spatial variation of a variable"@en , "mesure de la variation spatiale d'une variable"@fr ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.566" ;
        skos:prefLabel   "variogram"@en , "variogramme"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.440>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.440> ;
        skos:definition  "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">échantillon&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> de <i>n</i>&nbsp;<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.559\">individus&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.559)</span></a></span> prélevés dans une <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.331\">population&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.331)</span></a></span> de <i>N</i>&nbsp;individus de façon que toutes les combinaisons possibles de <i>n</i>&nbsp;individus aient la même probabilité d'être prélevées"@fr , "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">sample <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> of <i>n</i><span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.559\">items <span class=\"sts-tbx-entailedTerm-num\">(3.559)</span></a></span> taken from a <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.331\">population <span class=\"sts-tbx-entailedTerm-num\">(3.331)</span></a></span> of <i>N</i> items in such a way that all possible combinations of&nbsp;<i>n</i> items have the same probability of being taken"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.440" ;
        skos:note        "Note 1 to entry: Haphazard or arbitrary choice of units is generally insufficient to guarantee randomness."@en , "Note 1 à l’article: Le choix fortuit ou arbitraire des unités est généralement insuffisant pour garantir le caractère aléatoire."@fr ;
        skos:prefLabel   "simple random sample"@en , "échantillon simple aléatoire"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.355>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.355> ;
        skos:definition  "amount of an element determined using a strong acid or combination of acids as extractant"@en , "quantité d'un élément déterminée au moyen d'un acide fort ou d'une combinaison d'acides agissant en qualité de solvant d'extraction"@fr ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.355" ;
        skos:note        "Note 2 to entry: Depending on the element and the soil matrix, the pseudo-total concentration is typically 70 % to 90 % of the true total concentration (3.537) (3.538)."@en , "Note 2 à l’article: La concentration pseudo-totale est généralement comprise, selon l'élément et la matrice du sol, entre 70 % et 90 % de la valeur vraie de la concentration totale (3.537) (3.538)."@fr , "Note 1 à l’article: En général, les solvants d'extraction choisis laissent dans la matrice une faible proportion insoluble de l'élément considéré."@fr , "Note 1 to entry: Typically, a small insoluble proportion of the element under consideration is not removed from the matrix by the chosen extractants."@en ;
        skos:prefLabel   "concentration pseudo-totale"@fr , "pseudo-total concentration"@en ;
        <https://w3id.org/dpv#hasContext>
                "pour les matières inorganiques"@fr , "for inorganics"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.144>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.144> ;
        skos:definition  "civil engineering technique (e.g. <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.155\">excavation <span class=\"sts-tbx-entailedTerm-num\">(3.155)</span></a></span>, <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.90\">containment <span class=\"sts-tbx-entailedTerm-num\">(3.90)</span></a></span>, hydraulic control) used to remove the <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.91\">contaminant <span class=\"sts-tbx-entailedTerm-num\">(3.91)</span></a></span><span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.484\">source <span class=\"sts-tbx-entailedTerm-num\">(3.484)</span></a></span> or <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.459\">soil material <span class=\"sts-tbx-entailedTerm-num\">(3.459)</span></a></span> or to modify pathways without necessarily removing, destroying, or modifying the source"@en , "méthodes se fondant sur des techniques classiques de génie civil (par exemple, <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.155\">excavation&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.155)</span></a></span>, <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.90\">confinement&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.90)</span></a></span>, régulation hydraulique) pour éliminer la <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.484\">source&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.484)</span></a></span> de&nbsp;<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.91\">contaminant&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.91)</span></a></span> ou le <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.459\">matériau de sol&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.459)</span></a></span> contaminé, ou pour en modifier les voies de propagation sans nécessairement éliminer, détruire ou modifier la source"@fr ;
        skos:example     "Par élimination des cibles (récepteurs (3.370)) du site (3.443) ou de ses abords, ou modification de l'usage prévu du site."@fr , "By removing targets (receptors (3.370)) from the site (3.443) or vicinity of the site or changing the intended use of site."@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.144" ;
        skos:prefLabel   "méthodes de génie civil"@fr , "engineering-based method"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.536>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.536> ;
        skos:definition  "upper layer(s) of a natural <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.448\">soil <span class=\"sts-tbx-entailedTerm-num\">(3.448)</span></a></span> that is generally dark coloured and has a higher content of <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.301\">organic matter <span class=\"sts-tbx-entailedTerm-num\">(3.301)</span></a></span> and nutrients when compared to the (mineral) horizons below, excluding the <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.208\">humus <span class=\"sts-tbx-entailedTerm-num\">(3.208)</span></a></span> layer"@en , "couche(s) supérieure(s) d'un <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.448\">sol&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.448)</span></a></span> naturel, généralement de couleur foncée et contenant plus de <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.301\">matières organiques&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.301)</span></a></span> et de nutriments que les horizons (minéraux) sous-jacents, en excluant la couche d'<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.208\">humus&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.208)</span></a></span>"@fr ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.536" ;
        skos:note        "Note 1 to entry: For arable land, topsoil refers to the ploughed soil depth, while for grassland; it is the soil layer with high root content."@en , "Note 1 à l’article: Pour les sols cultivés, l'horizon superficiel correspond à la profondeur de sol labouré; pour les prairies, il s'agit de la couche de sol à forte densité de racines."@fr ;
        skos:prefLabel   "horizon superficiel"@fr , "topsoil"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.410>
        a                skos:Concept ;
        dct:source       "ISO 3534‑2:2006, 1.3.1, modifié — Les Notes à l’article ont été ajoutées."@fr , "ISO 3534-2:2006, 1.3.1, modified — Notes to entry have been added."@en ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.410> ;
        skos:definition  "processus de prélèvement ou de constitution d'un <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">échantillon&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span>"@fr , "act of drawing or constituting a <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">sample <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span>"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.410" ;
        skos:note        "Note 1 à l’article: Pour les besoins de l'étude des sols, le terme «échantillonnage» s'applique également au choix des emplacements auxquels des essais in situ seront effectués sur le terrain sans enlèvement de matériau."@fr , "Note 2 to entry: See in Annex A the relationships between sampling operations."@en , "Note 2 à l’article: Voir les relations entre les opérations d'échantillonnage à l’Annexe A."@fr , "Note 1 to entry: For the purpose of soil investigation, “sampling” also relates to the selection of locations for the purpose of in situ testing carried out in the field without removal of material."@en ;
        skos:prefLabel   "échantillonnage"@fr , "sampling"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.325>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.325> ;
        skos:definition  "disponibilité d'une espèce chimique présente dans le sol pour les végétaux"@fr , "availability of a chemical species present in the soil for plants"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.325" ;
        skos:note        "Note 1 à l’article: Elle est estimée par extraction chimique partielle, dite également «sélective»."@fr , "Note 1 to entry: It is estimated by partial chemical extraction, also called “selective”."@en ;
        skos:prefLabel   "phytoavailability"@en , "phytodisponibilité"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.114>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.114> ;
        skos:definition  "removal or partial removal of <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.202\">hazardous substances <span class=\"sts-tbx-entailedTerm-num\">(3.202)</span></a></span> from the soil, with the aim of restoring <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.453\">soil functions <span class=\"sts-tbx-entailedTerm-num\">(3.453)</span></a></span> and reclaiming the soil for intended usage"@en , "élimination partielle ou totale des <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.202\">substances dangereuses&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.202)</span></a></span> du sol, dans l'intention de restaurer ses <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.453\">fonctions&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.453)</span></a></span> et de le remettre en état pour un usage déterminé"@fr ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.114" ;
        skos:note        "Note 1 à l’article: Le terme «décontamination» est à distinguer de «l’élimination de la contamination» étant donné qu’une contamination (3.93) n’est pas nécessairement dangereuse."@fr , "Note 1 to entry: “Decontamination” is different from “removal of contamination”, since contamination (3.93) is not necessarily harmful."@en ;
        skos:prefLabel   "décontamination"@fr , "decontamination"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.506>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.506> ;
        skos:definition  "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.286\">natural soil material <span class=\"sts-tbx-entailedTerm-num\">(3.286)</span></a></span> below the <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.536\">topsoil <span class=\"sts-tbx-entailedTerm-num\">(3.536)</span></a></span> and overlying the <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.306\">parent material <span class=\"sts-tbx-entailedTerm-num\">(3.306)</span></a></span>"@en , "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.286\">matériau naturel du sol&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.286)</span></a></span>, sous-jacent à l'<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.536\">horizon superficiel&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.536)</span></a></span> et surmontant la <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.306\">roche mère&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.306)</span></a></span>"@fr ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.506" ;
        skos:note        "Note 1 to entry: Much of the original rock structure has usually been obliterated by pedogenic processes."@en , "Note 1 à l’article: Une grande partie de la structure rocheuse originelle a généralement été effacée par les processus pédogéniques."@fr ;
        skos:prefLabel   "sol profond"@fr , "subsoil"@en ;
        <https://w3id.org/dpv#hasContext>
                "général"@fr , "general"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.482>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.482> ;
        skos:definition  "utilisation de liquides non aqueux (par exemple, solvants organiques, gaz supercritiques) pour séparer, par voie physique, des <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.91\">contaminants&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.91)</span></a></span> du <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.448\">sol&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.448)</span></a></span> ou de <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.433\">sédiments&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.433)</span></a></span>"@fr , "use of non-aqueous liquids (e.g. organic solvents, super-critical gases) to physically separate <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.91\">contaminants <span class=\"sts-tbx-entailedTerm-num\">(3.91)</span></a></span> from <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.448\">soil <span class=\"sts-tbx-entailedTerm-num\">(3.448)</span></a></span> or <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.433\">sediment <span class=\"sts-tbx-entailedTerm-num\">(3.433)</span></a></span>"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.482" ;
        skos:prefLabel   "solvent extraction"@en , "extraction aux solvants"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.397>
        a                skos:Concept ;
        dct:source       "Guide ISO/IEC 2:2004, 2.5"@fr , "ISO/IEC Guide 2:2004, 2.5"@en ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.397> ;
        skos:definition  "freedom from <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.554\">unacceptable risk <span class=\"sts-tbx-entailedTerm-num\">(3.554)</span></a></span> of <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.198\">harm <span class=\"sts-tbx-entailedTerm-num\">(3.198)</span></a></span>"@en , "absence de <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.554\">risque inacceptable&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.554)</span></a></span> de <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.198\">dommage&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.198)</span></a></span>"@fr ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.397" ;
        skos:note        "Note 1 à l’article: Dans le cadre de la normalisation, la sécurité d'un produit, d'un processus ou d'un service est généralement envisagée dans l'optique d'assurer l'équilibre optimal entre un certain nombre de facteurs, tels que le comportement humain, permettant d'éliminer les risques (3.393) évitables de dommage aux personnes et aux biens pour arriver à un niveau acceptable."@fr , "Note 1 to entry: In standardization, the safety of products, processes, and services is generally considered with a view to achieving the optimum balance of a number of factors, such as human behaviour, that eliminates avoidable risks (3.393) of harm to persons and goods to an acceptable degree."@en ;
        skos:prefLabel   "sécurité"@fr , "safety"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.271>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.271> ;
        skos:definition  "masse ou volume minimal(e) de matériau d’un <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">échantillon&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> pour laquelle (lequel) la variabilité due aux particules individuelles dudit matériau a un effet négligeable"@fr , "minimum mass or volume of material in a <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">sample <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> for which the variability caused by the individual particles within that material has a negligible effect"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.271" ;
        skos:note        "Note 1 à l’article: La taille minimale d'échantillon est calculée en utilisant une formule qui prend en compte différents facteurs. L'un de ces facteurs est la grandeur admise de la variabilité due aux différences observées entre les particules individuelles. Dès lors qu'une grande valeur est attribuée à ce facteur variabilité, il y a élimination de tout «effet négligeable» tel que mentionné dans la définition. Toutefois, dans une situation normale, une valeur peu élevée est choisie, et seule est admise une grandeur relativement faible de la variabilité."@fr , "Note 1 to entry: The minimum sample size is calculated based on an equation that considers different factors. One of these factors is the variability that is accepted to be caused by the differences between individual particles. When a large amount of variability is chosen for this factor, there will no longer be a “negligible effect”, as mentioned in the definition. However, in normal circumstances, a low value is chosen, accepting only a relatively small amount of variability."@en ;
        skos:prefLabel   "taille minimale d'échantillon"@fr , "minimum sample size"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.186>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.186> ;
        skos:definition  "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.188\">géosynthétique&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.188)</span></a></span> ou produit similaire constitué de matériaux naturels"@fr , "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.188\">geosynthetic <span class=\"sts-tbx-entailedTerm-num\">(3.188)</span></a></span> and similar product made from natural materials"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.186" ;
        skos:prefLabel   "geoproduct"@en , "géoproduit"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.452>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.452> ;
        skos:altLabel    "lavage du sol sur site"@fr , "in situ soil washing"@en ;
        skos:definition  "procédé utilisé sur site pour séparer par voie physique les <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.91\">contaminants&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.91)</span></a></span> du sol en lavant ce dernier à l’eau"@fr , "in situ process in which <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.91\">contaminants <span class=\"sts-tbx-entailedTerm-num\">(3.91)</span></a></span> are physically removed from soil by washing with water"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.452" ;
        skos:note        "Note 1 to entry: Effectiveness (3.142) can be enhanced by use of agents such as surfactants."@en , "Note 1 à l’article: L'efficacité (3.142) peut être améliorée par l'utilisation d'agents tels que les agents tensioactifs."@fr ;
        skos:prefLabel   "rinçage du sol"@fr , "soil flushing"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.367>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.367> ;
        skos:definition  "amount of O<sub>2</sub> consumed per time unit from a mass unit of soil"@en , "quantité d’O<sub>2</sub> consommé par unité de temps à partir d'une unité de masse de sol"@fr ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.367" ;
        skos:note        "Note 2 à l’article: Ce taux est généralement exprimé en milligrammes par gramme par heure (mg ∙ g−1 ∙ h−1)."@fr , "Note 1 à l’article: La consommation d’O2 représente 50 % de la respiration du sol, la production de CO2 représentant l’autre moitié."@fr , "Note 1 to entry: O2 consumption is half part of the soil respiration, the other part is CO2 formation."@en , "Note 2 to entry: It is usually expressed as milligrams per gram per hour (mg ∙ g−1 ∙ h−1)."@en ;
        skos:prefLabel   "taux de consommation d’O2"@fr , "rate of O2 consumption"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.241>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.241> ;
        skos:definition  "processus de <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.318\">percolation de l'eau&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.318)</span></a></span>, qui dilue et élimine les substances solubles (organiques, minérales), lesquelles sont entraînées par gravité (d'un horizon ou d'un volume de sol vers un autre)"@fr , "process of <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.318\">percolating water <span class=\"sts-tbx-entailedTerm-num\">(3.318)</span></a></span> which dilutes and removes soluble substances (organic, mineral) and transports them away under influence of gravity (from one horizon or soil volume to another)"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.241" ;
        skos:prefLabel   "leaching"@en , "lixiviation"@fr ;
        <https://w3id.org/dpv#hasContext>
                "sol naturel"@fr , "natural soil"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.71>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.71> ;
        skos:definition  "traitement d'un sol, d'un <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.433\">sédiment&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.433)</span></a></span>, de l'eau ou d'un autre matériau contaminé dans lequel le mécanisme principal de <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.116\">dégradation&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.116)</span></a></span> ou de transformation en une forme moins nocive pour l'environnement correspond à une réaction chimique ou à une combinaison de réactions chimiques"@fr , "treatment of contaminated soil, <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.433\">sediment <span class=\"sts-tbx-entailedTerm-num\">(3.433)</span></a></span>, water, or other material in which the principal mechanism for <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.116\">degradation <span class=\"sts-tbx-entailedTerm-num\">(3.116)</span></a></span> or conversion to a less environmentally harmful form is a chemical reaction or combination of reactions"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.71" ;
        skos:prefLabel   "chemical treatment"@en , "traitement chimique"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.156>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.156> ;
        skos:altLabel    "phase 2"@en , "phase 2"@fr ;
        skos:definition  "collection of <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">samples <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> for analysis to confirm the hypothesis concerning <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.466\">soil quality <span class=\"sts-tbx-entailedTerm-num\">(3.466)</span></a></span> from&nbsp;<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.342\">phase&nbsp;1 <span class=\"sts-tbx-entailedTerm-num\">(3.342)</span></a></span> investigation and to provide information to enable the design of the <i>main investigation </i>(<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.255\">phase&nbsp;3) <span class=\"sts-tbx-entailedTerm-num\">(3.255)</span></a></span>"@en , "recueil d'<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">échantillons&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> pour analyse permettant de confirmer l'hypothèse concernant la <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.466\">qualité du sol&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.466)</span></a></span> avancée en <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.342\">phase&nbsp;1&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.342)</span></a></span> et de disposer des informations nécessaires à la conception de l'<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.255\">investigation approfondie (phase&nbsp;3)&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.255)</span></a></span>"@fr ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.156" ;
        skos:prefLabel   "exploratory investigation"@en , "investigation exploratoire"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.548>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.548> ;
        skos:definition  "combinaison de méthodes de traitement appliquées, les unes à la suite des autres ou en parallèle, à un <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.448\">sol&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.448)</span></a></span>, à un matériau analogue au sol ou à l'eau, pour en séparer les fractions granulométriques ou autres fractions et pour éliminer, détruire ou immobiliser les <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.91\">contaminants&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.91)</span></a></span>"@fr , "combination of treatment processes applied in sequence or parallel applied to a <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.448\">soil <span class=\"sts-tbx-entailedTerm-num\">(3.448)</span></a></span>, soil‑like material or water to separate out size or other fractions, remove, destroy or immobilise <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.91\">contaminants <span class=\"sts-tbx-entailedTerm-num\">(3.91)</span></a></span>"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.548" ;
        skos:prefLabel   "système de traitement"@fr , "treatment system"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.422>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.422> ;
        skos:definition  "description de l'ensemble du processus d'<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.410\">échantillonnage&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.410)</span></a></span>, basée sur le <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.417\">plan d'échantillonnage&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.417)</span></a></span> et sur <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.421\">l'enregistrement d'échantillonnage&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.421)</span></a></span> et devant décrire la manière dont l'échantillonnage a été planifié et exécuté"@fr , "description of the whole <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.410\">sampling <span class=\"sts-tbx-entailedTerm-num\">(3.410)</span></a></span> process, based on <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.417\">sampling plan <span class=\"sts-tbx-entailedTerm-num\">(3.417)</span></a></span> and <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.421\">sampling record <span class=\"sts-tbx-entailedTerm-num\">(3.421)</span></a></span> and including how the sampling was planned and performed"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.422" ;
        skos:prefLabel   "sampling report"@en , "rapport d'échantillonnage"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.6>
