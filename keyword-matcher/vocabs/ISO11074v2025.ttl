        skos:prefLabel   "exposure"@en , "affleurement"@fr ;
        <https://w3id.org/dpv#hasContext>
                "geology"@en , "géologie"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.424>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.424> ;
        skos:definition  "suite d'étapes selon laquelle un <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.420\">programme d'échantillonnage&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.420)</span></a></span> est conduit"@fr , "arrangement by which a <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.420\">sampling programme <span class=\"sts-tbx-entailedTerm-num\">(3.420)</span></a></span> is conducted"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.424" ;
        skos:note        "Note 1 à l’article: La conception d'un programme d'échantillonnage a pour objectif de permettre aux recherches sur site (3.443) d'aboutir à des conclusions valables et pertinentes dans un souci d'efficacité maximale et de moindre coût. La conception de ce programme doit tenir compte de considérations multiples, telles que le but de la recherche, l'homogénéité du sol/site étudié et le coût de réalisation de l'investigation."@fr , "Note 1 to entry: The purpose of designing a sampling programme is to provide the most efficient and economical methods of reaching valid and relevant conclusions from the investigations of a site (3.443). The design is a function of many considerations such as the aim of the investigation, the homogeneity of the soil/site under consideration, and the cost of performing the investigation."@en ;
        skos:prefLabel   "stratégie d'échantillonnage"@fr , "sampling strategy"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.8>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.8> ;
        skos:definition  "augmentation de la <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.86\">concentration&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.86)</span></a></span> d'une substance dans le sol, due à un <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.508\">apport de substance&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.508)</span></a></span> supérieur à son <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.509\">exportation&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.509)</span></a></span>"@fr , "increase of the <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.86\">concentration <span class=\"sts-tbx-entailedTerm-num\">(3.86)</span></a></span> of a substance in soil due to the fact that the <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.508\">substance input <span class=\"sts-tbx-entailedTerm-num\">(3.508)</span></a></span> is larger than the <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.509\">substance output <span class=\"sts-tbx-entailedTerm-num\">(3.509)</span></a></span>"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.8" ;
        skos:note        "Note 1 to entry: Substance output includes material which is degraded."@en , "Note 1 à l’article: L’exportation de substance comprend les matériaux qui sont dégradés."@fr ;
        skos:prefLabel   "accumulation"@fr , "accumulation"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.339>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.339> ;
        skos:definition  "réaction chimique en solution, qui conduit à la formation d'une phase solide"@fr , "chemical reaction in solution resulting in the formation of a solid product"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.339" ;
        skos:prefLabel   "precipitation"@en , "précipitation"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.213>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.213> ;
        skos:definition  "supposition portant sur le caractère contaminé ou non d'un <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.443\">sol&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.443)</span></a></span> ou supposition sur la nature ou la répartition spatiale de la <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.93\">contamination&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.93)</span></a></span> du sol"@fr , "assumption whether or not a <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.443\">site <span class=\"sts-tbx-entailedTerm-num\">(3.443)</span></a></span> is contaminated or assumption on the nature or spatial distribution of the soil <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.93\">contamination <span class=\"sts-tbx-entailedTerm-num\">(3.93)</span></a></span>"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.213" ;
        skos:prefLabel   "hypothèse de contamination du sol"@fr , "hypothesis of soil contamination"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.43>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.43> ;
        skos:altLabel    "BCF"@en , "FBC"@fr ;
        skos:definition  "ratio of the <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.86\">concentration <span class=\"sts-tbx-entailedTerm-num\">(3.86)</span></a></span> of a substance in an organism to that in the soil"@en , "rapport de la <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.86\">concentration&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.86)</span></a></span> d'une substance dans un organisme à celle dans le sol"@fr ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.43" ;
        skos:prefLabel   "bioconcentration factor"@en , "facteur de bioconcentration"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.128>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.128> ;
        skos:altLabel    "COD"@fr , "DOC"@en ;
        skos:definition  "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.86\">concentration&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.86)</span></a></span> de <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.300\">carbone organique&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.300)</span></a></span> restant en solution après filtration et/ou centrifugation dans des conditions définies"@fr , "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.86\">concentration <span class=\"sts-tbx-entailedTerm-num\">(3.86)</span></a></span> of <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.300\">organic carbon <span class=\"sts-tbx-entailedTerm-num\">(3.300)</span></a></span> remaining in solution after filtration and/or centrifugation under defined conditions"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.128" ;
        skos:note        "Note 1 à l’article: Cette concentration est exprimée en mg/l, g/m3."@fr , "Note 1 to entry: It is expressed in mg/l, g/m3."@en ;
        skos:prefLabel   "dissolved organic carbon"@en , "carbone organique dissous"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.496>
