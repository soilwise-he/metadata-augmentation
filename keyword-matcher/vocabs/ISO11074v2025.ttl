        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.112> ;
        skos:definition  "chemical process designed to remove chlorine from organic chemicals, such as polychlorinated biphenyls (PCB)"@en , "procédé chimique destiné à éliminer le chlore de substances chimiques organiques telles que les biphényles polychlorés&nbsp;(PCB)"@fr ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.112" ;
        skos:prefLabel   "déchloration"@fr , "dechlorination"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.504>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.504> ;
        skos:definition  "procédé de séparation d'un ou de plusieurs <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.503\">sous-échantillons&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.503)</span></a></span> d’un <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">échantillon&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> d'une <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.331\">population&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.331)</span></a></span>"@fr , "process of selecting one or more <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.503\">subsamples <span class=\"sts-tbx-entailedTerm-num\">(3.503)</span></a></span> from a <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">sample <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> of a <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.331\">population <span class=\"sts-tbx-entailedTerm-num\">(3.331)</span></a></span>"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.504" ;
        skos:prefLabel   "subsampling"@en , "sous-échantillonnage"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.419>
        a                skos:Concept ;
