        skos:definition  "unité d'<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.410\">échantillonnage&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.410)</span></a></span> constituée d'un ou de plusieurs <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.218\">prélèvements élémentaires&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.218)</span></a></span> obtenus à partir d'un volume cohérent de matériau, et qui est conservée et traitée indépendamment des autres <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">échantillons&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span>"@fr , "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.410\">sampling <span class=\"sts-tbx-entailedTerm-num\">(3.410)</span></a></span> unit collected by one or more <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.218\">increments <span class=\"sts-tbx-entailedTerm-num\">(3.218)</span></a></span> from a coherent volume of material and kept and treated separately from other <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">samples <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span>"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
