<https://data.geoscience.earth/ncl/ISO11074v2025/3.179>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.179> ;
        skos:definition  "tubage installé de manière appropriée dans un <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.56\">sondage&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.56)</span></a></span> et permettant le prélèvement d'<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">échantillons&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> de gaz du sol afin de mesurer les <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.86\">concentrations&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.86)</span></a></span> de gaz du sol et de surveiller les variations de la composition des <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.454\">gaz du sol&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.454)</span></a></span> ou le transfert des gaz"@fr , "standpipe suitably installed inside a <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.56\">borehole <span class=\"sts-tbx-entailedTerm-num\">(3.56)</span></a></span> from which gas <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">samples <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> can be taken to measure soil gas <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.86\">concentrations <span class=\"sts-tbx-entailedTerm-num\">(3.86)</span></a></span> and to monitor changes in composition of <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.454\">soil gas <span class=\"sts-tbx-entailedTerm-num\">(3.454)</span></a></span> or soil gas migration"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.179" ;
        skos:prefLabel   "gas monitoring well"@en , "puits de surveillance des gaz"@fr .

