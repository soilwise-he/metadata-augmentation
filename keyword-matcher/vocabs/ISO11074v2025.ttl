<https://data.geoscience.earth/ncl/ISO11074v2025/3.387>
        a                skos:Concept ;
        dct:source       "CEN/TR 15310-1:2006, 2.24"@en , "CEN/TR 15310‑1:2006, 2.24"@fr ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.387> ;
        skos:definition  "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">échantillon&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> dans lequel la ou les <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.70\">caractéristiques&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.70)</span></a></span> étudiées sont présentes avec une fiabilité appropriée pour les besoins du programme d'essai"@fr , "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">sample <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> in which the <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.70\">characteristic(s) <span class=\"sts-tbx-entailedTerm-num\">(3.70)</span></a></span> of interest is (are) present with a reliability appropriate for the purpose of the testing programme"@en ;
