        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.473" ;
        skos:prefLabel   "soil sampling device"@en , "dispositif d'échantillonnage du sol"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.388>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.388> ;
        skos:definition  "quantité ou <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.86\">concentration&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.86)</span></a></span> de <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.91\">contaminant&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.91)</span></a></span> restant dans un <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.262\">milieu&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.262)</span></a></span> déterminé après <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.380\">dépollution&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.380)</span></a></span>"@fr , "amount or <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.86\">concentration <span class=\"sts-tbx-entailedTerm-num\">(3.86)</span></a></span> of <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.91\">contaminants <span class=\"sts-tbx-entailedTerm-num\">(3.91)</span></a></span> remaining in a specific <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.262\">medium <span class=\"sts-tbx-entailedTerm-num\">(3.262)</span></a></span>, following <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.380\">remediation <span class=\"sts-tbx-entailedTerm-num\">(3.380)</span></a></span>"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.388" ;
        skos:prefLabel   "contamination résiduelle"@fr , "residual contamination"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.262>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.262> ;
