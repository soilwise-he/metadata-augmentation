        skos:definition  "useful and harmless utilization of <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.459\">soil materials <span class=\"sts-tbx-entailedTerm-num\">(3.459)</span></a></span>"@en , "utilisation sans risque et avec profit de <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.459\">matériaux du sol&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.459)</span></a></span>"@fr ;
