<https://data.geoscience.earth/ncl/ISO11074v2025/3.162>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.162> ;
        skos:altLabel    "exposure route"@en , "trajet d'exposition"@fr ;
        skos:definition  "voie, trajet ou autre chemin suivi par des <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.91\">contaminants&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.91)</span></a></span> ou des <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.202\">substances dangereuses&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.202)</span></a></span> entre une <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.484\">source&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.484)</span></a></span> donnée et un <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.370\">récepteur&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.370)</span></a></span>"@fr , "path, route or other means, a <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.91\">contaminant <span class=\"sts-tbx-entailedTerm-num\">(3.91)</span></a></span> or <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.202\">hazardous substance <span class=\"sts-tbx-entailedTerm-num\">(3.202)</span></a></span> from a particular <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.484\">source <span class=\"sts-tbx-entailedTerm-num\">(3.484)</span></a></span> takes to a <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.370\">receptor <span class=\"sts-tbx-entailedTerm-num\">(3.370)</span></a></span>"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.162" ;
        skos:note        "Note 1 to entry: Each exposure pathway links a source to a receptor."@en , "Note 1 à l’article: Chaque voie d'exposition établit un lien entre une source et un récepteur."@fr ;
        skos:prefLabel   "exposure pathway"@en , "voie d'exposition"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.554>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.554> ;
        skos:definition  "niveau de <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.393\">risque&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.393)</span></a></span> qui exige une <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.380\">dépollution&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.380)</span></a></span>"@fr , "level of <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.393\">risk <span class=\"sts-tbx-entailedTerm-num\">(3.393)</span></a></span> that requires <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.380\">remediation <span class=\"sts-tbx-entailedTerm-num\">(3.380)</span></a></span>"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.554" ;
        skos:note        "Note 1 à l’article: Le niveau de risque peut être évalué par comparaison à un seuil (3.534) numérique ou par référence à une définition explicative. Des niveaux de risque différents sont jugés inacceptables dans des pays ou autres juridictions différent(e)s ou même en fonction des différentes lois applicables au sein d'un même pays ou d'une même juridiction."@fr , "Note 1 to entry: The level of risk can be evaluated by comparison to a numeric threshold (3.534) or by benchmarking against a narrative definition. Different levels of risk are deemed unacceptable in different countries and other jurisdictions or even by different laws within a country or jurisdiction."@en ;
        skos:prefLabel   "unacceptable risk"@en , "risque inacceptable"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.469>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.469> ;
        skos:definition  "action entreprise pour améliorer la capacité d'un <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.117\">sol dégradé&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.117)</span></a></span> ou endommagé à assurer des fonctions spécifiées"@fr , "action taken to improve the capability of a damaged or <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.117\">degraded soil <span class=\"sts-tbx-entailedTerm-num\">(3.117)</span></a></span> to perform specified functions"@en ;
        skos:example     "Addition of organic matter (3.301) and nutrients to promote plant growth (3.194)."@en , "Ajout d'une matière organique (3.301) et de nutriments pour favoriser la croissance (3.194) des végétaux."@fr ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.469" ;
        skos:prefLabel   "réhabilitation d'un sol"@fr , "soil rehabilitation"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.343>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.343> ;
        skos:definition  "opération (par exemple, <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.135\">séchage&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.135)</span></a></span>, <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.268\">concassage&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.268)</span></a></span>, classement) effectuée sur un matériau avant qu'il subisse le traitement principal ou arrive sur une chaîne de traitement"@fr , "activity (e.g. <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.135\">drying <span class=\"sts-tbx-entailedTerm-num\">(3.135)</span></a></span>, <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.268\">grinding <span class=\"sts-tbx-entailedTerm-num\">(3.268)</span></a></span>, grading) applied to a material before it enters the main treatment process or treatment train"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.343" ;
        skos:prefLabel   "pretreatment measure"@en , "mesure de prétraitement"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.258>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.258> ;
        skos:definition  "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">sample <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> obtained by removing specific fractions by separation or selection techniques (e.g.&nbsp;heavy liquid, magnetic, sieving), analysing the fractions separately, and combining the results mathematically"@en , "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">échantillon&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> obtenu en prélevant des fractions spécifiques au moyen de techniques de séparation ou de sélection (par exemple, densimétrique, magnétique, tamisage), en analysant les fractions séparément et en procédant à une recombinaison mathématique des résultats"@fr ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.258" ;
        skos:note        "Note 2 à l’article: Il convient de ne pas confondre ce terme avec le terme «échantillon composite» (3.83) (3.84)."@fr , "Note 1 to entry: When not combined, the sample is a modified sample (3.275) or selective sample (3.436)."@en , "Note 2 to entry: This term should not be confused with composite sample (3.83) (3.84)."@en , "Note 1 à l’article: Non combiné, l'échantillon est un échantillon modifié (3.275) ou un échantillon sélectif (3.436)."@fr ;
        skos:prefLabel   "mathematically combined sample"@en , "échantillon combiné de façon mathématique"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.88>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.88> ;
        skos:definition  "synthèse de toutes les informations concernant un <i>site</i> potentiellement <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.92\">contaminé&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.92)</span></a></span> en rapport avec la tâche à réaliser, avec interprétation si nécessaire et reconnaissance des <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.555\">incertitudes&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.555)</span></a></span>"@fr , "synthesis of all information about a potentially <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.92\">contaminated site <span class=\"sts-tbx-entailedTerm-num\">(3.92)</span></a></span> relevant to the task in hand with interpretation as necessary and recognition of <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.555\">uncertainties <span class=\"sts-tbx-entailedTerm-num\">(3.555)</span></a></span>"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.88" ;
        skos:prefLabel   "conceptual site model"@en , "schéma conceptuel de site"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.132>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.132> ;
        skos:definition  "effet d'une <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.131\">dose&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.131)</span></a></span> donnée (ou d'une grandeur équivalente pour les <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.370\">récepteurs&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.370)</span></a></span> non animaux) sur le récepteur"@fr , "effect a given <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.131\">dose <span class=\"sts-tbx-entailedTerm-num\">(3.131)</span></a></span> (or equivalent quantity for non-animal <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.370\">receptors <span class=\"sts-tbx-entailedTerm-num\">(3.370)</span></a></span>) has on the receptor"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.132" ;
        skos:prefLabel   "dose-response relationship"@en , "relation dose-effet"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.524>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.524> ;
