        skos:definition  "matériau provenant d'un <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.545\">sol traité&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.545)</span></a></span> et déplacé et/ou modifié par l'activité humaine"@fr , "material coming from <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.545\">treated soil <span class=\"sts-tbx-entailedTerm-num\">(3.545)</span></a></span> and displaced and/or modified by human activity"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.546" ;
        skos:prefLabel   "treated soil material"@en , "matériau de sol traité"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.420>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.420> ;
        skos:definition  "totalité de l'opération d'échantillonnage, de la première étape, au cours de laquelle l'objet de l'<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.410\">échantillonnage&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.410)</span></a></span> est défini, à l'étape finale, au cours de laquelle les résultats d'analyse sont comparés au(x) niveau(x) d'essai correspondant(s)"@fr , "total sampling operation, from the first step in which the purpose of <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.410\">sampling <span class=\"sts-tbx-entailedTerm-num\">(3.410)</span></a></span> is defined to the last step in which the analytical results are compared with the relevant test level(s)"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.420" ;
        skos:prefLabel   "programme d'échantillonnage"@fr , "sampling programme"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.4>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.4> ;
        skos:definition  "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.443\">site&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.443)</span></a></span> de décharge laissé par son propriétaire ou un autre responsable dans un état non entretenu"@fr , "waste disposal <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.443\">site <span class=\"sts-tbx-entailedTerm-num\">(3.443)</span></a></span> left by the owner or other responsible party in unmanaged condition"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.4" ;
        skos:prefLabel   "abandoned waste disposal site"@en , "site de décharge abandonné"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.335>
        a                skos:Concept ;
        dct:source       "ISO 6107:2021, 3.422"@fr , "ISO 6107:2021, 3.422"@en ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.335> ;
        skos:definition  "essai qui contient une quantité connue d'analyte dans le <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.524\">matériau d'essai&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.524)</span></a></span>, qui produit une réponse connue"@fr , "test which contains a known amount of the analyte in the <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.524\">test material <span class=\"sts-tbx-entailedTerm-num\">(3.524)</span></a></span> which will produce a known response"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.335" ;
        skos:prefLabel   "témoin positif"@fr , "positive control"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.124>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.124> ;
        skos:definition  "input of a substance emitted from moving sources, from sources with a large area or from many sources"@en , "apport d'une substance émise par des sources mobiles, des sources de grande étendue ou par plusieurs sources"@fr ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.124" ;
        skos:note        "Note 1 à l’article: En pratique, deux situations sont généralement reconnues: les zones rurales avec des apports dus à une source (3.484) diffuse généralement issus de la dissémination sur le terrain et des dépôts aériens, et les zones urbaines où les apports dus à une source diffuse proviennent habituellement de la circulation et des activités industrielles."@fr , "Note 2 to entry: Diffuse source input usually leads to sites (3.443) that are relatively uniformly contaminated. At some sites, the input conditions can nevertheless cause a higher local input, such as near the source or where atmospheric deposition/rain is increased."@en , "Note 1 to entry: In practice, two situations are commonly recognized: rural areas with diffuse source (3.484) inputs typically from land spreading and aerial deposition; and urban areas where the diffuse source inputs come typically from traffic and industrial activities."@en , "Note 2 à l’article: Les apports dus à une source diffuse sont habituellement à l'origine de sites (3.443) à contamination relativement uniforme. Pour certains sites cependant, les conditions d'apport peuvent entraîner un apport local plus important à proximité de la source ou à l'endroit où les dépôts atmosphériques/les précipitations s'accumulent."@fr ;
        skos:prefLabel   "apport dû à une source diffuse"@fr , "diffuse source input"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.516>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.516> ;
        skos:definition  "composante du <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.515\">développement durable&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.515)</span></a></span> qui aboutit à la remise en état exploitable de <i>sites</i> abandonnés, dégradés, sous-utilisés et potentiellement <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.92\">contaminés&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.92)</span></a></span> de façon à accroître leurs bienfaits environnementaux, économiques et sociaux"@fr , "component of <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.515\">sustainable development <span class=\"sts-tbx-entailedTerm-num\">(3.515)</span></a></span> that results in the return to use of abandoned, derelict, underused and potentially <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.92\">contaminated sites <span class=\"sts-tbx-entailedTerm-num\">(3.92)</span></a></span> in a way that increases their environmental, economic, and social benefits"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.516" ;
        skos:prefLabel   "sustainable redevelopment"@en , "réaménagement durable"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.492>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.492> ;
        skos:definition  "addition of chemicals to the contaminated material to produce more chemically stable constituents, for example by precipitating soluble metal ions out of solution"@en , "ajout de substances chimiques à un matériau contaminé afin d'obtenir des composés chimiquement plus stables, par exemple par précipitation d'ions métalliques solubles qui se séparent de la solution"@fr ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.492" ;
        skos:note        "Note 1 to entry: Stabilization might not result in an improvement in the physical characteristics (3.70) of the material. For example, it can still remain a relatively mobile sludge, but the toxicity or mobility of the hazardous constituents will have been reduced by the stabilization process."@en , "Note 1 à l’article: Le processus de stabilisation n'apporte pas obligatoirement une amélioration des caractéristiques (3.70) physiques du matériau qui peut, par exemple, conserver son caractère de boue relativement mobile, mais il réduit la toxicité ou la mobilité des composés dangereux."@fr ;
        skos:prefLabel   "stabilization"@en , "stabilisation"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.305>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.305> ;
        skos:definition  "perte d'un électron par un atome ou un groupe d'atomes"@fr , "loss of an electron by an atom or group of atoms"@en ;
        skos:example     "Change in oxidation stage (e.g. As(V) to As(III)), addition of oxygen to an organic molecule, hydrolysis (3.211) of an inorganic or organic species."@en , "Changement d'état d'oxydation [par exemple, As(V) devenant As(III)], ajout d'oxygène à une molécule organique, hydrolyse (3.211) d'une espèce organique ou inorganique."@fr ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.305" ;
        skos:prefLabel   "oxidation"@en , "oxydation"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.281>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.281> ;
        skos:definition  "réseau ramifié formé d'<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.212\">hyphes&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.212)</span></a></span>"@fr , "branched <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.212\">hyphae <span class=\"sts-tbx-entailedTerm-num\">(3.212)</span></a></span> network"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.281" ;
        skos:prefLabel   "mycélium"@fr , "mycelium"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.196>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.196> ;
        skos:definition  "valeur recommandée sans obligation légale"@fr , "value recommended without legal obligation"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.196" ;
        skos:prefLabel   "guideline value"@en , "valeur guide"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.462>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.462> ;
        skos:definition  "part of the soil volume, between the solid particles of the soil"@en , "volume entre les particules solides du sol"@fr ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.462" ;
        skos:prefLabel   "soil pores"@en , "pores du sol"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.377>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.377> ;
        skos:definition  "processus de prélèvement d'<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">échantillons&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> suivant une grille régulière et à des emplacements uniformément répartis tels que les nœuds d'une grille carrée ou triangulaire"@fr , "process of taking <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">samples <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> in a regular pattern and at evenly-spaced locations, such as the nodes of a square or triangular grid"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.377" ;
        skos:prefLabel   "échantillonnage régulier"@fr , "regular sampling"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.251>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.251> ;
        skos:altLabel    "LIE"@fr , "LEL"@en ;
        skos:definition  "fraction volumique minimale d'un mélange de gaz inflammable et d'air qui va entraîner une explosion dans un espace confiné à une température de 25&nbsp;°C et à la pression atmosphérique"@fr , "lowest volume fraction of a mixture of flammable gas with air which will propagate an explosion in a confined space at&nbsp;25&nbsp;°C and atmospheric pressure"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.251" ;
        skos:note        "Note 1 to entry: LEL can be expressed as a percentage or in mg/l or similar units."@en , "Note 2 to entry: For upper explosive limit (UEL), see 3.561."@en , "Note 1 à l’article: La LIE peut être exprimée en pourcentage, en mg/l ou dans des unités similaires."@fr , "Note 2 à l’article: Pour la limite supérieure d'explosivité (LSE), voir 3.561."@fr ;
        skos:prefLabel   "lower explosive limit"@en , "limite inférieure d'explosivité"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.81>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.81> ;
        skos:definition  "lieu (par exemple, sol ou <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.191\">eaux souterraines&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.191)</span></a></span>) où les <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.32\">critères d'évaluation&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.32)</span></a></span> sont mesurés pour vérifier s’ils sont respectés"@fr , "location (e.g. soil or <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.191\">groundwater <span class=\"sts-tbx-entailedTerm-num\">(3.191)</span></a></span>) where the <i>assessment</i><span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.32\">criteria <span class=\"sts-tbx-entailedTerm-num\">(3.32)</span></a></span> is measured to check if the criteria are met"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.81" ;
        skos:prefLabel   "point de conformité"@fr , "compliance point"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.166>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.166> ;
        skos:altLabel    "FC"@en , "CC"@fr ;
        skos:definition  "maximum water content that an unsaturated soil can retain against gravity under undisturbed soil conditions"@en , "teneur en eau maximale qu'un sol non saturé peut retenir contre l'entraînement par gravité, en conditions non perturbées"@fr ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.166" ;
        skos:note        "Note 1 to entry: It is expressed as a mass or volume fraction in per cent."@en , "Note 2 to entry: Conventionally stated as water content 48 h after saturation under conditions of free drainage."@en , "Note 2 à l’article: Conventionnellement, cela correspond à la teneur en eau du sol 48 h après saturation dans des conditions d'écoulement libre."@fr , "Note 1 à l’article: Elle est exprimée en fraction massique ou volumique, en pourcentage."@fr ;
        skos:prefLabel   "field capacity"@en , "capacité au champ"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.558>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.558> ;
        skos:definition  "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.443\">site&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.443)</span></a></span> présentant une <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.86\">concentration&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.86)</span></a></span> globalement uniforme d'une <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.202\">substance dangereuse&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.202)</span></a></span>"@fr , "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.443\">site <span class=\"sts-tbx-entailedTerm-num\">(3.443)</span></a></span> with a generally uniform <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.86\">concentration <span class=\"sts-tbx-entailedTerm-num\">(3.86)</span></a></span> of a <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.202\">hazardous substance <span class=\"sts-tbx-entailedTerm-num\">(3.202)</span></a></span>"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.558" ;
        skos:note        "Note 1 to entry: The extent of the contamination (3.93) is usually large and the gradient of concentration within the site is rather shallow."@en , "Note 1 à l’article: L'étendue de la contamination (3.93) est généralement grande et le gradient de concentration à l'intérieur du site est plutôt faible."@fr ;
        skos:prefLabel   "uniformly contaminated site"@en , "site uniformément contaminé"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.432>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.432> ;
        skos:definition  "étape du traitement ayant recours à des procédés biologiques tels que boues activées ou filtration biologique, ou tout autre procédé donnant des résultats équivalents"@fr , "stage of treatment by biological processes such as activated sludge, biological filtration, or other processes giving equivalent result"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.432" ;
        skos:note        "Note 1 to entry: This treatment forms the second stage (usually the main stage) of a treatment train for contaminated water."@en , "Note 1 à l’article: Ce traitement constitue la deuxième phase (et habituellement la phase principale) d'une chaîne de traitement de l'eau contaminé."@fr ;
        skos:prefLabel   "traitement secondaire"@fr , "secondary treatment"@en ;
        <https://w3id.org/dpv#hasContext>
                "contaminated water"@en , "eau contaminée"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.347>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.347> ;
        skos:definition  "brève description de ce à quoi l'on doit parvenir en réalisant l'<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.410\">échantillonnage&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.410)</span></a></span>; par exemple, les questions auxquelles il faut répondre, les <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.70\">caractéristiques&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.70)</span></a></span> à déterminer et le type des informations, spatiales ou moyennes, requises le cas échéant"@fr , "short description of what is to be achieved by the <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.410\">sampling <span class=\"sts-tbx-entailedTerm-num\">(3.410)</span></a></span> in terms of, for example, questions to answer, <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.70\">characteristics <span class=\"sts-tbx-entailedTerm-num\">(3.70)</span></a></span> to determine, or whether spatial information or average information is required"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.347" ;
        skos:prefLabel   "primary objective"@en , "objectif principal"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.221>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.221> ;
        skos:definition  "substance dont la présence indique celle d'un groupe ou d'un mélange de substances"@fr , "substance representing a group or a mixture of substances"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.221" ;
        skos:prefLabel   "substance indicatrice"@fr , "indicator substance"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.51>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.51> ;
        skos:definition  "utilisation de méthodes de <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.46\">traitement biologique&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.46)</span></a></span> pour décontaminer un sol ou une <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.191\">eau souterraine&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.191)</span></a></span>"@fr , "use of <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.46\">biological treatment <span class=\"sts-tbx-entailedTerm-num\">(3.46)</span></a></span> methods to decontaminate soil or <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.191\">groundwater <span class=\"sts-tbx-entailedTerm-num\">(3.191)</span></a></span>"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.51" ;
        skos:prefLabel   "bioremediation"@en , "biodégradation"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.136>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.136> ;
        skos:definition  "temps nécessaire à la <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.86\">concentration&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.86)</span></a></span> d'un composé donné pour être réduite de&nbsp;50&nbsp;% de sa valeur d'origine"@fr , "time taken for the <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.86\">concentration <span class=\"sts-tbx-entailedTerm-num\">(3.86)</span></a></span> of a given compound to be reduced by 50&nbsp;% of its original value"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.136" ;
        skos:prefLabel   "DT-50"@en , "DT-50"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.528>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.528> ;
        skos:definition  "portion de matériau, obtenue à partir de l'<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.236\">échantillon pour laboratoire&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.236)</span></a></span> au moyen d'une méthode appropriée de <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.402\">prétraitement des échantillons&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.402)</span></a></span>, et ayant la taille (volume/masse) nécessaire pour les essais ou l'analyse souhaités"@fr , "portion of material, resulting from the <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.236\">laboratory sample <span class=\"sts-tbx-entailedTerm-num\">(3.236)</span></a></span> by means of an appropriate method of <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.402\">sample pretreatment <span class=\"sts-tbx-entailedTerm-num\">(3.402)</span></a></span>, and having the size (volume/mass) necessary for the desired testing or analysis"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.528" ;
        skos:prefLabel   "test sample"@en , "échantillon pour essai"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.402>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.402> ;
        skos:definition  "procedures used for conditioning a soil <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">sample <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> to a defined state which allows subsequent examination or analysis or long-term storage"@en , "ensemble des modes opératoires utilisés pour le conditionnement d'un <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">échantillon&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> de sol afin de l'amener à un état défini permettant de le soumettre à un examen ou à une analyse, ou de le stocker pendant une longue durée"@fr ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.402" ;
        skos:note        "Note 1 à l’article: Le prétraitement d'un échantillon comprend, par exemple, le mélange (3.272), le fractionnement, le séchage (3.135), le-broyage (3.268), la stabilisation (3.492)."@fr , "Note 1 to entry: Sample pretreatment includes e.g. mixing (3.272), splitting, drying (3.135), crushing (3.268), stabilization (3.492)."@en ;
        skos:prefLabel   "sample pretreatment"@en , "prétraitement de l'échantillon"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.317>
        a                skos:Concept ;
        dct:source       "ISO 6107:2021, 3.391"@fr , "ISO 6107:2021, 3.391"@en ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.317> ;
        skos:definition  "isolated body of <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.191\">groundwater <span class=\"sts-tbx-entailedTerm-num\">(3.191)</span></a></span>, which is limited in lateral and vertical extent, located within the <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.560\">unsaturated zone <span class=\"sts-tbx-entailedTerm-num\">(3.560)</span></a></span> overlying a much more extensive groundwater body"@en , "masse isolée d'<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.191\">eau souterraine&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.191)</span></a></span> limitée latéralement et verticalement, localisée dans la <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.560\">zone non saturée&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.560)</span></a></span> recouvrant une masse d'eau souterraine beaucoup plus importante"@fr ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.317" ;
        skos:prefLabel   "nappe d'eau perchée"@fr , "perched water table"@en .

