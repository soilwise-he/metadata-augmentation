<https://data.geoscience.earth/ncl/ISO11074v2025/3.92>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.92> ;
        skos:definition  "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.443\">site <span class=\"sts-tbx-entailedTerm-num\">(3.443)</span></a></span> where <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.93\">contamination <span class=\"sts-tbx-entailedTerm-num\">(3.93)</span></a></span> is present"@en , "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.443\">site&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.443)</span></a></span> où existe une <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.93\">contamination&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.93)</span></a></span>"@fr ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.92" ;
        skos:note        "Note 1 à l’article: La présente définition ne présuppose pas l'existence d'un danger (3.198) dû à l’existence de la contamination."@fr , "Note 1 to entry: There is no assumption in this definition that harm (3.198) results from the presence of contamination."@en ;
        skos:prefLabel   "contaminated site"@en , "site contaminé"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.177>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.177> ;
        skos:definition  "système conçu pour contrôler le transfert et le rejet des gaz de <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.238\">décharge&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.238)</span></a></span> et autres gaz dans des <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.443\">sites&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.443)</span></a></span> donnés"@fr , "system designed to control the migration and release of <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.238\">landfill <span class=\"sts-tbx-entailedTerm-num\">(3.238)</span></a></span> and other gases from <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.443\">sites <span class=\"sts-tbx-entailedTerm-num\">(3.443)</span></a></span>"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.177" ;
        skos:prefLabel   "système de contrôle des gaz"@fr , "gas control system"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.569>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.569> ;
        skos:altLabel    "VOC"@en , "COV"@fr ;
        skos:definition  "composant organique qui est volatil dans des conditions environnementales/atmosphériques normales, bien qu'il puisse être présent dans la terre en phase solide, liquide et dissoute ainsi qu'en phase gazeuse"@fr , "organic compound that is volatile under normal environmental/atmospheric conditions, although it can be found in the ground in the solid, liquid and dissolved phase form as well as in gaseous phase"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.569" ;
        skos:note        "Note 1 to entry: Examples include single-ring aromatic hydrocarbons (3.31) and other low boiling halogenated hydrocarbons (3.210), which are used as solvents or fuels, and some degradation (3.116) products."@en , "Note 1 à l’article: Les hydrocarbures aromatiques (3.31) monocycliques et autres hydrocarbures (3.210) halogénés à bas point d'ébullition, utilisés comme solvants ou carburants, ainsi que certains produits de dégradation (3.116) en sont des exemples."@fr ;
        skos:prefLabel   "composé organique volatil"@fr , "volatile organic compound"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.443>
