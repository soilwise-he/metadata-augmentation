        skos:definition  "physical or reactive geochemical and biological processes, which can attenuate, concentrate, immobilise, liberate, degrade, or otherwise transform substances in soil"@en , "mécanisme ou réaction géochimique, physique et biologique pouvant atténuer, concentrer, immobiliser, libérer, dégrader ou, plus généralement, transformer les substances du sol"@fr ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.464" ;
        skos:prefLabel   "processus du sol"@fr , "soil processes"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.379>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.379> ;
        skos:definition  "étude permettant de recueillir toutes les données nécessaires à la conception et à la mise en œuvre d’un <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.383\">scénario de gestion&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.383)</span></a></span>"@fr , "investigation to collect all information necessary to design and execute a <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.383\">remediation strategy <span class=\"sts-tbx-entailedTerm-num\">(3.383)</span></a></span>"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.379" ;
        skos:prefLabel   "remedial investigation"@en , "étude de dépollution"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.253>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.253> ;
        skos:altLabel    "CMEO"@fr , "LOEC"@en ;
        skos:definition  "lowest <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.530\">test substance <span class=\"sts-tbx-entailedTerm-num\">(3.530)</span></a></span><span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.86\">concentration <span class=\"sts-tbx-entailedTerm-num\">(3.86)</span></a></span> that has a statistically significant effect (<i>p</i>&nbsp;&gt;&nbsp;0,05)"@en , "plus faible <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.86\">concentration&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.86)</span></a></span> de la <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.530\">substance d'essai&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.530)</span></a></span> qui exerce un effet statistiquement significatif (<i>p</i>&nbsp;&gt;&nbsp;0,05)"@fr ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.253" ;
        skos:note        "Note 1 to entry: All test concentrations above the LOEC should usually show an effect that is statistically different from the control."@en , "Note 1 à l’article: Il convient que toutes les concentrations d'essai supérieures à la CMEO aient généralement un effet statistiquement différent du témoin."@fr ;
        skos:prefLabel   "concentration minimale avec effet observé"@fr , "lowest observed effect concentration"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.83>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.83> ;
        skos:altLabel    "échantillon d'ensemble"@fr , "aggregated sample"@en , "average sample"@en , "échantillon moyen"@fr ;
        skos:definition  "two or more <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.218\">increments <span class=\"sts-tbx-entailedTerm-num\">(3.218)</span></a></span> or <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.503\">subsamples <span class=\"sts-tbx-entailedTerm-num\">(3.503)</span></a></span> mixed together in appropriate proportions, either discretely or continuously, from which the average result of a desired <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.70\">characteristic <span class=\"sts-tbx-entailedTerm-num\">(3.70)</span></a></span> can be obtained"@en , "échantillon obtenu en mélangeant de façon discrète ou continue au moins deux <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.218\">prélèvements élémentaires&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.218)</span></a></span> ou <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.503\">sous-échantillons&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.503)</span></a></span>, en proportions appropriées, et qui permet de déterminer le résultat moyen d'une <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.70\">caractéristique <span class=\"sts-tbx-entailedTerm-num\">(3.70)</span></a></span> recherchée"@fr ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.83" ;
        skos:prefLabel   "échantillon composite"@fr , "composite sample"@en ;
        <https://w3id.org/dpv#hasContext>
                "général"@fr , "general"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.168>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.168> ;
        skos:definition  "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">échantillon&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> prélevé sur le terrain et enrichi en composants recherchés ou connexes pour vérifier les pertes potentielles du composant à analyser lors du transport, du stockage et de la préparation, ainsi que l'efficacité de récupération des composants à analyser"@fr , "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">sample <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> collected in the field and spiked with compounds of interest or related compounds to check on the potential for loss of analyte on transportation, storage and preparation, and for recovery of analytes"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.168" ;
        skos:prefLabel   "field spike"@en , "échantillon de terrain dopé"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.434>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.434> ;
        skos:definition  "appearance of the seedling (i.e. visible seedling) above the surface of the cover material"@en , "apparition de la plantule (c’est-à-dire plantule visible) à la surface du matériau de couverture"@fr ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.434" ;
        skos:note        "Note 1 à l’article: Se réfère à l'apparition du coléoptyle ou du cotylédon au-dessus de la surface du sol."@fr , "Note 1 to entry: This refers to the appearance of the coleoptile or cotyledon above the soil."@en ;
        skos:prefLabel   "seedling emergence"@en , "émergence de la plantule"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.349>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.349> ;
        skos:definition  "étape du traitement des eaux usées consistant à éliminer des matières en suspension des eaux usées brutes ou prétraitées"@fr , "stage of treatment involving the removal of suspended solids from raw wastewater or after preliminary treatment"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.349" ;
        skos:note        "Note 1 à l’article: Ce traitement constitue habituellement la première phase d'une chaîne de traitement de l'eau contaminé."@fr , "Note 1 to entry: This treatment usually forms the first stage of a treatment train for contaminated water."@en ;
        skos:prefLabel   "traitement primaire"@fr , "primary treatment"@en ;
        <https://w3id.org/dpv#hasContext>
                "contaminated water"@en , "eau contaminée"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.223>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.223> ;
        skos:definition  "quantité de substances atteignant le corps par ingestion, par exemple à la suite de l'ingestion d'un aliment contaminé ou de l'ingestion directe de sol, notamment par les enfants"@fr , "quantity of substances reaching the body by ingestion, e.g. from contaminated food or direct soil ingestion, in particular by children"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.223" ;
        skos:note        "Note 2 to entry: Often expressed as rate, e.g. mg/kg body mass."@en , "Note 1 à l’article: Une cause de l’ingestion peut être la présence de mucus bronchial, résultant d’une exposition par inhalation (3.225)."@fr , "Note 2 à l’article: Souvent exprimée sous forme de taux, par exemple mg/kg de poids corporel."@fr , "Note 1 to entry: Ingestion can also be caused by bronchial mucus, as a result of an inhalation exposure (3.225)."@en ;
        skos:prefLabel   "ingestion exposure"@en , "exposition par ingestion"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.53>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.53> ;
        skos:altLabel    "lit de traitement"@fr , "treatment bed"@en ;
        skos:definition  "above-ground bed of soil designed to enhance <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.44\">biodegradation <span class=\"sts-tbx-entailedTerm-num\">(3.44)</span></a></span> processes, usually incorporating means of collecting leachate and often means of maintaining oxygen (in aerobic processes) and nutrient levels"@en , "sous-couche de terre dont le but est d'améliorer les processus de <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.44\">biodégradation <span class=\"sts-tbx-entailedTerm-num\">(3.44)</span></a></span>, renfermant en général un système permettant de recueillir les lixiviats et, souvent aussi, un système permettant de maintenir à un certain niveau la teneur en oxygène (pour les procédés aérobies) et en nutriments"@fr ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.53" ;
        skos:note        "Note 1 à l’article: Il peut également inclure un système destiné à capter les dégagements de substances volatiles ou à maintenir les conditions anaérobies (3.22)."@fr , "Note 1 to entry: It can also include means of capturing released volatiles or means of maintaining anaerobic (3.22) conditions."@en ;
        skos:prefLabel   "lit de traitement biologique"@fr , "biotreatment bed"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.138>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.138> ;
        skos:definition  "réutilisation des <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.391\">matériaux du sol&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.391)</span></a></span> à des fins de génie civil et de construction"@fr , "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.391\">reuse of soil material <span class=\"sts-tbx-entailedTerm-num\">(3.391)</span></a></span> for civil engineering and construction purposes"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.138" ;
        skos:note        "Note 1 à l’article: Le même mot peut également renvoyer au matériau accumulé pendant une opération de terrassement."@fr , "Note 1 to entry: The same word can also refer to the material accumulated during an operation of earthwork."@en ;
        skos:prefLabel   "earthwork"@en , "terrassement"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.404>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.404> ;
        skos:definition  "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">échantillon&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> dont les résultats d'analyse sont exprimés, pour l'évaluation, en masse par unité de masse"@fr , "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">sample <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> whose analytical results are expressed for evaluation on the basis of mass per mass"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.404" ;
        skos:prefLabel   "sample related to mass"@en , "échantillon rapporté à la masse"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.319>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.319> ;
        skos:definition  "élément ou composé présent sous forme de gaz à toutes les températures ambiantes susceptibles d'être rencontrées à la surface de la terre"@fr , "element or compound that is a gas at all ambient temperatures likely to be encountered on the surface of the earth"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.319" ;
        skos:prefLabel   "permanent gas"@en , "gaz permanent"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.380>
        a                skos:Concept ;
        <http://www.loc.gov/mads/rdf/v1#deprecatedLabel>
                "remédiation"@fr ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.380> ;
        skos:definition  "procédé de traitement d'un sol, d'une <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.191\">eau souterraine&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.191)</span></a></span> ou d'un <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.443\">site&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.443)</span></a></span> contaminé en vue d'éliminer ou de maîtriser les <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.393\">risques&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.393)</span></a></span> qu'ils font courir à la santé humaine ou à l'environnement"@fr , "process of dealing with contaminated soil, <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.191\">groundwater <span class=\"sts-tbx-entailedTerm-num\">(3.191)</span></a></span>, or <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.443\">site <span class=\"sts-tbx-entailedTerm-num\">(3.443)</span></a></span> to eliminate or control <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.393\">risks <span class=\"sts-tbx-entailedTerm-num\">(3.393)</span></a></span> to human health or the environment"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.380" ;
        skos:prefLabel   "remediation"@en , "dépollution"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.23>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.23> ;
        skos:definition  "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.46\">traitement biologique&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.46)</span></a></span> en l'absence d'oxygène gazeux ou soluble"@fr , "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.46\">biological treatment <span class=\"sts-tbx-entailedTerm-num\">(3.46)</span></a></span> in the absence of gaseous or soluble oxygen"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.23" ;
        skos:prefLabel   "traitement biologique anaérobie"@fr , "anaerobic biological treatment"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.295>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.295> ;
        skos:definition  "composé organique contenant de l'azote, du soufre et de l'oxygène"@fr , "organic compound that contains nitrogen, sulphur, and oxygen"@en ;
        skos:example     "Asphaltène."@fr , "Asphaltenes."@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.295" ;
        skos:note        "Note 1 à l’article: Les composés NSO sont présents dans la matière organique (3.301) et le pétrole brut. Les composés NSO peuvent être séparés du pétrole brut par des solvants polaires tels que le méthanol."@fr , "Note 1 to entry: NSO compounds occur in organic matter (3.301) and crude oil. NSO compounds can be separated from crude oil by polar solvents such as methanol."@en ;
        skos:prefLabel   "NSO compound"@en , "composé NSO"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.108>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.108> ;
        skos:definition  "nombre de cycles de <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.360\">qPCR&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.360)</span></a></span> requis pour que le signal fluorescent franchisse la valeur <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.534\">seuil&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.534)</span></a></span> (c'est-à-dire dépasse le bruit de fond)"@fr , "number of <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.360\">qPCR <span class=\"sts-tbx-entailedTerm-num\">(3.360)</span></a></span> cycles required for the fluorescent signal to cross the <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.534\">threshold <span class=\"sts-tbx-entailedTerm-num\">(3.534)</span></a></span> (i.e.&nbsp;to exceed background level)"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.108" ;
        skos:prefLabel   "cycle threshold"@en , "cycle seuil"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.561>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.561> ;
        skos:altLabel    "LSE"@fr , "UEL"@en ;
        skos:definition  "fraction volumique maximale d'un mélange de gaz inflammable et d'air qui va entraîner une explosion dans un espace confiné à une température de 25&nbsp;°C et à la pression atmosphérique"@fr , "uppermost volume fraction of a mixture of flammable gas with air which will propagate an explosion in a confined space at&nbsp;25&nbsp;°C and atmospheric pressure"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.561" ;
        skos:note        "Note 1 to entry: UEL can be expressed as a percentage or in mg/l or similar units."@en , "Note 2 à l’article: Pour la limite inférieure d’explosivité (LIE), voir 3.251."@fr , "Note 1 à l’article: La LSE peut être exprimée en pourcentage, en mg/l ou dans des unités similaires."@fr , "Note 2 to entry: For lower explosive limit (LEL), see 3.251."@en ;
        skos:prefLabel   "upper explosive limit"@en , "limite supérieure d'explosivité"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.476>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.476> ;
        skos:definition  "proportions relatives des différentes fractions granulométriques (par exemple, sable, limon, argile) d'un sol, répondant à un <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.73\">système de classification&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.73)</span></a></span> des sols"@fr , "relative proportions of the various particle size fractions (i.e. sand, silt, clay) in a soil, according to a soil <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.73\">classification system <span class=\"sts-tbx-entailedTerm-num\">(3.73)</span></a></span>"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.476" ;
        skos:prefLabel   "soil texture"@en , "texture du sol"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.350>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.350> ;
        skos:definition  "une des quatre situations d'échantillonnage, caractérisée par la combinaison suivante: si des informations sur la répartition spatiale ou les propriétés moyennes sont exigées et si le type d'échantillonnage exigé est un <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.224\">échantillonnage dans le sol&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.224)</span></a></span> ou <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.7\">un échantillonnage en surface&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.7)</span></a></span>"@fr , "one of four sampling situations characterised by a combination of whether information is required on spatial distribution or average properties, with whether <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.224\">in-ground sampling <span class=\"sts-tbx-entailedTerm-num\">(3.224)</span></a></span> or <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.7\">above‑ground sampling <span class=\"sts-tbx-entailedTerm-num\">(3.7)</span></a></span> is required"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.350" ;
        skos:note        "Note 1 à l’article: Le concept est illustré dans le Tableau 2 de l'ISO 18400-104:2018."@fr , "Note 1 to entry: The concept is illustrated in ISO 18400-104:2018, Table 2."@en ;
        skos:prefLabel   "situation d'échantillonnage principale"@fr , "principal sampling situation"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.265>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.265> ;
        skos:definition  "metabolic performance of <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.266\">microorganisms <span class=\"sts-tbx-entailedTerm-num\">(3.266)</span></a></span>"@en , "performance métabolique des <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.266\">micro-organismes&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.266)</span></a></span>"@fr ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.265" ;
        skos:note        "Note 1 to entry: It can be measured, for example, as O2 uptake or CO2 release."@en , "Note 1 à l’article: Elle peut être mesurée, par exemple, sous forme de consommation d'O2 ou de production de CO2."@fr ;
        skos:prefLabel   "activité microbienne"@fr , "microbial activity"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.95>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.95> ;
        skos:definition  "substrat non contaminé ou sol naturel utilisé comme témoin et comme <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.262\">milieu&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.262)</span></a></span> de préparation des gammes de dilutions avec les sols soumis à essai ou avec des substance chimiques, et qui permet la croissance de <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.194\">végétaux&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.194)</span></a></span> sains"@fr , "uncontaminated substrate or natural soil, used as a control and as <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.262\">medium <span class=\"sts-tbx-entailedTerm-num\">(3.262)</span></a></span> for preparing dilution series with test soils or chemicals, that allows the <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.194\">growth <span class=\"sts-tbx-entailedTerm-num\">(3.194)</span></a></span> of healthy plants"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.95" ;
        skos:note        "Note 1 à l’article: Il est possible d'utiliser des sols standards artificiels, naturels ou de référence (3.376), dans la mesure où aucun retard de croissance des végétaux d'essai dans ces sols n'est à attendre. Dans tous les cas, des différences de teneur en nutriments entre un sol soumis à essai et un sol témoin peuvent affecter la relation dose (3.131)-réponse. Par exemple, un sol témoin beaucoup plus riche en éléments nutritifs que le sol soumis à essai peut donner lieu à un résultat «faux positif» (c'est-à-dire que le sol soumis à essai semble avoir un effet «toxique» sur la croissance des végétaux d'essai). Si un sol témoin est moins riche en éléments nutritifs que le sol soumis à essai, un phénomène d'hormèse (3.206) pour les rapports de mélange de sols faibles n'est pas à exclure, voire une relation dose-réponse (3.132) inverse si l'apport d'éléments nutritifs devient l'effet principal."@fr , "Note 1 to entry: Either artificial or natural standard or reference soils (3.376) can be used, if unhindered growth of the test plants in these soils can be expected. In any case, differences in nutrient levels between a test soil and a control soil can affect the dose (3.131) (response pattern). For example, a control soil much richer in nutrients than a test soil can result in a false-positive result (i.e. the test soil appears to have a “toxic” effect on the growth of the test plants). If a control soil is poorer in nutrients than a test soil, hormesis (3.206) can be expected at low soil-mixture ratios, or even an inverse dose-response relationship (3.132), if nutrient supply becomes the main effect."@en ;
        skos:prefLabel   "control soil"@en , "sol témoin"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.531>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.531> ;
        skos:definition  "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.256\">sol artificiel&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.256)</span></a></span> ou <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.448\">sol&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.448)</span></a></span> naturel utilisé comme substrat témoin et de dilution, ou auquel une <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.530\">substance d'essai&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.530)</span></a></span> peut être ajoutée"@fr , "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.256\">manufactured soil <span class=\"sts-tbx-entailedTerm-num\">(3.256)</span></a></span> or natural <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.448\">soil <span class=\"sts-tbx-entailedTerm-num\">(3.448)</span></a></span> used as control and dilution substrate or to be spiked with a <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.530\">test substance <span class=\"sts-tbx-entailedTerm-num\">(3.530)</span></a></span>"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.531" ;
        skos:prefLabel   "test substrate"@en , "substrat d'essai"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.446>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.446> ;
        skos:definition  "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">échantillon&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> prélevé sous forme de coupe verticale dans une strate ou autre sous-partie supposée <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.204\">homogène&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.204)</span></a></span>"@fr , "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">sample <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> taken as a vertical slot from within a stratum or other subpart which is putatively <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.204\">homogeneous <span class=\"sts-tbx-entailedTerm-num\">(3.204)</span></a></span>"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.446" ;
        skos:prefLabel   "échantillon transversal"@fr , "slot sample"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.320>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.320> ;
        skos:definition  "zone représentative choisie selon des critères spécifiques, dans laquelle un ou plusieurs <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.147\">milieux environnementaux&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.147)</span></a></span> sont étudiés sur de longues périodes afin d'obtenir des informations fiables sur les effets des influences de l'environnement"@fr , "representative area chosen according to specific criteria where one or more <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.147\">environmental mediums <span class=\"sts-tbx-entailedTerm-num\">(3.147)</span></a></span> are investigated over long periods to obtain reliable information on the effects of environmental influences"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.320" ;
        skos:note        "Note 1 to entry: One or more permanent monitoring areas can be part of a monitoring site (3.278)."@en , "Note 2 to entry: In the context of managing contaminated land, the monitoring (3.276) carried out in an area can focus on one or more environmental media (e.g. soil, water, soil gas (3.454))."@en , "Note 1 à l’article: Un site de surveillance (3.278) peut comprendre un ou plusieurs observatoires permanents."@fr , "Note 2 à l’article: S'agissant de la gestion d'un terrain contaminé, la surveillance (3.276) effectuée sur le site peut porter principalement sur un ou plusieurs milieux environnementaux (par exemple, sol, eau, gaz du sol (3.454))."@fr ;
        skos:prefLabel   "permanent monitoring area"@en , "observatoire permanent"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.235>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.235> ;
        skos:definition  "boîte métallique à couvercle et fond amovibles, pouvant être introduite en force dans la surface de terre pour obtenir un <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.557\">échantillon non remanié&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.557)</span></a></span>"@fr , "metal box with removable top and base which can be forced into the surface of the ground to obtain an <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.557\">undisturbed sample <span class=\"sts-tbx-entailedTerm-num\">(3.557)</span></a></span>"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.235" ;
        skos:note        "Note 1 à l’article: Habituellement fabriquée aux dimensions souhaitées à partir de tôle d'aluminium, d'acier galvanisé ou d'acier inoxydable. Les dimensions sont variables, mais un exemple type peut présenter une surface d'environ 55 mm × 75 mm avec une profondeur de 40 mm. Une fois obtenu, l'échantillon (3.398) peut être utilisé pour déterminer la masse volumique apparente (3.62) ou il peut être imprégné de résine avant la production de lames minces pour examen microscopique."@fr , "Note 1 to entry: Usually made to desired size from aluminium, galvanized steel, or stainless-steel sheet. Size varies, but a typical example can have an area of about 55 mm × 75 mm with a depth of 40 mm. The sample (3.398), once obtained, can be used to determine bulk density (3.62) or can be impregnated with resin prior to the production of thin sections for microscopic examination."@en ;
        skos:prefLabel   "boîte de Kubiëna"@fr , "kubiëna tin"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.65>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.65> ;
        skos:definition  "eau retenue dans les particules du sol par une attraction intermoléculaire non équilibrée à la limite liquide"@fr , "water held on soil particles due to unbalanced inter-molecular attraction at the liquid boundary"@en ;
        skos:example     "La montée ou la baisse des liquides dans des tubes étroits, la formation de pellicules, de gouttes, de bulles, etc."@fr , "The rise or depression of liquids in narrow tubes, the formation of films, drops, bubbles, etc."@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.65" ;
        skos:prefLabel   "eau capillaire"@fr , "capillary water"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.501>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.501> ;
        skos:definition  "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.448\">sol&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.448)</span></a></span> formé sous l'eau ou qui s’est formé sur la <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.306\">roche mère&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.306)</span></a></span> ensuite déposée dans l'eau, ou par le biais de processus alluviaux"@fr , "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.448\">soil <span class=\"sts-tbx-entailedTerm-num\">(3.448)</span></a></span> formed below water, or which is formed on <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.306\">parent material <span class=\"sts-tbx-entailedTerm-num\">(3.306)</span></a></span> that was deposited in water or through alluvial processes"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.501" ;
        skos:prefLabel   "subhydric soil"@en , "sol aquatique, sol subhydrique"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.416>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.416> ;
        skos:definition  "ensemble de <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.418\">points d'échantillonnage&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.418)</span></a></span> prédéterminés"@fr , "set of predetermined <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.418\">sampling points <span class=\"sts-tbx-entailedTerm-num\">(3.418)</span></a></span>"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.416" ;
        skos:prefLabel   "sampling pattern"@en , "grille d'échantillonnage"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.392>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.392> ;
        skos:definition  "séparation d'un <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">échantillon&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> à écoulement libre, en parties (généralement) égales, à l'aide d'un dispositif mécanique composé de répartiteurs"@fr , "separation of a free-flowing <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">sample <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> into (usually) equal parts by means of a mechanical device composed of diverter chutes"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.392" ;
        skos:prefLabel   "riffling"@en , "division d'un échantillon par répartiteur"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.205>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.205> ;
        skos:definition  "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">échantillon&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> prélevé dans un horizon défini du sol et le représentant"@fr , "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">sample <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> collected from and representing a defined soil horizon"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.205" ;
        skos:note        "Note 1 à l’article: L'échantillon peut être ponctuel ou non."@fr , "Note 1 to entry: The sample can be one-off or not."@en ;
        skos:prefLabel   "horizon related sample"@en , "échantillon lié à l'horizon"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.35>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.35> ;
        skos:definition  "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.86\">concentration&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.86)</span></a></span> d'un élément ou d'une substance <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.70\">caractéristique&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.70)</span></a></span> d'un type de sol dans une zone ou région donnée, due à la fois aux sources naturelles et aux sources diffuses anthropiques telles que les dépôts atmosphériques"@fr , "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.86\">concentration <span class=\"sts-tbx-entailedTerm-num\">(3.86)</span></a></span> of an element or a substance <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.70\">characteristic <span class=\"sts-tbx-entailedTerm-num\">(3.70)</span></a></span> of a soil type in an area or region arising from both natural sources and anthropogenic diffuse sources such as atmospheric deposition"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.35" ;
        skos:prefLabel   "concentration de fond"@fr , "background concentration"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.181>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.181> ;
        skos:definition  "prélèvement d'un volume de <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.454\">gaz du sol&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.454)</span></a></span> contenu dans <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.332\">l'espace poral&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.332)</span></a></span> du sol"@fr , "collection of a volume of <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.454\">soil gas <span class=\"sts-tbx-entailedTerm-num\">(3.454)</span></a></span> contained in the <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.332\">pore space <span class=\"sts-tbx-entailedTerm-num\">(3.332)</span></a></span> of the soil"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.181" ;
        skos:prefLabel   "échantillonnage des gaz"@fr , "gas sampling"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.488>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.488> ;
        skos:definition  "unité/portion de matériau spécialement sélectionnée, prélevée dans un système dynamique et supposée représentative du matériau initial&nbsp;au moment du prélèvement"@fr , "specifically selected unit/portion of a material taken from a dynamic system and assumed to be representative of the initial material at the time it is taken"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.488" ;
        skos:note        "Note 1 à l’article: Une éprouvette peut être considérée comme un type particulier d'échantillon (3.398), prélevé par unité de temps plutôt que par unité de surface."@fr , "Note 2 à l’article: Le terme «éprouvette» a été utilisé pour désigner aussi bien une unité représentative qu'une unité non représentative d'une population, généralement dans les prélèvements cliniques, biologiques et minéralogiques."@fr , "Note 1 to entry: A specimen can be considered as a special type of sample (3.398), taken primarily in time rather than in space."@en , "Note 2 to entry: The term “specimen” has been used both as a representative unit and as a non-representative unit of a population, usually in clinical, biological, and mineralogical collections."@en ;
        skos:prefLabel   "specimen"@en , "éprouvette"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.362>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.362> ;
        skos:definition  "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">échantillon&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> lié habituellement à la mise en assurance qualité de l'échantillonnage sur le terrain"@fr , "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">sample <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> usually relating to the quality assurance of field sampling"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.362" ;
        skos:note        "Note 1 to entry: Three types can be distinguished: field blanks (3.165), split samples (3.489), and field spikes (3.168)."@en , "Note 1 à l’article: Il est possible d'en distinguer trois types: les blancs de terrain (3.165), les échantillons fractionnés (3.489) et les échantillons de terrain dopés (3.168)."@fr ;
        skos:prefLabel   "quality control sample"@en , "échantillon de contrôle qualité"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.277>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.277> ;
        skos:definition  "dispositif permanent ou temporaire utilisé pour la mesure des paramètres du sol"@fr , "permanent or temporary device used for measuring parameters in the soil"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.277" ;
        skos:prefLabel   "dispositif de surveillance"@fr , "monitoring installation"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.151>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.151> ;
        skos:definition  "element essential in low <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.86\">concentrations <span class=\"sts-tbx-entailedTerm-num\">(3.86)</span></a></span> for plant or animal (including human) metabolism"@en , "élément essentiel en faibles <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.86\">concentrations&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.86)</span></a></span> pour le métabolisme des végétaux ou des animaux (y compris les êtres humains)"@fr ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.151" ;
        skos:note        "Note 1 to entry: An element can be essential at low concentrations but become harmful at higher concentrations."@en , "Note 1 à l’article: Un élément peut être essentiel à des concentrations faibles mais devenir dangereux à des concentrations plus élevées."@fr ;
        skos:prefLabel   "essential trace element"@en , "oligo-élément essentiel"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.543>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.543> ;
        skos:definition  "zone d'<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.410\">échantillonnage&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.410)</span></a></span>, généralement de forme allongée ou linéaire, choisie comme base pour étudier une <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.70\">caractéristique&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.70)</span></a></span> particulière du <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.448\">sol&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.448)</span></a></span>"@fr , "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.410\">sampling <span class=\"sts-tbx-entailedTerm-num\">(3.410)</span></a></span> area, usually elongated or linear, chosen as the basis for studying a particular <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.70\">characteristic <span class=\"sts-tbx-entailedTerm-num\">(3.70)</span></a></span> of the <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.448\">soil <span class=\"sts-tbx-entailedTerm-num\">(3.448)</span></a></span>"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.543" ;
        skos:prefLabel   "transect"@en , "transect"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.458>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.458> ;
        skos:definition  "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.410\">échantillonnage&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.410)</span></a></span> continu des <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.454\">gaz du sol&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.454)</span></a></span> à partir d'un <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.56\">sondage&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.56)</span></a></span> pendant une période contrôlée (souvent de plusieurs heures à plusieurs jours) en vue d'observer les variations temporelles de la <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.86\">concentration&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.86)</span></a></span> des gaz et celles de la distribution de pression dans le sol"@fr , "continuous <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.454\">soil gas <span class=\"sts-tbx-entailedTerm-num\">(3.454)</span></a></span><span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.410\">sampling <span class=\"sts-tbx-entailedTerm-num\">(3.410)</span></a></span> from a <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.56\">borehole <span class=\"sts-tbx-entailedTerm-num\">(3.56)</span></a></span> well over a controlled period of time (mostly several hours up to days) to observe the variations over time of the gas <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.86\">concentrations <span class=\"sts-tbx-entailedTerm-num\">(3.86)</span></a></span> and of the pressure distribution in the soil"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.458" ;
        skos:prefLabel   "soil gas suction test"@en , "essai d'aspiration des gaz du sol"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.1>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.1> ;
        skos:definition  "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.201\">site dangereux&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.201)</span></a></span> laissé par son propriétaire ou un autre responsable dans un état non entretenu"@fr , "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.201\">hazardous site <span class=\"sts-tbx-entailedTerm-num\">(3.201)</span></a></span> left by the owner or other responsible party in unmanaged condition"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.1" ;
        skos:prefLabel   "site dangereux abandonné"@fr , "abandoned hazardous site"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.332>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.332> ;
        skos:definition  "ensemble des volumes d'un <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">échantillon&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> ou d'un horizon de sol qui ne sont pas occupés par la phase solide et peuvent, par conséquent, être remplis d'air ou permettre le stockage ou la circulation de fluides"@fr , "all volumes of a soil <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">sample <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> or horizon not occupied by the solid phase and therefore available either for air or for the storage or circulation of fluids"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.332" ;
        skos:prefLabel   "pore space"@en , "espace poral"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.247>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.247> ;
        skos:definition  "toute condition qui limite les <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.453\">fonctions d'un sol&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.453)</span></a></span> et/ou son utilisation"@fr , "condition that limits <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.453\">soil functions <span class=\"sts-tbx-entailedTerm-num\">(3.453)</span></a></span> and/or the utilization of a soil"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.247" ;
        skos:prefLabel   "facteur limitant"@fr , "limiting factor"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.77>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.77> ;
        skos:definition  "ensemble des processus d'information et de consultation des populations locales affectées par un <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.201\">site dangereux&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.201)</span></a></span> et des opérations d'investigation ou de dépollution le concernant"@fr , "processes involved in informing and consulting the local community affected by a <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.201\">hazardous site <span class=\"sts-tbx-entailedTerm-num\">(3.201)</span></a></span> and activities to investigate or remediate it"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.77" ;
        skos:prefLabel   "concertation publique"@fr , "community relations"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.121>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.121> ;
        skos:definition  "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.443\">site&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.443)</span></a></span> tellement endommagé par l'activité humaine qu'il n'est plus utilement exploitable sans traitement"@fr , "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.443\">site <span class=\"sts-tbx-entailedTerm-num\">(3.443)</span></a></span> so damaged by human activity as to be incapable of beneficial use without treatment"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.121" ;
        skos:note        "Note 1 to entry: Damage can be to the aesthetic, physical, engineering, environmental, or contamination (3.93) aspects of the site."@en , "Note 1 à l’article: Le dommage peut toucher à des aspects esthétiques, physiques, mécaniques, environnementaux, ou être en lien avec la contamination (3.93) du site."@fr ;
        skos:prefLabel   "derelict site"@en , "site dégradé"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.513>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.513> ;
        skos:definition  "composé représentatif dont les propriétés toxicologiques et/ou physiques sont comparables à celles d’une <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.172\">fraction&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.172)</span></a></span> d'<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.210\">hydrocarbure&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.210)</span></a></span>, qui peut donc être utilisé pour représenter la fraction dans une <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.161\">évaluation de l'exposition&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.161)</span></a></span>"@fr , "representative compound with toxicological and/or physical properties indicative of a <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.210\">hydrocarbon <span class=\"sts-tbx-entailedTerm-num\">(3.210)</span></a></span><span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.172\">fraction <span class=\"sts-tbx-entailedTerm-num\">(3.172)</span></a></span>, which can therefore be used to represent the fraction in an <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.161\">exposure assessment <span class=\"sts-tbx-entailedTerm-num\">(3.161)</span></a></span>"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.513" ;
        skos:prefLabel   "surrogate compound"@en , "composé de substitution"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.428>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.428> ;
        skos:definition  "zone du sol dans laquelle l'<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.332\">espace poral&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.332)</span></a></span> est entièrement rempli de liquide au moment considéré"@fr , "zone of the ground in which the <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.332\">pore space <span class=\"sts-tbx-entailedTerm-num\">(3.332)</span></a></span> is filled completely with liquid at the time of consideration"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.428" ;
        skos:prefLabel   "saturated zone"@en , "zone saturée"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.302>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.302> ;
        skos:definition  "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">sample <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> obtained by methods of lower cost and leading to results of lower reliability"@en , "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">échantillon&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> obtenu par des méthodes moins coûteuses et donnant des résultats moins fiables"@fr ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.302" ;
        skos:note        "Note 1 to entry: Taking orientation samples is a common screening practice in the exploratory stage of extending soil sampling programmes (3.420)."@en , "Note 1 à l’article: Le prélèvement d'échantillons d'orientation est une pratique de sélection courante dans la phase exploratoire de programmes d'échantillonnage (3.420) du sol extensifs."@fr ;
        skos:prefLabel   "orientation sample"@en , "échantillon d'orientation"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.217>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.217> ;
        skos:definition  "treatment in the presence of oxygen, in which contaminated <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.262\">medium <span class=\"sts-tbx-entailedTerm-num\">(3.262)</span></a></span> (e.g. soil) is raised to a temperature at which thermal destruction of <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.91\">contaminants <span class=\"sts-tbx-entailedTerm-num\">(3.91)</span></a></span> occurs"@en , "traitement en présence d’oxygène, au cours duquel le <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.262\">milieu&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.262)</span></a></span> contaminé (par exemple le sol) est porté à une température engendrant la destruction thermique des <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.91\">contaminants&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.91)</span></a></span>"@fr ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.217" ;
        skos:note        "Note 1 to entry: Organic contaminants can burn in the treatment bed (3.53) or be vaporized. They can then burn above the bed or in an after-burner. Some inorganic contaminants, such as cyanides, can also be destroyed. Volatile inorganics (e.g. mercury) can be partly or totally vaporized and should be collected in an off-gas treatment system (3.548). Non‑volatilized contaminants are retained in the residual mineral matter which typically sinters."@en , "Note 1 à l’article: Les contaminants organiques peuvent brûler dans le lit de traitement (3.53) ou se vaporiser. Ils peuvent alors brûler au-dessus du lit ou dans un brûleur. Certains contaminants inorganiques, tels que les cyanures, peuvent également être détruits. Les contaminants inorganiques volatils (par exemple le mercure) peuvent se vaporiser totalement ou partiellement; il convient de les recueillir dans un système de traitement (3.548) des effluents gazeux. Les contaminants non volatilisés sont retenus dans la matière minérale résiduelle qui subit généralement un frittage."@fr ;
        skos:prefLabel   "incinération"@fr , "incineration"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.47>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.47> ;
        skos:definition  "total mass of living organisms or parts of them"@en , "masse totale des organismes vivants ou de parties de ces organismes"@fr ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.47" ;
        skos:note        "Note 1 to entry: Biomass is expressed as fresh or dry mass of test organism or fresh or dry mass per test unit."@en , "Note 1 à l’article: La biomasse est exprimée en masse fraîche ou en masse sèche d'organismes d'essai ou en masse fraîche ou sèche par unité pour essai"@fr ;
        skos:prefLabel   "biomass"@en , "biomasse"@fr ;
        <https://w3id.org/dpv#hasContext>
                "général"@fr , "general"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.193>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.193> ;
        skos:altLabel    "nappe d'eau"@fr , "water table"@en ;
        skos:definition  "upper boundary surface of the <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.191\">groundwater <span class=\"sts-tbx-entailedTerm-num\">(3.191)</span></a></span>"@en , "limite supérieure de l’<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.191\">eau souterraine&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.191)</span></a></span>"@fr ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.193" ;
        skos:prefLabel   "groundwater surface"@en , "surface de l’eau souterraine"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.374>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.374> ;
        skos:altLabel    "RM"@en , "MR"@fr ;
        skos:definition  "material or substance, one or more of whose property values are sufficiently <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.204\">homogeneous <span class=\"sts-tbx-entailedTerm-num\">(3.204)</span></a></span> and well established to be used for the calibration of an apparatus, the assessment of a measurement method, or for assigning values to materials"@en , "matériau ou substance dont au moins une valeur de la propriété est suffisamment <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.204\">homogène&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.204)</span></a></span> et bien définie pour permettre son utilisation en vue de l'étalonnage d'un appareil, de l'évaluation d'une méthode de mesure ou de l'attribution de valeurs aux matériaux"@fr ;
        skos:example     "L'eau pour l'étalonnage des viscosimètres, le saphir qui permet d'étalonner la capacité thermique en calorimétrie et les solutions utilisées pour l'étalonnage dans l'analyse chimique."@fr , "Water for the calibration of viscometers, sapphire as a heat-capacity calibrant in calorimetry, and solutions used for calibration in chemical analysis."@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.374" ;
        skos:note        "Note 1 to entry: A reference material can be in the form of a pure or mixed gas, liquid, or solid."@en , "Note 1 à l’article: Un matériau de référence peut se présenter sous la forme d'un gaz, d'un liquide ou d'un solide, pur ou composé."@fr ;
        skos:prefLabel   "matériau de référence"@fr , "reference material"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.17>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.17> ;
        skos:definition  "introduction d'air sous pression dans les <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.191\">eaux souterraines&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.191)</span></a></span>"@fr , "introduction of air under pressure into the <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.191\">groundwater <span class=\"sts-tbx-entailedTerm-num\">(3.191)</span></a></span>"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.17" ;
        skos:prefLabel   "purge à l'air"@fr , "air-sparging"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.289>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.289> ;
        skos:altLabel    "N-mineralization"@en ;
        skos:definition  "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.116\">dégradation&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.116)</span></a></span> microbienne d'une substance organique azotée, par les processus d'<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.20\">ammonification&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.20)</span></a></span> et de <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.288\">nitrification&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.288)</span></a></span>, donnant des produits inorganiques, plus particulièrement de l'ammonium et des nitrates"@fr , "microbial <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.116\">degradation <span class=\"sts-tbx-entailedTerm-num\">(3.116)</span></a></span> of an organic substance containing nitrogen, through the processes of <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.20\">ammonification <span class=\"sts-tbx-entailedTerm-num\">(3.20)</span></a></span> and <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.288\">nitrification <span class=\"sts-tbx-entailedTerm-num\">(3.288)</span></a></span>, to the respective inorganic end-products, specifically ammonium and nitrate"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.289" ;
        skos:prefLabel   "nitrogen mineralization"@en , "minéralisation de l'azote"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.163>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.163> ;
        skos:definition  "determination of the relevant <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.162\">exposure pathways <span class=\"sts-tbx-entailedTerm-num\">(3.162)</span></a></span> for the <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.395\">risk assessment <span class=\"sts-tbx-entailedTerm-num\">(3.395)</span></a></span> for a specific <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.484\">source <span class=\"sts-tbx-entailedTerm-num\">(3.484)</span></a></span>"@en , "détermination des <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.162\">voies d'exposition&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.162)</span></a></span> pertinentes pour l'<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.395\">appréciation du risque&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.395)</span></a></span> concernant une <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.484\">source&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.484)</span></a></span> particulière"@fr ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.163" ;
        skos:note        "Note 1 to entry: In the specific context of risk assessment, ISO 21365 provides a full definition on what is expected for exposure pathway identification."@en , "Note 1 à l’article: Dans le contexte spécifique de l'appréciation du risque, l'ISO 21365 donne une définition complète de ce que suppose l'identification des voies d'exposition."@fr ;
        skos:prefLabel   "exposure pathway identification"@en , "identification des voies d'exposition"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.555>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.555> ;
        skos:definition  "manque de connaissance concernant certains facteurs"@fr , "lack of knowledge about certain factors"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.555" ;
        skos:prefLabel   "uncertainty"@en , "incertitude"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.344>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.344> ;
        skos:definition  "mesure visant à éviter un <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.200\">danger&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.200)</span></a></span>"@fr , "measure to avoid <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.200\">hazard <span class=\"sts-tbx-entailedTerm-num\">(3.200)</span></a></span>"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.344" ;
        skos:prefLabel   "mesure préventive"@fr , "preventive measure"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.259>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.259> ;
        skos:altLabel    "D95"@en , "D95"@fr ;
        skos:definition  "fraction granulométrique telle que les particules d'une taille supérieure représentent 5&nbsp;% de la masse du matériau"@fr , "particle size such that 5&nbsp;% of the mass of the material corresponds to particles having larger size"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.259" ;
        skos:prefLabel   "granulométrie maximale"@fr , "maximum particle size"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.89>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.89> ;
        skos:definition  "applications pour lesquelles les <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.459\">matériaux du sol&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.459)</span></a></span> n'ont pas obligatoirement d'usage directement productif, bien qu'ils puissent servir de support à d'autres couches ayant un usage productif"@fr , "applications where <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.459\">soil materials <span class=\"sts-tbx-entailedTerm-num\">(3.459)</span></a></span> are not required to have a direct productive use although they can support other layers intended to have a productive use"@en ;
        skos:example     "Earthworks (3.138) (e.g. embankments), landscape engineering, road construction, construction of waste disposal sites (3.443), and back filling of excavated sites or mines."@en , "Terrassements (3.138) (par exemple digues), travaux paysagers, construction de routes, construction de sites (3.443) de décharge et remblais de sites excavés ou de mines."@fr ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.89" ;
        skos:prefLabel   "construction works"@en , "chantiers"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.133>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.133> ;
        skos:definition  "solid material excavated or otherwise removed from waters, e.g. during maintenance, construction, reconstruction and harbour or channel extension operation"@en , "matériau solide extrait des eaux par excavation ou autre technique d'élimination, par exemple au cours de travaux de maintenance, de construction, de reconstruction et d'extension d'un port ou d'un canal"@fr ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.133" ;
        skos:note        "Note 1 to entry: Dredged material may consist of sediments (3.433) and soil taken from below the water surface."@en , "Note 1 à l’article: Le matériau de dragage peut être constitué de sédiments (3.433) et de sols prélevés au-dessous de la surface des eaux."@fr ;
        skos:prefLabel   "dredged material"@en , "matériau de dragage"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.525>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.525> ;
        skos:definition  "mélange de <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.448\">sol&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.448)</span></a></span> contaminé ou de <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.530\">substance d'essai&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.530)</span></a></span> (par exemple, substance chimique, <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.52\">biosolide&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.52)</span></a></span>, déchets) et de sol témoin"@fr , "mixture of contaminated <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.448\">soil <span class=\"sts-tbx-entailedTerm-num\">(3.448)</span></a></span> or the <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.530\">test substance <span class=\"sts-tbx-entailedTerm-num\">(3.530)</span></a></span> (e.g. chemical, <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.52\">biosolid <span class=\"sts-tbx-entailedTerm-num\">(3.52)</span></a></span>, waste) with <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.95\">control soil <span class=\"sts-tbx-entailedTerm-num\">(3.95)</span></a></span>"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.525" ;
        skos:prefLabel   "test mixture"@en , "mélange d'essai"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.314>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.314> ;
        skos:definition  "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.410\">échantillonnage&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.410)</span></a></span> basé sur l'adsorption des gaz de la terre sur un adsorbant placé dans la terre, sans utiliser de dépression artificielle"@fr , "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.410\">sampling <span class=\"sts-tbx-entailedTerm-num\">(3.410)</span></a></span> based on the adsorption of gases of the ground on an adsorbent placed in the ground, without using artificially reduced pressure"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.314" ;
        skos:prefLabel   "échantillonnage passif des gaz du sol"@fr , "passive soil gas sampling"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.59>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.59> ;
        skos:definition  "strate constituée d'un matériau grossier très perméable à l'intérieur d'une <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.102\">couverture&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.102)</span></a></span>"@fr , "stratum of high permeability granular material within a <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.102\">cover system <span class=\"sts-tbx-entailedTerm-num\">(3.102)</span></a></span>"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.59" ;
        skos:note        "Note 1 à l’article: Son but est d'arrêter la remontée des contaminants (3.91) solubles par capillarité."@fr , "Note 1 to entry: Its purpose is to stop upward capillary movement of soluble contaminants (3.91)."@en ;
        skos:prefLabel   "break layer"@en , "couche de rupture"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.229>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.229> ;
        skos:definition  "réduction de la <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.86\">concentration&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.86)</span></a></span> en <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.91\">contaminants&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.91)</span></a></span> dans le sol, les <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.191\">eaux souterraines&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.191)</span></a></span> ou d'autres milieux, causée par des processus biologiques naturels en l'absence de toute intervention humaine"@fr , "reduction in <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.91\">contaminant <span class=\"sts-tbx-entailedTerm-num\">(3.91)</span></a></span><span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.86\">concentrations <span class=\"sts-tbx-entailedTerm-num\">(3.86)</span></a></span> in soil, <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.191\">groundwater <span class=\"sts-tbx-entailedTerm-num\">(3.191)</span></a></span> or other media, caused by natural biological processes, in the absence of human intervention"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.229" ;
        skos:note        "Note 1 à l’article: Voir également atténuation naturelle (3.283)."@fr , "Note 1 to entry: See also natural attenuation (3.283)."@en ;
        skos:prefLabel   "biodégradation intrinsèque"@fr , "intrinsic bioremediation"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.290>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.290> ;
        skos:altLabel    "NOEC"@en , "CSEO"@fr ;
        skos:definition  "highest <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.530\">test substance <span class=\"sts-tbx-entailedTerm-num\">(3.530)</span></a></span><span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.86\">concentration <span class=\"sts-tbx-entailedTerm-num\">(3.86)</span></a></span> immediately below the <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.253\">lowest observed effect concentration (LOEC) <span class=\"sts-tbx-entailedTerm-num\">(3.253)</span></a></span> at which no statistically significant effect is observed"@en , "plus haute <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.86\">concentration&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.86)</span></a></span> de la <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.530\">substance d'essai&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.530)</span></a></span> immédiatement inférieure à la <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.253\">concentration minimale avec effet observé&nbsp;(CMEO)&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.253)</span></a></span>, à laquelle aucun effet statistiquement significatif n'est observé"@fr ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.290" ;
        skos:note        "Note 1 à l’article: La CSEO n'a pas d'effet statistiquement significatif (p < 0,05) par rapport au témoin."@fr , "Note 1 to entry: NOEC has no statistically significant effect (p < 0,05) when compared with the control."@en ;
        skos:prefLabel   "no observed effect concentration"@en , "concentration sans effet observé"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.103>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.103> ;
        skos:definition  "estimation quantitative d'une <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.86\">concentration&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.86)</span></a></span> d'un ou de plusieurs <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.328\">polluants&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.328)</span></a></span>, en deçà de laquelle il n'y a pas, dans l'état actuel des connaissances, production d'effets néfastes significatifs sur les éléments sensibles spécifiques de l'environnement (du sol)"@fr , "quantitative estimate of a <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.86\">concentration <span class=\"sts-tbx-entailedTerm-num\">(3.86)</span></a></span> of one or more <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.328\">pollutants <span class=\"sts-tbx-entailedTerm-num\">(3.328)</span></a></span> below which significant harmful effects on specified sensitive elements of the (soil) environment do not occur, according to existing knowledge"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.103" ;
        skos:prefLabel   "concentration critique"@fr , "critical concentration"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.471>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.471> ;
        skos:definition  "actions entreprises pour restaurer les <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.453\">fonctions du sol&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.453)</span></a></span> en vue de ses usages prévus, ou pour protéger l'homme et l'environnement de certains dangers"@fr , "actions to restore <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.453\">soil functions <span class=\"sts-tbx-entailedTerm-num\">(3.453)</span></a></span> for intended uses or to protect man and the environment from dangers"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.471" ;
        skos:prefLabel   "soil restoration"@en , "restauration du sol"@fr .
