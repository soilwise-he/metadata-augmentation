        skos:prefLabel   "biodégradation"@fr , "biodegradation"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.129>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.129> ;
        skos:definition  "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">échantillon&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> de terre prélevé sans préservation de la <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.475\">structure du sol&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.475)</span></a></span>"@fr , "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">sample <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> obtained from the ground without preservation of the <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.475\">soil structure <span class=\"sts-tbx-entailedTerm-num\">(3.475)</span></a></span>"@en ;
        skos:example     "Sample obtained by using an auger."@en , "Échantillon prélevé à l'aide d'une tarière."@fr ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.129" ;
        skos:prefLabel   "échantillon remanié"@fr , "disturbed sample"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.190>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.190> ;
        skos:altLabel    "Ww"@en , "Ww"@fr ;
        skos:definition  "masse d'eau qui s'évapore du <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.448\">sol&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.448)</span></a></span> lorsque celui-ci est séché jusqu'à masse constante à une température de 105&nbsp;°C"@fr , "mass of water evaporating from the <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.448\">soil <span class=\"sts-tbx-entailedTerm-num\">(3.448)</span></a></span> when dried to a constant mass at&nbsp;105&nbsp;°C"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.190" ;
        skos:note        "Note 1 à l’article: Elle est exprimée comme la masse de l'eau divisée par la masse initiale de l'échantillon (3.398) de sol sec."@fr , "Note 1 to entry: It is expressed as the mass of water divided by the original dry mass of the soil sample (3.398)."@en ;
        skos:prefLabel   "gravimetric water content"@en , "teneur en eau gravimétrique"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.497>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.497> ;
        skos:definition  "processus au cours duquel la zone à échantillonner est divisée en plusieurs cellules identiques d'une grille (strates) et les <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">échantillons&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> sont prélevés de manière aléatoire dans chaque cellule"@fr , "process in which the area to be sampled is divided into a number of identical grid cells (strata) and <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">samples <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> are taken randomly in each cell"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.497" ;
        skos:prefLabel   "stratified random sampling"@en , "échantillonnage aléatoire stratifié"@fr .

