<https://data.geoscience.earth/ncl/ISO11074v2025/3.426>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.426> ;
        skos:definition  "partie de l'<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.260\">incertitude de mesure&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.260)</span></a></span> totale attribuable à l'<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.410\">échantillonnage&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.410)</span></a></span>"@fr , "part of the total <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.260\">measurement uncertainty <span class=\"sts-tbx-entailedTerm-num\">(3.260)</span></a></span> attributable to <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.410\">sampling <span class=\"sts-tbx-entailedTerm-num\">(3.410)</span></a></span>"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.426" ;
        skos:prefLabel   "sampling uncertainty"@en , "incertitude de l'échantillonnage"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.300>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.300> ;
        skos:definition  "summarizing parameter including all the carbon forms for dissolved (<i>dissolved organic carbon </i>(<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.128\">DOC) <span class=\"sts-tbx-entailedTerm-num\">(3.128)</span></a></span>) and total organic compounds (<i>total organic carbon </i>(<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.539\">TOC) <span class=\"sts-tbx-entailedTerm-num\">(3.539)</span></a></span>)"@en , "paramètre global incluant toutes les formes de carbone organique dissous (<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.128\">carbone organique dissous&nbsp;(COD)&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.128)</span></a></span>) et de composés organiques totaux (<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.359\">carbone organique total&nbsp;(COT)&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.359)</span></a></span>)"@fr ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.300" ;
        skos:note        "Note 1 to entry: Organic carbon is not synonymous with organic matter (3.301)."@en , "Note 1 à l’article: Le carbone organique n'est pas synonyme de la matière organique (3.301)."@fr ;
        skos:prefLabel   "carbone organique"@fr , "organic carbon"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.215>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.215> ;
