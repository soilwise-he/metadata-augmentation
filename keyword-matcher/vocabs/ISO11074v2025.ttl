        skos:definition  "effet préjudiciable mesurable sur un <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.370\">récepteur&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.370)</span></a></span>"@fr , "measurable adverse effect on a <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.370\">receptor <span class=\"sts-tbx-entailedTerm-num\">(3.370)</span></a></span>"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.198" ;
