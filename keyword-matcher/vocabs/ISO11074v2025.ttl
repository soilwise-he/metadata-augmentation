        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.285" ;
        skos:prefLabel   "valeur de fond naturelle"@fr , "natural background value"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.551>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.551> ;
        skos:definition  "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.410\">échantillonnage&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.410)</span></a></span> impliquant dans un premier temps l'installation d'un <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.56\">sondage&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.56)</span></a></span> à l'aide d'un instrument de <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.134\">forage&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.134)</span></a></span> ou au moyen d'un petit <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.56\">sondage&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.56)</span></a></span> et, dans un deuxième temps, l'échantillonnage des <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.454\">gaz du sol&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.454)</span></a></span> à partir d'une <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.456\">sonde&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.456)</span></a></span> installée dans le sondage"@fr , "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.410\">sampling <span class=\"sts-tbx-entailedTerm-num\">(3.410)</span></a></span> done firstly through installation of a <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.56\">borehole <span class=\"sts-tbx-entailedTerm-num\">(3.56)</span></a></span> with the aid of a <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.134\">drilling <span class=\"sts-tbx-entailedTerm-num\">(3.134)</span></a></span> instrument or by small <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.56\">boring <span class=\"sts-tbx-entailedTerm-num\">(3.56)</span></a></span> and secondly by sampling of <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.454\">soil gas <span class=\"sts-tbx-entailedTerm-num\">(3.454)</span></a></span> from a <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.456\">soil gas probe <span class=\"sts-tbx-entailedTerm-num\">(3.456)</span></a></span> installed in the borehole"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.551" ;
        skos:prefLabel   "échantillonnage des gaz du sol en deux étapes"@fr , "two-stage soil gas sampling"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.466>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.466> ;
        skos:definition  "propriétés du sol, positives ou négatives du point de vue de son utilisation et de ses <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.453\">fonctions&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.453)</span></a></span>"@fr , "positive or negative properties with regards to soil utilization and <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.453\">soil functions <span class=\"sts-tbx-entailedTerm-num\">(3.453)</span></a></span>"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.466" ;
        skos:prefLabel   "soil quality"@en , "qualité du sol"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.340>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.340> ;
        skos:definition  "processus d'élaboration d'une statistique à partir des valeurs observées afin de prédire des variables aléatoires en un emplacement non échantillonné"@fr , "process of forming a statistic from observed values to predict random variables at an unsampled location"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.340" ;
        skos:prefLabel   "prédiction"@fr , "prediction"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.255>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.255> ;
        skos:altLabel    "phase 3"@en , "phase 3"@fr ;
        skos:definition  "travail visant à évaluer avec exactitude la <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.466\">qualité du sol&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.466)</span></a></span> en recherchant les <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.91\">contaminants&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.91)</span></a></span> et en rassemblant toutes les autres informations nécessaires à l'identification et à l'appréciation des <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.393\">risques&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.393)</span></a></span>, afin de pouvoir décider de l'opportunité d'appliquer des actions de dépollution et d'envisager les premières décisions quant à la nature des travaux à entreprendre"@fr , "accurate evaluation of the <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.466\">soil quality <span class=\"sts-tbx-entailedTerm-num\">(3.466)</span></a></span> for <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.91\">contaminants <span class=\"sts-tbx-entailedTerm-num\">(3.91)</span></a></span> and all other information necessary for identification and assessment of <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.393\">risks <span class=\"sts-tbx-entailedTerm-num\">(3.393)</span></a></span> and to enable decisions to be made about the need for remedial actions and for preliminary decisions about the nature of the works required"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.255" ;
        skos:prefLabel   "investigation approfondie"@fr , "main investigation"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.85>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.85> ;
        skos:definition  "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.46\">traitement biologique&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.46)</span></a></span> d'un sol contaminé, généralement (mais pas toujours) en <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.53\">lit de traitement&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.53)</span></a></span>, permettant une transformation <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.13\">aérobie&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.13)</span></a></span> de la matière organique"@fr , "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.46\">biological treatment <span class=\"sts-tbx-entailedTerm-num\">(3.46)</span></a></span> of contaminated soil usually (but not always) in <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.53\">treatment bed <span class=\"sts-tbx-entailedTerm-num\">(3.53)</span></a></span> where organic substances are submitted to <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.13\">aerobic <span class=\"sts-tbx-entailedTerm-num\">(3.13)</span></a></span> transformation"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.85" ;
        skos:prefLabel   "composting"@en , "compostage"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.521>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.521> ;
        skos:definition  "process of taking <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">samples <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> using a <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.416\">sampling pattern <span class=\"sts-tbx-entailedTerm-num\">(3.416)</span></a></span> intermediate between a regular grid and <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.497\">stratified random sampling <span class=\"sts-tbx-entailedTerm-num\">(3.497)</span></a></span>, where each row (respectively column) of the grid shows a similar pattern of unaligned points"@en , "processus de prélèvement d'<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">échantillons&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> utilisant une <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.416\">grille d'échantillonnage&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.416)</span></a></span> intermédiaire entre une grille régulière et un <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.497\">échantillonnage aléatoire stratifié&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.497)</span></a></span>, où chaque rangée (respectivement chaque colonne) de la grille présente un motif similaire de points non alignés"@fr ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.521" ;
        skos:note        "Note 1 à l’article: Voir l’ISO 18400-104:2018, Figure B.8."@fr , "Note 1 to entry: See ISO 18400-104:2018, Figure B.8."@en ;
        skos:prefLabel   "échantillonnage systématique non aligné"@fr , "systematic unaligned sampling"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.436>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.436> ;
        skos:definition  "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">échantillon&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> choisi ou constitué délibérément sur la base d'une ou de certaines <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.70\">caractéristiques&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.70)</span></a></span> spécifiques du matériau à échantillonner"@fr , "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">sample <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> deliberately chosen or formed, based on some specific <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.70\">characteristic(s) <span class=\"sts-tbx-entailedTerm-num\">(3.70)</span></a></span> of the material to be sampled"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.436" ;
        skos:note        "Note 1 à l’article: L’aspect, l’odeur, la granulométrie sont des exemples de caractéristiques."@fr , "Note 1 to entry: Characteristics include appearance, odour and particle sizes."@en ;
        skos:prefLabel   "échantillon sélectif"@fr , "selective sample"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.310>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.310> ;
        skos:definition  "rapport de la <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.86\">concentration&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.86)</span></a></span> d'une substance dans le sol à celle dans un végétal"@fr , "ratio between the <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.86\">concentrations <span class=\"sts-tbx-entailedTerm-num\">(3.86)</span></a></span> of a substance in the soil and in plant material"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.310" ;
        skos:prefLabel   "partition coefficient between soil and plant"@en , "coefficient de répartition entre le sol et la plante"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.225>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.225> ;
        skos:definition  "quantité ou <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.86\">concentration&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.86)</span></a></span> de particules en suspension dans l'air et de gaz qui atteignent le corps par inhalation"@fr , "quantity or <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.86\">concentration <span class=\"sts-tbx-entailedTerm-num\">(3.86)</span></a></span> of airborne particles and gases reaching the body by inhalation"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.225" ;
        skos:note        "Note 1 to entry: The inhalation exposure covers alveolar exposure as well as bronchial exposure; and this bronchial mucus can subsequently be ingested."@en , "Note 1 à l’article: L'exposition par inhalation couvre l'exposition alvéolaire ainsi que l'exposition bronchique, le mucus bronchique pouvant à son tour être ingéré."@fr ;
        skos:prefLabel   "exposition par inhalation"@fr , "inhalation exposure"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.55>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.55> ;
        skos:altLabel    "BP"@en , "PE"@fr ;
        skos:definition  "point at which the vapour pressure of a liquid equals the external pressure acting on the surface of liquid"@en , "température à laquelle la pression de vapeur d'un liquide est égale à la pression extérieure qui s'exerce sur la surface du liquide"@fr ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.55" ;
        skos:note        "Note 1 to entry: It is expressed in degrees Celsius."@en , "Note 1 à l’article: Il est exprimé en degrés Celsius."@fr ;
        skos:prefLabel   "boiling point"@en , "point d'ébullition"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.406>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.406> ;
        skos:definition  "nombre d'éléments ou quantité de matériau constituant un <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">échantillon&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span>"@fr , "number of items or the quantity of material constituting a <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">sample <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span>"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.406" ;
        skos:prefLabel   "sample size"@en , "taille de l'échantillon"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.382>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.382> ;
        skos:definition  "objectif en lien avec des exigences techniques (par exemple, <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.86\">concentrations&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.86)</span></a></span> en polluant(s) correspondant à la <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.388\">contamination résiduelle&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.388)</span></a></span>, performances techniques), administratives et légales"@fr , "objective related to technical (e.g. <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.388\">residual contamination <span class=\"sts-tbx-entailedTerm-num\">(3.388)</span></a></span><span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.86\">concentrations <span class=\"sts-tbx-entailedTerm-num\">(3.86)</span></a></span>, engineering performance), administrative, and legal requirements"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.382" ;
        skos:prefLabel   "remediation objective"@en , "objectif de dépollution"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.25>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.25> ;
        skos:definition  "plan précisant les <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">échantillons&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> à analyser ou à soumettre à l'essai, les paramètres à mesurer, les méthodes de préparation des échantillons ainsi que les méthodes d'analyse ou d'essai à employer"@fr , "plan comprising the <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">samples <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> to be analysed or tested, the parameters to be measured, sample preparation methods, and the analytical or testing methods to be employed"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.25" ;
        skos:note        "Note 1 to entry: There should be associated quality assurance methods."@en , "Note 1 à l’article: Il convient d'y associer des méthodes d'assurance qualité."@fr ;
        skos:prefLabel   "stratégie d'analyse et d'essai"@fr , "analytical and testing strategy"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.297>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.297> ;
        skos:definition  "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.410\">échantillonnage&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.410)</span></a></span> des <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.454\">gaz du sol&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.454)</span></a></span> réalisé directement à partir d'une <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.456\">sonde&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.456)</span></a></span> placée dans le sol, sans préforage"@fr , "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.410\">sampling <span class=\"sts-tbx-entailedTerm-num\">(3.410)</span></a></span> of <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.454\">soil gas <span class=\"sts-tbx-entailedTerm-num\">(3.454)</span></a></span> directly from a <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.456\">soil gas probe <span class=\"sts-tbx-entailedTerm-num\">(3.456)</span></a></span> placed in soil, without pre-drilling"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.297" ;
        skos:note        "Note 1 à l’article: Dans des conditions d'extrême chaleur, certaines substances peuvent passer à l'état gazeux, ce qui ne serait pas le cas dans d'autres conditions; les gaz ainsi formés ne sont pas des gaz permanents (3.319)."@fr , "Note 1 to entry: Under extremely hot circumstances, some substances can become gases that would not otherwise be. These are not permanent gases (3.319)."@en ;
        skos:prefLabel   "one-stage soil gas sampling"@en , "échantillonnage des gaz du sol en une étape"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.171>
        a                skos:Concept ;
        dct:source       "ISO 3534-2:2006, 1.2.23, modified — Note 1 to entry has been added."@en , "ISO 3534‑2:2006, 1.2.23, modifié — La Note 1 à l’article a été ajoutée."@fr ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.171> ;
        skos:definition  "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">échantillon&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> obtenu lors de la dernière étape d'un <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.410\">échantillonnage&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.410)</span></a></span> à plusieurs degrés"@fr , "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">sample <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> obtained at the final step of multistage <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.410\">sampling <span class=\"sts-tbx-entailedTerm-num\">(3.410)</span></a></span>"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.171" ;
        skos:note        "Note 1 to entry: For example, for analytical operations the term “final sample” applies to the “test sample” (3.528)."@en , "Note 1 à l’article: Par exemple, pour des opérations d'analyse, le terme «échantillon final» s'applique à «l'échantillon pour essai» (3.528)."@fr ;
        skos:prefLabel   "échantillon final"@fr , "final sample"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.563>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.563> ;
        skos:definition  "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.86\">concentration&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.86)</span></a></span> d'une substance dans les sols résultant à la fois de la teneur pédo-géochimique naturelle et de l'<i>apport</i> modéré <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.124\">dû à une source diffuse&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.124)</span></a></span> dans le <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.448\">sol&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.448)</span></a></span>"@fr , "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.86\">concentration <span class=\"sts-tbx-entailedTerm-num\">(3.86)</span></a></span> of a substance in soils resulting from both the natural pedo-geochemical content and the moderate <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.124\">diffuse source input <span class=\"sts-tbx-entailedTerm-num\">(3.124)</span></a></span> into the <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.448\">soil <span class=\"sts-tbx-entailedTerm-num\">(3.448)</span></a></span>"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.563" ;
        skos:prefLabel   "usual content"@en , "teneur habituelle"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.478>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.478> ;
        skos:definition  "système d'entraînement par l'eau destiné à séparer, par voie physique, des <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.91\">contaminants&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.91)</span></a></span> du sol ou de <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.433\">sédiments&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.433)</span></a></span>"@fr , "water-based system designed to physically separate <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.91\">contaminants <span class=\"sts-tbx-entailedTerm-num\">(3.91)</span></a></span> from soil or <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.433\">sediment <span class=\"sts-tbx-entailedTerm-num\">(3.433)</span></a></span>"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.478" ;
        skos:note        "Note 1 to entry: Contaminants can be concentrated in a particular size fraction (usually a fine fraction) leaving the remaining (coarser) material free of contamination (3.93)."@en , "Note 1 à l’article: Les contaminants peuvent être concentrés sur une fraction granulométrique particulière (en général une fraction fine) sans que le reste des matériaux (fractions plus grossières) ne soit touché par la contamination (3.93)."@fr ;
        skos:prefLabel   "lavage du sol"@fr , "soil washing"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.352>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.352> ;
        skos:definition  "description, according to a specified system or terminology, of the features of a soil exposed in a pit or section and its environment"@en , "description des caractéristiques morphologiques d'un sol, observé dans une fosse ou sur une coupe, et de son environnement, réalisée en utilisant un système ou une terminologie spécifique"@fr ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.352" ;
        skos:note        "Note 1 à l’article: Voir l’ISO 25177."@fr , "Note 1 to entry: See ISO 25177."@en ;
        skos:prefLabel   "profile description"@en , "description du profil"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.267>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.267> ;
        skos:definition  "moyens par lesquels des <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.91\">contaminants&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.91)</span></a></span> ou des <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.202\">substances dangereuses&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.202)</span></a></span> peuvent être dispersés ou distribués depuis une <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.484\">source&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.484)</span></a></span> donnée de <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.93\">contamination&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.93)</span></a></span>"@fr , "means by which <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.91\">contaminants <span class=\"sts-tbx-entailedTerm-num\">(3.91)</span></a></span> or <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.202\">hazardous substances <span class=\"sts-tbx-entailedTerm-num\">(3.202)</span></a></span> from a particular <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.484\">source <span class=\"sts-tbx-entailedTerm-num\">(3.484)</span></a></span> of <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.93\">contamination <span class=\"sts-tbx-entailedTerm-num\">(3.93)</span></a></span> can spread or distribute"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.267" ;
        skos:note        "Note 1 to entry: A migration pathway does not necessarily link to a receptor (3.370)."@en , "Note 1 à l’article: Une voie de transfert n'établit pas nécessairement un lien avec un récepteur (3.370)."@fr ;
        skos:prefLabel   "migration pathway"@en , "voie de transfert"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.97>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.97> ;
        skos:definition  "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">sample <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> chosen on the basis of accessibility, expediency, cost, efficiency, or other reason not directly concerned with sampling parameters"@en , "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">échantillon&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> choisi en fonction de l'accessibilité, de l'adéquation, des coûts, de l'efficacité ou de tout autre motif sans rapport direct avec les paramètres d'échantillonnage"@fr ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.97" ;
        skos:note        "Note 1 to entry: The term “ad hoc sample” is sometimes applied to this type of sample."@en , "Note 1 à l’article: Le terme «échantillon ad hoc» est parfois appliqué à ce type d'échantillon."@fr ;
        skos:prefLabel   "échantillon de commodité"@fr , "convenience sample"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.141>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.141> ;
        skos:altLabel    "CEx"@fr , "ECx"@en ;
        skos:definition  "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.86\">concentration <span class=\"sts-tbx-entailedTerm-num\">(3.86)</span></a></span> (mass fraction) of a <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.524\">test material <span class=\"sts-tbx-entailedTerm-num\">(3.524)</span></a></span> or <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.530\">test substance <span class=\"sts-tbx-entailedTerm-num\">(3.530)</span></a></span> that causes <i>x</i>&nbsp;% of an effect on a given end point within a given <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.159\">exposure <span class=\"sts-tbx-entailedTerm-num\">(3.159)</span></a></span> (<a class=\"sts-xref\" href=\"#iso:std:iso:11074:ed-3:v1:en:sec:3.160\">3.160</a>) period, when compared with a control"@en , "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.86\">concentration&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.86)</span></a></span> (fraction massique) d'un <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.524\">matériau d'essai&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.524)</span></a></span> ou d'une <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.530\">substance d'essai&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.530)</span></a></span> qui, par rapport à un témoin, engendre un effet de x&nbsp;% sur un critère d'effet donné pendant une période d'<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.159\">exposition <span class=\"sts-tbx-entailedTerm-num\">(3.159)</span></a></span>&nbsp;(<a class=\"sts-xref\" href=\"#iso:std:iso:11074:ed-3:v1:fr:sec:3.160\">3.160</a>) définie"@fr ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.141" ;
        skos:note        "Note 1 à l’article: La CEx est exprimée en pourcentage du sol ou du matériau soumis à essai par masse sèche de mélange de sols. Lorsque des substances chimiques sont soumises à essai, la CEx est exprimée en masse de la substance d'essai par masse sèche de sol, en milligrammes par kilogramme."@fr , "Note 1 to entry: The ECx is expressed as a percentage of soil or test material per dry mass of soil mixture. When chemicals are tested, the ECx is expressed as mass of the test substance per dry mass of soil, in milligrams per kilogram."@en ;
        skos:prefLabel   "effect concentration for x % effect"@en , "concentration efficace à x %"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.533>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.533> ;
        skos:definition  "traitement utilisant la chaleur pour détruire, éliminer ou immobiliser des <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.91\">contaminants&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.91)</span></a></span>"@fr , "treatment in which heat is applied to destroy, remove, or immobilise <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.91\">contaminants <span class=\"sts-tbx-entailedTerm-num\">(3.91)</span></a></span>"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.533" ;
        skos:prefLabel   "traitement thermique"@fr , "thermal treatment"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.448>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.448> ;
        skos:definition  "upper layer of the Earth’s crust transformed by weathering and physical/chemical and biological processes and composed of mineral particles, <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.301\">organic matter <span class=\"sts-tbx-entailedTerm-num\">(3.301)</span></a></span>, water, air, and living organisms organized in soil horizons"@en , "couche supérieure de la croûte terrestre transformée par des processus climatiques, physico-chimiques et biologiques et composée de particules minérales, de <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.301\">matière organique&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.301)</span></a></span>, d'eau, d'air et d'organismes vivants, organisée en horizons de sols"@fr ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.448" ;
        skos:note        "Note 1 à l’article: En génie civil, les termes «horizon» et «sol» ont une acceptation plus large et incluent l'horizon superficiel (3.536) et le sous-sol; les dépôts tels que les argiles, limons, sables, graviers, gravillons, pierres, ainsi que la matière organique et les dépôts tels que la tourbe; les matériaux d'origine anthropique tels que les déchets; les gaz et l'humidité du sol; et les organismes vivants."@fr , "Note 1 to entry: In a broader horizon civil engineering sense, soil includes topsoil (3.536) and sub-soil; deposits such as clays, silts, sands, gravels, cobbles, boulders, and organic matter and deposits such as peat; materials of human origin such as wastes; ground gas and moisture; and living organisms."@en ;
        skos:prefLabel   "soil"@en , "sol"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.322>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.322> ;
        skos:definition  "temps de séjour d'une espèce chimique dans un compartiment spécifiquement défini de l'environnement"@fr , "residence time of a chemical species in a specifically defined compartment of the environment"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.322" ;
        skos:prefLabel   "persistance"@fr , "persistence"@en ;
        <https://w3id.org/dpv#hasContext>
                "biodegradability"@en , "biodégradabilité"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.237>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.237> ;
        skos:altLabel    "épandage contrôlé"@fr ;
        skos:definition  "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.46\">traitement biologique&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.46)</span></a></span> ayant largement recours à des techniques agricoles, appliqué directement aux sols en place contaminés en surface"@fr , "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.46\">biological treatment <span class=\"sts-tbx-entailedTerm-num\">(3.46)</span></a></span> applied directly to <i>in situ</i> contaminated surface soils using largely agricultural technique"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.237" ;
        skos:note        "Note 1 to entry: Also applied to oily materials, etc., and deliberately applied to soil as means of treatment/disposal."@en , "Note 1 à l’article: S'applique également aux matériaux contenant des hydrocarbures, etc., appliqués volontairement sur les sols comme moyen de traitement ou de mise en décharge."@fr ;
        skos:prefLabel   "landfarming"@en , "biorégénération du sol"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.67>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.67> ;
        skos:altLabel    "CRM"@en , "MRC"@fr ;
        skos:definition  "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.374\">matériau de référence&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.374)</span></a></span>, dont au moins une des propriétés a une valeur certifiée par une procédure validée sur le plan technique, accompagné d'un certificat ou de tout autre document permettant d'identifier l'origine du certificat"@fr , "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.374\">reference material <span class=\"sts-tbx-entailedTerm-num\">(3.374)</span></a></span>, one or more of whose property values are certified by a technically valid procedure accompanied by a certificate or any document allowing the identification of the origin of the certificate"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.67" ;
        skos:prefLabel   "matériau de référence certifié"@fr , "certified reference material"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.111>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.111> ;
        skos:definition  "volume présent entre l'ouverture d'aspiration de la <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.456\">sonde de gaz du sol&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.456)</span></a></span> et le flacon d'échantillonnage, y compris le volume du flacon d'échantillonnage ou du tube d'absorption"@fr , "volume which is present between the suction opening of the <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.456\">soil gas probe <span class=\"sts-tbx-entailedTerm-num\">(3.456)</span></a></span> and the sampling vial, including the volume of the sampling vial or the absorption tube"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.111" ;
        skos:prefLabel   "dead volume"@en , "volume mort"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.503>
        a                skos:Concept ;
        dct:source       "ISO 3534-2:2006, 1.2.19"@en , "ISO 3534‑2:2006, 1.2.19"@fr ;
