<https://data.geoscience.earth/ncl/ISO11074v2025/3.216>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.216> ;
        skos:definition  "méthode de traitement directement appliquée au sol"@fr , "treatment method applied directly in the ground"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.216" ;
        skos:note        "Note 1 to entry: The treatment can be applied to different media (3.262) (e.g. soil, groundwater (3.191)) without extraction from the ground."@en , "Note 1 à l’article: Le traitement peut être appliqué à différents milieux (3.262) (par exemple, sol, eaux souterraines (3.191)) sans déplacement préalable."@fr ;
        skos:prefLabel   "méthode de traitement in situ"@fr , "in situ treatment method"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.46>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.46> ;
        skos:definition  "méthodes utilisant l'activité naturelle de plantes ou de <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.266\">micro-organismes&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.266)</span></a></span>, tels que les bactéries ou les champignons, pour transformer, détruire, fixer ou immobiliser les <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.91\">contaminants&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.91)</span></a></span>"@fr , "methods using the natural activities of plants or <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.266\">microorganisms <span class=\"sts-tbx-entailedTerm-num\">(3.266)</span></a></span>, such as bacteria and fungi, to transform, destroy, fix or immobilise <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.91\">contaminants <span class=\"sts-tbx-entailedTerm-num\">(3.91)</span></a></span>"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.46" ;
        skos:prefLabel   "biological treatment"@en , "traitement biologique"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.192>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.192> ;
        skos:definition  "évacuation de l’<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.191\">eau souterraine&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.191)</span></a></span> par pompage"@fr , "removal of <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.191\">groundwater <span class=\"sts-tbx-entailedTerm-num\">(3.191)</span></a></span> from the ground using pumps"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.192" ;
        skos:prefLabel   "groundwater extraction"@en , "extraction de l’eau souterraine"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.499>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.499> ;
        skos:definition  "échantillonnage, dans une <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.331\">population&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.331)</span></a></span> qui peut être divisée en <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.502\">sous-populations&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.502)</span></a></span> mutuellement exclusives et exhaustives (appelés strates), effectué de telle façon que des proportions spécifiées de l'<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">échantillon&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> soient prélevées dans les différentes strates et que chaque strate soit échantillonnée avec au moins une unité d'<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.410\">échantillonnage&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.410)</span></a></span>"@fr , "sampling, in a <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.331\">population <span class=\"sts-tbx-entailedTerm-num\">(3.331)</span></a></span> which can be divided into mutually exclusive and exhaustive <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.502\">sub-populations <span class=\"sts-tbx-entailedTerm-num\">(3.502)</span></a></span> (called strata), carried out in such a way that specified proportions of the <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">sample <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> are drawn from the different strata and each stratum is sampled with at least one <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.410\">sampling <span class=\"sts-tbx-entailedTerm-num\">(3.410)</span></a></span> unit"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.499" ;
        skos:prefLabel   "échantillonnage stratifié"@fr , "stratified sampling"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.373>
