        skos:notation    "3.240" ;
        skos:prefLabel   "leaching"@en , "lixiviation"@fr ;
        <https://w3id.org/dpv#hasContext>
                "général"@fr , "general"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.70>
        a                skos:Concept ;
