        skos:prefLabel   "réutilisation de matériau du sol"@fr , "reuse of soil material"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.204>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.204> ;
        skos:definition  "having the same properties at all points when viewed at a scale suitable to the job at hand"@en , "dont l'analyse, effectuée à une échelle adaptée à la tâche à exécuter, révèle les mêmes propriétés en tous points"@fr ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.204" ;
        skos:note        "Note 1 to entry: This is the opposite of heterogeneous (3.203)."@en , "Note 1 à l’article: Le contraire est «hétérogène» (3.203)."@fr ;
        skos:prefLabel   "homogène"@fr , "homogeneous"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.34>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.34> ;
        skos:definition  "tendance (d'un organisme) à éviter le sol soumis à essai et à préférer le <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.95\">sol témoin&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.95)</span></a></span>"@fr , "tendency (of an organism) to avoid the test soil while preferring the <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.95\">control soil <span class=\"sts-tbx-entailedTerm-num\">(3.95)</span></a></span>"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.34" ;
        skos:prefLabel   "avoidance behaviour"@en , "comportement d'évitement"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.119>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.119> ;
        skos:altLabel    "DNAPL"@en , "LDPNA"@fr ;
        skos:definition  "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.291\">non-aqueous phase liquid (NAPL) <span class=\"sts-tbx-entailedTerm-num\">(3.291)</span></a></span> denser than water"@en , "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.291\">liquide en phase non aqueuse&nbsp;(LPNA)&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.291)</span></a></span> d'une densité supérieure à celle de l'eau"@fr ;
        skos:example     "Trichloroéthylène."@fr , "Trichloroethene."@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.119" ;
        skos:note        "Note 1 to entry: For light non-aqueous phase liquid (LNAPL), see 3.245."@en , "Note 1 à l’article: Pour les liquides légers en phase non aqueuse (LLPNA), voir 3.245."@fr ;
        skos:prefLabel   "liquide dense en phase non aqueuse"@fr , "dense non-aqueous phase liquid"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.180>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.180> ;
        skos:definition  "mesure destinée à protéger les bâtiments contre les gaz de <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.238\">décharge&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.238)</span></a></span> et autres gaz, combinant généralement une mesure de prévention contre la pénétration de gaz à une mesure d'alarme en cas de danger"@fr , "measure to protect buildings from <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.238\">landfill <span class=\"sts-tbx-entailedTerm-num\">(3.238)</span></a></span> and other gases, usually combining measures to prevent entry of gas and to provide warnings of unsafe conditions"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.180" ;
        skos:prefLabel   "gas protection measure"@en , "mesure de protection contre les gaz"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.572>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.572> ;
        skos:definition  "teneur en eau du <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.448\">sol&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.448)</span></a></span> au-dessous de laquelle les plantes ne sont plus capables de prélever de l'eau par leur système racinaire"@fr , "water content of the <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.448\">soil <span class=\"sts-tbx-entailedTerm-num\">(3.448)</span></a></span> below which the plants are not able to take up water with their root system"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.572" ;
        skos:note        "Note 1 to entry: Permanent wilting point (PWP) is the moisture content below which a sunflower seedling cannot recover from wilt. It is generally taken to equal a suction of 1 500 kPa."@en , "Note 1 à l’article: Le point de flétrissement permanent (PFP) est le taux d'humidité au-dessous duquel le flétrissement d'un plant de tournesol devient irréversible. Il est généralement considéré égal à une aspiration de 1 500 kPa."@fr ;
        skos:prefLabel   "point de flétrissement"@fr , "wilting point"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.487>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.487> ;
        skos:definition  "surface totale des particules d'un échantillon de <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.448\">sol&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.448)</span></a></span> ou d'une fraction granulométrique de l’échantillon de sol, rapportée à l'unité de masse ou à l'unité de volume"@fr , "surface area of the <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.448\">soil <span class=\"sts-tbx-entailedTerm-num\">(3.448)</span></a></span> or a size fraction of the soil particles"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.487" ;
        skos:note        "Note 1 à l’article: La surface spécifique peut être déterminée par différents moyens pouvant donner des résultats différents, par exemple: a) rapport de la surface à la masse des particules solides; b) rapport de la surface au volume des particules solides."@fr , "Note 2 à l’article: Dans la mesure où les deux expressions (rapport à la masse, rapport au volume) sont utilisées, ce terme doit être défini de manière explicite chaque fois qu'il est utilisé."@fr , "Note 1 to entry: Surface area can be measured by a variety of means that can give differing results, such as: a) ratio of surface area to mass of solid particles; b) ratio of surface area to volume of solid particles."@en , "Note 2 to entry: Because both expressions (mass and volume) are in use, this term shall be defined explicitly wherever it is used."@en ;
        skos:prefLabel   "specific surface area"@en , "surface spécifique"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.361>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.361> ;
        skos:altLabel    "qPCR standard"@en , "étalon de qPCR"@fr ;
        skos:definition  "ADN cible cloné utilisé comme matrice pour la réaction&nbsp;<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.360\">qPCR&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.360)</span></a></span> afin d'établir la courbe d'étalonnage de l'abondance d'une séquence cible en fonction des valeurs du <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.108\">cycle seuil&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.108)</span></a></span>&nbsp;(Ct)"@fr , "cloned DNA target used as template for <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.360\">qPCR <span class=\"sts-tbx-entailedTerm-num\">(3.360)</span></a></span> reaction to establish the standard curve relating the abundance of target sequence as a function of <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.108\">cycle threshold <span class=\"sts-tbx-entailedTerm-num\">(3.108)</span></a></span> values (Ct)"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.361" ;
        skos:prefLabel   "étalon d'amplification par réaction de polymérisation en chaîne quantitative"@fr , "quantitative polymerase chain reaction standard"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.276>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.276> ;
        skos:definition  "processus d'observation répétitive, pour des objectifs définis, d'un ou de plusieurs éléments de l'environnement selon des programmes préétablis dans le temps et dans l'espace, en utilisant des méthodes comparables pour l'analyse de l'environnement et la collecte des données"@fr , "process of repetitive observation for defined purposes of one or more elements of the environment, according to pre-arranged schedules in space and time, using comparable methods for environmental sensing and data collection"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.276" ;
        skos:prefLabel   "monitoring"@en , "surveillance"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.150>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.150> ;
        skos:definition  "paramètre déterminé de manière empirique, lié au <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.55\">point d'ébullition&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.55)</span></a></span> d'une substance chimique normalisé au point d'ébullition des <i>n</i>-alcanes ou à son temps de rétention au point d'ébullition dans une colonne de chromatographie en phase gazeuse&nbsp;(CG)"@fr , "empirically determined parameter related to the <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.55\">boiling point <span class=\"sts-tbx-entailedTerm-num\">(3.55)</span></a></span> of a chemical normalized to the boiling point of the <i>n</i>‑alkanes or its retention time in a boiling-point gas chromatographic (GC) column"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.150" ;
        skos:prefLabel   "equivalent carbon number"@en , "nombre de carbone équivalent"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.542>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.542> ;
        skos:definition  "propriété du résultat d'une mesure selon laquelle il peut être relié à des étalons appropriés, généralement internationaux ou nationaux, par l'intermédiaire d'une chaîne ininterrompue de comparaisons"@fr , "property of the result of a measurement whereby it can be related to appropriate measurement standards, generally international or national standards, through an unbroken chain of comparisons"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.542" ;
        skos:note        "Note 1 à l’article: La chaîne ininterrompue de comparaisons est appelée «chaîne de traçabilité». Voir l’ISO 10012."@fr , "Note 1 to entry: The unbroken chain of comparisons is called a “traceability chain”. See ISO 10012."@en ;
        skos:prefLabel   "traceability"@en , "traçabilité"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.457>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.457> ;
        skos:definition  "volume de <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.454\">gaz du sol&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.454)</span></a></span> prélevé pour constituer l'<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">échantillon&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span>"@fr , "volume of <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.454\">soil gas <span class=\"sts-tbx-entailedTerm-num\">(3.454)</span></a></span> taken to form the <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">sample <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span>"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.457" ;
        skos:prefLabel   "soil gas sample volume"@en , "volume d'échantillon de gaz du sol"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.331>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.331> ;
        skos:definition  "intégralité d'un volume ou d'une masse de sol à propos de laquelle des informations sont recherchées par le biais d'un <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.410\">échantillonnage&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.410)</span></a></span>"@fr , "entirety of a soil volume or mass about which information is sought via <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.410\">sampling <span class=\"sts-tbx-entailedTerm-num\">(3.410)</span></a></span>"@en ;
        skos:example     "The entirety can be a particular site (3.443), in situ volume of soil, stockpile (3.496), truck load."@en , "L'intégralité peut être, par exemple, un site (3.443) particulier, un volume de sol in situ, un dépôt en tas (3.496), un chargement de camion."@fr ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.331" ;
        skos:prefLabel   "population"@en , "population"@fr ;
        <https://w3id.org/dpv#hasContext>
                "échantillonnage du sol"@fr , "soil sampling"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.246>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.246> ;
        skos:definition  "essai à une seule <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.86\">concentration&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.86)</span></a></span>, au cours duquel, par exemple, le sol soumis à essai, non dilué, ou le mélange d'une <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.530\">substance d'essai&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.530)</span></a></span> en concentration unique avec le <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.95\">sol témoin&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.95)</span></a></span> est comparé au sol témoin"@fr , "single <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.86\">concentration <span class=\"sts-tbx-entailedTerm-num\">(3.86)</span></a></span> test, e.g. the test soil without any dilution or one concentration of a <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.530\">test substance <span class=\"sts-tbx-entailedTerm-num\">(3.530)</span></a></span> mixed into the <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.95\">control soil <span class=\"sts-tbx-entailedTerm-num\">(3.95)</span></a></span> and compared with the control"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.246" ;
        skos:prefLabel   "essai limite"@fr , "limit test"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.76>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.76> ;
        skos:definition  "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.83\">composite sample <span class=\"sts-tbx-entailedTerm-num\">(3.83)</span></a></span> (<a class=\"sts-xref\" href=\"#iso:std:iso:11074:ed-3:v1:en:sec:3.84\">3.84</a>) for which the <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.218\">increments <span class=\"sts-tbx-entailedTerm-num\">(3.218)</span></a></span> are taken over a small area around a predefined <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.418\">sampling point <span class=\"sts-tbx-entailedTerm-num\">(3.418)</span></a></span>"@en , "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.83\">échantillon composite&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.83)</span></a></span>&nbsp;(<a class=\"sts-xref\" href=\"#iso:std:iso:11074:ed-3:v1:fr:sec:3.84\">3.84</a>) pour lequel les <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.218\">prélèvements élémentaires&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.218)</span></a></span> sont effectués dans une petite zone autour d'un <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.418\">point d'échantillonnage&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.418)</span></a></span> prédéfini"@fr ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.76" ;
        skos:note        "Note 1 à l’article: La zone échantillonnée varie en général de 0,5 m2 à 1,0 m2."@fr , "Note 2 to entry: Material sampled is taken from within the same stratum or from material with the same characteristics (3.70)."@en , "Note 1 to entry: Sampled area is typically about 0,5 m2 to 1,0 m2."@en , "Note 2 à l’article: Le matériau échantillonné est prélevé dans la même strate ou à partir d'un matériau présentant les mêmes caractéristiques (3.70)."@fr ;
        skos:prefLabel   "échantillon en grappe"@fr , "cluster sample"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.120>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.120> ;
        skos:altLabel    "metric sample"@en , "échantillon métrique"@fr ;
        skos:definition  "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">échantillon&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> prélevé à une profondeur prédéfinie, indépendamment des conditions et des <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.70\">caractéristiques&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.70)</span></a></span> du sol"@fr , "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">sample <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> collected at a predefined depth independent of the present soil conditions and <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.70\">characteristics <span class=\"sts-tbx-entailedTerm-num\">(3.70)</span></a></span>"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.120" ;
        skos:prefLabel   "échantillon lié à la profondeur"@fr , "depth related sample"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.512>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.512> ;
        skos:definition  "couverture placée sur un <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.201\">site dangereux&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.201)</span></a></span> et composée principalement d'une <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.185\">géomembrane&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.185)</span></a></span>"@fr , "cover to <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.201\">hazardous site <span class=\"sts-tbx-entailedTerm-num\">(3.201)</span></a></span> composed primarily of a <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.185\">geomembrane <span class=\"sts-tbx-entailedTerm-num\">(3.185)</span></a></span>"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.512" ;
        skos:note        "Note 1 à l’article: D'autres géosynthétiques (3.188) ou matériaux naturels tels que du sable ou de la terre (sol) (3.448) peuvent être utilisés pour compléter la couverture (3.102)."@fr , "Note 1 to entry: Other geosynthetics (3.188) and natural materials, such as sand or soil (3.448), can be used to complete the cover system (3.102)."@en ;
        skos:prefLabel   "surface liner system"@en , "système d'isolement superficiel"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.427>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.427> ;
        skos:definition  "part of the soil which is completely saturated by water"@en , "partie du sol complètement saturée d'eau"@fr ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.427" ;
