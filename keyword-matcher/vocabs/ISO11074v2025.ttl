        skos:notation    "3.421" ;
        skos:prefLabel   "enregistrement d'échantillonnage"@fr , "sampling record"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.5>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.5> ;
        skos:definition  "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.113\">décomposition&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.113)</span></a></span> par des processus physiques et/ou chimiques (par exemple, photolyse, <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.211\">hydrolyse&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.211)</span></a></span>, <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.305\">oxydation&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.305)</span></a></span> et <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.373\">réduction&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.373)</span></a></span>)"@fr , "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.113\">decomposition <span class=\"sts-tbx-entailedTerm-num\">(3.113)</span></a></span> by physical and/or chemical processes (e.g. photolysis, <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.211\">hydrolysis <span class=\"sts-tbx-entailedTerm-num\">(3.211)</span></a></span>, <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.305\">oxidation <span class=\"sts-tbx-entailedTerm-num\">(3.305)</span></a></span>, and <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.373\">reduction <span class=\"sts-tbx-entailedTerm-num\">(3.373)</span></a></span>)"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.5" ;
        skos:prefLabel   "abiotic decomposition"@en , "décomposition abiotique"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.336>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.336> ;
        skos:definition  "opération effectuée sur un produit issu d'un traitement technologique pour le préparer à une mise en décharge ou à une réutilisation"@fr , "activity applied to the product of a process-based treatment to prepare it for disposal or reuse"@en ;
        skos:example     "Drying (3.135)"@en , "Séchage (3.135)"@fr ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
