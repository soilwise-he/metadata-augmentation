        skos:notation    "3.454" ;
        skos:prefLabel   "gaz du sol"@fr , "soil gas"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.369>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.369> ;
        skos:definition  "paroi perméable enterrée qui absorbe, qui dégrade ou qui réagit avec les <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.91\">contaminants&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.91)</span></a></span> des <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.191\">eaux souterraines&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.191)</span></a></span> qui s’écoulent à travers elles"@fr , "permeable in-ground wall which absorbs, reacts with, or degrades <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.91\">contaminants <span class=\"sts-tbx-entailedTerm-num\">(3.91)</span></a></span> in <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.191\">groundwater <span class=\"sts-tbx-entailedTerm-num\">(3.191)</span></a></span> migrating through it"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.369" ;
        skos:prefLabel   "barrière réactive"@fr , "reactive barrier"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.243>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.243> ;
        skos:definition  "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.544\">translocation <span class=\"sts-tbx-entailedTerm-num\">(3.544)</span></a></span> of solid particles within the soil profile"@en , "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.544\">transport&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.544)</span></a></span> de particules solides dans le profil du sol"@fr ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.243" ;
        skos:note        "Note 1 à l’article: Le lessivage est la combinaison de l'éluviation (processus de lixiviation du matériau depuis la partie supérieure du profil du sol) et de l'illuviation (accumulation (3.8) de ce matériau dans un horizon plus profond du profil du sol)."@fr , "Note 1 to entry: Lessivage is the combination of eluviation (process of material being leached from the upper part of the soil profile) and illuviation (accumulation (3.8) of that material lower in the soil profile)."@en ;
        skos:prefLabel   "lessivage"@fr , "lessivage"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.73>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.73> ;
        skos:altLabel    "système de classement"@fr , "ranking system"@en ;
        skos:definition  "système formalisé permettant d'effectuer une <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.341\">évaluation préliminaire&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.341)</span></a></span>"@fr , "formalized system to perform a <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.341\">preliminary assessment <span class=\"sts-tbx-entailedTerm-num\">(3.341)</span></a></span>"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.73" ;
        skos:note        "Note 1 à l’article: Les procédures formalisées peuvent également faciliter l'interprétation des résultats de l'investigation préliminaire (3.342)."@fr , "Note 1 to entry: Formalized procedures can also aid in interpreting results of the preliminary investigation (3.342)."@en ;
        skos:prefLabel   "classification system"@en , "système de classification"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.158>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.158> ;
        skos:definition  "emplacement où le sol/la roche ou une autre caractéristique géologique (par exemple, une faille, une discordance) est visible"@fr , "location where a soil/rock or other geological feature (e.g. fault, incongruity) can be seen"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.158" ;
