<https://data.geoscience.earth/ncl/ISO11074v2025/3.3>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.3> ;
        skos:definition  "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.443\">site&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.443)</span></a></span> laissé par son propriétaire ou un autre responsable dans un état non entretenu, dont l’historique donne à penser qu’il peut être dangereux"@fr , "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.443\">site <span class=\"sts-tbx-entailedTerm-num\">(3.443)</span></a></span>, left by the owner or other responsible party in unmanaged condition, whose history leads to a suspicion that it can be hazardous"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.3" ;
        skos:prefLabel   "site abandonné potentiellement dangereux"@fr , "abandoned potentially hazardous site"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.334>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.334> ;
        skos:definition  "volume des pores dans un <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">échantillon&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> de sol (volume non solide) divisé par le <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.64\">volume apparent&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.64)</span></a></span> de l'échantillon"@fr , "volume of pores in a soil <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">sample <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> (non-solid volume) divided by the <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.64\">bulk volume <span class=\"sts-tbx-entailedTerm-num\">(3.64)</span></a></span> of the sample"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.334" ;
        skos:prefLabel   "porosity"@en , "porosité"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.249>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.249> ;
        skos:definition  "continuous record as a function of depth (usually graphical and plotted to scale) of observations made on the materials and fluids of the section exposed in a drillhole"@en , "enregistrement continu (généralement sous forme d'un graphique à l'échelle) des observations faites en fonction de la profondeur sur les matériaux et les fluides de la section exposée dans un trou de forage"@fr ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.249" ;
        skos:note        "Note 2 à l’article: Une coupe peut faire partie des enregistrements d’échantillonnage (3.421); pour les échantillons (3.398) obtenus par forage, il convient d'intégrer une coupe dans le rapport d'échantillonnage (3.422)."@fr , "Note 1 à l’article: Pour une description concernant uniquement le sol, voir 3.448."@fr , "Note 2 to entry: A log can be one of the sampling records (3.421) and should be part of the sampling report (3.422) if the samples (3.398) are obtained from drillholes."@en , "Note 1 to entry: For a description concerning only the soil, see 3.448."@en ;
        skos:prefLabel   "log"@en , "coupe"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.79>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.79> ;
        skos:definition  "authority that assesses investigation results and takes decisions about the severity and urgency of the soil <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.93\">contamination <span class=\"sts-tbx-entailedTerm-num\">(3.93)</span></a></span> found, and that also assesses proposals for <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.380\">remediation <span class=\"sts-tbx-entailedTerm-num\">(3.380)</span></a></span> or <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.354\">protective measures <span class=\"sts-tbx-entailedTerm-num\">(3.354)</span></a></span>"@en , "autorité qui évalue les résultats des investigations, prend des décisions en fonction de la sévérité et de l'urgence de la <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.93\">contamination&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.93)</span></a></span> observée des sols et évalue également les propositions de <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.380\">dépollution&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.380)</span></a></span> ou de <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.354\">mesures de protection&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.354)</span></a></span>"@fr ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.79" ;
        skos:note        "Note 1 to entry: Depending on the site (3.443) and the country, the competent authority can be very different."@en , "Note 1 à l’article: Selon le site (3.443) et le pays, l'autorité compétente peut être très différente."@fr ;
        skos:prefLabel   "autorité compétente"@fr , "competent authority"@en ;
        <https://w3id.org/dpv#hasContext>
                "sites contaminés"@fr , "contaminated sites"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.123>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.123> ;
        skos:definition  "interruption of metabolism during egg, larva, pupa, or imago development"@en , "interruption du métabolisme durant le développement de l'œuf, de la larve, de la nymphe ou de l'imago"@fr ;
        skos:example     "Resting phase or period of quiescence of some earthworm species to resist drought."@en , "Chez certaines espèces de vers de terre, phase de repos ou période de quiescence permettant de résister à la sécheresse."@fr ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.123" ;
        skos:prefLabel   "diapause"@en , "diapause"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.515>
        a                skos:Concept ;
        dct:source       "ISO 26000:2010, 2.23, modified — The last sentence in Note 1 to entry has been removed."@en , "ISO 26000:2010, 2.23, modifié — La dernière phrase de la Note 1 à l’article a été supprimée."@fr ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.515> ;
        skos:definition  "développement qui répond aux besoins du présent sans compromettre la capacité des générations futures à répondre aux leurs"@fr , "development that meets the needs of the present without compromising the ability of future generations to meet their own needs"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.515" ;
        skos:note        "Note 1 à l’article: Le développement durable vise à combiner les attentes plus larges de la société en général en matière de haute qualité de vie, de santé et de prospérité avec celles de justice environnementale (3.146), tout en maintenant la capacité de la Terre à supporter la vie dans toute sa diversité. Ces objectifs sociaux, économiques et environnementaux sont interdépendants et il convient qu'ils se renforcent mutuellement."@fr , "Note 1 to entry: Sustainable development is about integrating the broader expectations of society as a whole of a high quality of life, health and prosperity with environmental justice (3.146) and maintaining Earth’s capacity to support life in all its diversity. These social, economic and environmental goals are interdependent and should be mutually reinforcing."@en ;
        skos:prefLabel   "développement durable"@fr , "sustainable development"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.491>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.491> ;
        skos:definition  "traitement combinant une stabilisation et une solidification en un processus à une ou deux étapes"@fr , "treatment combining stabilization and solidification in a single or two stage process"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.491" ;
        skos:note        "Note 1 to entry: See also stabilization (3.492) and solidification (3.481)."@en , "Note 2 to entry: Stabilization/solidification methods can change the physical state of a contaminated material (e.g. solidifying a contaminated sludge) and/or reduce the “availability” of contaminants (3.91) to potential targets through chemical stabilization and (usually) by containment within a solid, low permeability product."@en , "Note 2 à l’article: Les méthodes de stabilisation-solidification peuvent modifier l'état physique du matériau contaminé (en solidifiant, par exemple, une boue contaminé) et/ou réduire la «disponibilité» des contaminants (3.91) par rapport aux cibles potentielles, en stabilisant ces derniers par voie chimique et (généralement) en les enfermant au sein d'un produit solide à faible perméabilité."@fr , "Note 1 à l’article: Voir également stabilisation (3.492) et solidification (3.481)."@fr ;
        skos:prefLabel   "stabilization/solidification"@en , "stabilisation/solidification"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.304>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.304> ;
        skos:definition  "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.443\">site&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.443)</span></a></span> dont il n'est pas possible d'identifier le propriétaire ou le responsable de sa pollution"@fr , "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.443\">site <span class=\"sts-tbx-entailedTerm-num\">(3.443)</span></a></span> for which no owner or other responsible party for pollution can be identified"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.304" ;
        skos:prefLabel   "site orphelin"@fr , "orphan site"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.219>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.219> ;
        skos:definition  "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.70\">caractéristique&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.70)</span></a></span> unique qui représente un effet de la durabilité, que cet effet ait un impact bénéfique ou négatif, et qui peut être comparée dans le cadre de <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.383\">scénarios de gestion&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.383)</span></a></span>, envisageables sur un site donné, comprenant chacune une ou plusieurs techniques de <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.380\">dépollution&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.380)</span></a></span> et/ou des contrôles institutionnels, pour évaluer leurs performances relatives"@fr , "single <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.70\">characteristic <span class=\"sts-tbx-entailedTerm-num\">(3.70)</span></a></span> that represents a sustainability effect, whether benefit or negative impact, which may be compared across alternative <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.383\">remediation strategies <span class=\"sts-tbx-entailedTerm-num\">(3.383)</span></a></span>, comprising one or more <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.380\">remediation <span class=\"sts-tbx-entailedTerm-num\">(3.380)</span></a></span> techniques and/or institutional controls, to evaluate their relative performance"@en ;
        skos:example     "Émissions de gaz à effet de serre."@fr , "Greenhouse gas emissions."@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.219" ;
        skos:prefLabel   "indicateur"@fr , "indicator"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.49>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.49> ;
        skos:definition  "total mass of shoots, flowers and seed pods"@en , "ensemble de la masse des pousses, des fleurs et des gousses"@fr ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.49" ;
        skos:note        "Note 1 to entry: Biomass is expressed as dry mass per plant or, if needed, as dry mass per pot. During the test period, some of the test plants can reach different growth (3.194) stages and their water content can differ when the plants are harvested. Thus, the dry mass better represents the biomass produced during the growth period."@en , "Note 1 à l’article: La biomasse est exprimée en masse sèche par plante ou, si nécessaire, en masse sèche par pot. Au cours de la période d'essai, certaines plantes soumises à essai peuvent atteindre différents stades de croissance et leur teneur en eau peut avoir changé lors de leur récolte. La masse sèche représente donc mieux la biomasse produite durant la croissance."@fr ;
        skos:prefLabel   "biomass"@en , "biomasse"@fr ;
        <https://w3id.org/dpv#hasContext>
                "plants"@en , "plantes"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.280>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.280> ;
        skos:altLabel    "nested sampling"@en , "échantillonnage emboîté"@fr ;
        skos:definition  "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.410\">sampling <span class=\"sts-tbx-entailedTerm-num\">(3.410)</span></a></span> in which the <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">sample <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> is selected by stages, the sampling units at each stage being sampled from the larger sampling units chosen at the previous stage"@en , "type d'<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.410\">échantillonnage&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.410)</span></a></span> au cours duquel l'<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">échantillon&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> est prélevé par étapes successives, les unités d'échantillonnage étant à chaque étape échantillonnées à partir d'unités plus importantes choisies à l'étape précédente"@fr ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.280" ;
        skos:note        "Note 1 à l’article: Le premier ensemble de portions (unités ou prélèvements élémentaires (3.218)) prélevé dans la population (3.331) disponible pour l'échantillonnage constitue l'échantillon primaire (3.348). Les échantillons suivants (secondaires, tertiaires, etc.) sont les ensembles de sous-échantillons (3.503), d'unités, d'entités, d'individus (3.559) ou de prélèvements élémentaires obtenus à partir de l'étape précédente. Les unités peuvent être différentes selon les étapes de l'échantillonnage à plusieurs degrés."@fr , "Note 1 to entry: The first set of portions (units or increments (3.218)) taken from the population (3.331) available for sampling is the primary sample (3.348). The subsequent samples (secondary, tertiary, etc.) are the sets of subsamples (3.503), units, items, individuals (3.559), or increments taken from the preceding step. The units can be different at different steps of multistage sampling."@en ;
        skos:prefLabel   "échantillonnage à plusieurs degrés"@fr , "multi-stage sampling"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.195>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.195> ;
        skos:definition  "matériau, autre que les sols sur site, dans lequel les végétaux, les champignons et les bactéries sont cultivés"@fr , "material, other than soils in situ, in which plants, fungi and bacteria are grown"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.195" ;
        skos:prefLabel   "growth medium"@en , "milieu de croissance"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.461>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.461> ;
        skos:definition  "ratio of the dry mass of test soil to the dry mass of reference or <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.95\">control soil <span class=\"sts-tbx-entailedTerm-num\">(3.95)</span></a></span>"@en , "rapport de la masse sèche du sol soumis à essai à la masse sèche du sol de référence/<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.95\">sol témoin&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.95)</span></a></span>"@fr ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.461" ;
        skos:note        "Note 1 to entry: It is expressed as a percentage."@en , "Note 1 à l’article: Il est exprimé en pourcentage."@fr ;
        skos:prefLabel   "rapport de mélange de sols"@fr , "soil mixture ratio"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.376>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.376> ;
        skos:definition  "sol spécifique d'un site non contaminé (par exemple prélevé aux abords d'un <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.92\">site contaminé&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.92)</span></a></span>] et dont les propriétés (<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.86\">concentrations&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.86)</span></a></span> en éléments nutritifs, pH, teneur en <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.300\">carbone organique&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.300)</span></a></span>, texture, etc.) sont similaires à celles du sol soumis à essai"@fr , "uncontaminated site-specific soil (e.g. collected in the vicinity of a <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.92\">contaminated site <span class=\"sts-tbx-entailedTerm-num\">(3.92)</span></a></span>) with properties (nutrient <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.86\">concentrations <span class=\"sts-tbx-entailedTerm-num\">(3.86)</span></a></span>, pH, <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.300\">organic carbon <span class=\"sts-tbx-entailedTerm-num\">(3.300)</span></a></span> content and texture, etc.) similar to the test soil"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.376" ;
        skos:prefLabel   "sol de référence"@fr , "reference soil"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.19>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.19> ;
        skos:definition  "known amount of a <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.204\">homogeneous <span class=\"sts-tbx-entailedTerm-num\">(3.204)</span></a></span> material, assumed to be taken with negligible <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.413\">sampling error <span class=\"sts-tbx-entailedTerm-num\">(3.413)</span></a></span>"@en , "quantité connue de matériau <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.204\">homogène&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.204)</span></a></span>, prélevée avec une <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.413\">erreur d'échantillonnage&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.413)</span></a></span> supposée négligeable"@fr ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.19" ;
        skos:note        "Note 1 à l’article: Le terme s’applique généralement aux fluides."@fr , "Note 1 to entry: The term is usually applied to fluids."@en ;
        skos:prefLabel   "aliquot"@en , "aliquote"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.250>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.250> ;
        skos:definition  "réalisation, ou manière de réaliser ou d'enregistrer une <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.249\">coupe&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.249)</span></a></span>"@fr , "act or process of making or recording a <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.249\">log <span class=\"sts-tbx-entailedTerm-num\">(3.249)</span></a></span>"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.250" ;
        skos:prefLabel   "logging"@en , "réalisation d'une coupe"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.80>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.80> ;
        skos:altLabel    "diagnostic de performance"@fr , "performance control"@en ;
        skos:definition  "étude ou programme de contrôle, d'essais ou de <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.276\">surveillance&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.276)</span></a></span> effectué en continu pour vérifier qu’un <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.383\">scénario de gestion&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.383)</span></a></span> a été convenablement mis en œuvre (par exemple, élimination de tous les matériaux contaminés) et/ou, quand l'approche adoptée est celle du <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.90\">confinement&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.90)</span></a></span>, que les résultats sont maintenus au niveau prévu"@fr , "investigation or programme of ongoing inspection, testing, or <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.276\">monitoring <span class=\"sts-tbx-entailedTerm-num\">(3.276)</span></a></span> to confirm that a <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.383\">remediation strategy <span class=\"sts-tbx-entailedTerm-num\">(3.383)</span></a></span> has been properly implemented (e.g. all contaminated materials have been removed) and/or when a <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.90\">containment <span class=\"sts-tbx-entailedTerm-num\">(3.90)</span></a></span> approach has been adopted, that this continues to perform to the specified level"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.80" ;
        skos:prefLabel   "compliance control"@en , "diagnostic de conformité"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.165>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.165> ;
        skos:definition  "récipient préparé dans le laboratoire, utilisant comme réactif de l'eau ou toute autre matrice de blanc, et destiné à être emporté par le <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.403\">personnel d'échantillonnage&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.403)</span></a></span> en vue d’une <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.158\">exposition&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.158)</span></a></span> (<a class=\"sts-xref\" href=\"#iso:std:iso:11074:ed-3:v1:fr:sec:3.159\">3.159</a>) (<a class=\"sts-xref\" href=\"#iso:std:iso:11074:ed-3:v1:fr:sec:3.160\">3.160</a>) à l'environnement dans lequel l'échantillonnage est effectué afin de vérifier l'absence de <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.93\">contamination&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.93)</span></a></span> au cours de l'<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.410\">échantillonnage&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.410)</span></a></span>"@fr , "container prepared in the laboratory using reagent water or other blank matrix and sent with the <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.403\">sampling personnel <span class=\"sts-tbx-entailedTerm-num\">(3.403)</span></a></span> for <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.158\">exposure <span class=\"sts-tbx-entailedTerm-num\">(3.158)</span></a></span> (<a class=\"sts-xref\" href=\"#iso:std:iso:11074:ed-3:v1:en:sec:3.159\">3.159</a>) (<a class=\"sts-xref\" href=\"#iso:std:iso:11074:ed-3:v1:en:sec:3.160\">3.160</a>) to the sampling environment to verify possible <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.93\">contamination <span class=\"sts-tbx-entailedTerm-num\">(3.93)</span></a></span> during <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.410\">sampling <span class=\"sts-tbx-entailedTerm-num\">(3.410)</span></a></span>"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.165" ;
        skos:prefLabel   "blanc de terrain"@fr , "field blank"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.557>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.557> ;
        skos:definition  "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">échantillon&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> de sol obtenu sans perturber la <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.475\">structure du sol&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.475)</span></a></span> pendant la <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.419\">procédure d'échantillonnage&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.419)</span></a></span>"@fr , "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">sample <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> obtained from the ground with <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.475\">soil structure <span class=\"sts-tbx-entailedTerm-num\">(3.475)</span></a></span> unaltered during <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.419\">sampling procedure <span class=\"sts-tbx-entailedTerm-num\">(3.419)</span></a></span>"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.557" ;
        skos:note        "Note 1 to entry: Special sampling (3.410) equipment is used so that the soil (3.448) particles and voids cannot change from the distribution which exists in the ground before sampling (these can provide volume‑proportional or mass‑proportional results)."@en , "Note 1 à l’article: Un matériel d'échantillonnage (3.410) particulier est utilisé afin que les particules et les pores du sol (3.448) ne puissent pas varier par rapport à la répartition effective dans le sol avant l'échantillonnage (les résultats obtenus peuvent être proportionnels au volume ou proportionnels à la masse)."@fr ;
        skos:prefLabel   "undisturbed sample"@en , "échantillon non remanié"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.431>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.431> ;
        skos:definition  "detailed definition of technical activities required to achieve the <i>primary objective</i>(<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.347\">s) <span class=\"sts-tbx-entailedTerm-num\">(3.347)</span></a></span> of the investigation"@en , "définition détaillée des activités techniques requises pour atteindre le ou les <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.347\">objectifs principaux&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.347)</span></a></span> de l'investigation"@fr ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.431" ;
        skos:note        "Note 1 à l’article: Les objectifs secondaires traitent de questions telles que la population devant faire l'objet d'un échantillonnage, les composants et le paramètre statistique à déterminer, l'échelle d'échantillonnage (3.410), la fidélité et la confiance souhaitées."@fr , "Note 1 to entry: The secondary objectives address items such as the population to be sampled, the components to be determined, the statistical parameter to be determined, the scale of sampling (3.410), and the desired precision and confidence."@en ;
        skos:prefLabel   "secondary objective"@en , "objectif secondaire"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.346>
        a                skos:Concept ;
        dct:source       "ISO 6107‑6:1986, modifié — Les mots «ou altération» ont été ajoutés."@fr , "ISO 6107:2021, 3.435, modified — “or alteration” was added."@en ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.346> ;
        skos:definition  "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.116\">dégradation&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.116)</span></a></span> ou altération de la structure moléculaire d'une substance à un stade suffisamment avancé pour en éliminer une propriété caractéristique"@fr , "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.116\">degradation <span class=\"sts-tbx-entailedTerm-num\">(3.116)</span></a></span> or alteration of the molecular structure of a substance to an extent sufficient to remove some characteristic property"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.346" ;
        skos:prefLabel   "primary degradation"@en , "dégradation primaire"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.220>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.220> ;
        skos:definition  "composé choisi pour décrire les propriétés, principalement la toxicité, d'un mélange pétrolier ou d'une <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.172\">fraction&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.172)</span></a></span>"@fr , "compound chosen to describe properties, primarily toxicity, of a petroleum mixture or <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.172\">fraction <span class=\"sts-tbx-entailedTerm-num\">(3.172)</span></a></span>"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.220" ;
        skos:prefLabel   "composé indicateur"@fr , "indicator compound"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.50>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.50> ;
        skos:definition  "equipment in which biotreatment is applied to a solid, liquid, or slurry"@en , "installation dans laquelle un traitement biologique est appliqué à un solide, à un liquide ou à une phase hétérogène"@fr ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.50" ;
        skos:prefLabel   "bioreactor"@en , "bioréacteur"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.135>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.135> ;
        skos:definition  "process of removing the <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.479\">soil water <span class=\"sts-tbx-entailedTerm-num\">(3.479)</span></a></span> from a <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">sample <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span>"@en , "procédé consistant à éliminer l'<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.479\">eau du sol&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.479)</span></a></span> présente dans un <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">échantillon&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span>"@fr ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.135" ;
        skos:note        "Note 1 à l’article: En analyse du sol, les quatre types de séchage suivants peuvent s'appliquer: — séchage à l’air; — séchage en étuve; — séchage chimique; — lyophilisation."@fr , "Note 1 to entry: In soil analysis, the following four kinds of drying may be applied: — air drying; — oven drying; — chemical drying; — freeze drying."@en ;
        skos:prefLabel   "drying"@en , "séchage"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.527>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.527> ;
        skos:altLabel    "prise d'essai pour analyse"@fr , "analytical portion"@en ;
        skos:definition  "quantité de matériau, prélevée dans l'<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.528\">échantillon pour essai&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.528)</span></a></span>, suffisante pour permettre la mesure de la <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.86\">concentration&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.86)</span></a></span> ou de toute autre propriété étudiée"@fr , "quantity of material, of proper size, for measurement of the <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.86\">concentration <span class=\"sts-tbx-entailedTerm-num\">(3.86)</span></a></span> or other property of interest, removed from the <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.528\">test sample <span class=\"sts-tbx-entailedTerm-num\">(3.528)</span></a></span>"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.527" ;
        skos:note        "Note 2 à l’article: Une unité ou un prélèvement élémentaire (3.218) suffisamment homogène et pur(e), de taille appropriée et ne nécessitant aucune autre préparation peut être considéré(e) comme prise d'essai."@fr , "Note 2 to entry: A unit or increment (3.218) of proper homogeneity, size, and fineness, needing no further preparation, can be a test portion."@en , "Note 1 à l’article: Si, en l'absence de toute préparation, la prise d'essai peut être prélevée dans l'échantillon primaire (3.348) ou directement dans l'échantillon pour laboratoire (3.236) (par exemple dans le cas de liquides), elle est généralement prélevée dans l'échantillon préparé pour essai."@fr , "Note 1 to entry: The test portion can be taken from the primary sample (3.348) or from the laboratory sample (3.236) directly if no preparation of sample is required (e.g. with liquids), but it is usually taken from the prepared test sample."@en ;
        skos:prefLabel   "prise d'essai"@fr , "test portion"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.401>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.401> ;
        skos:definition  "procédure visant à stabiliser un <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">échantillon&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span>, c'est-à-dire à stabiliser les propriétés à étudier, depuis l'étape du prélèvement jusqu'à celle de la préparation pour analyse"@fr , "procedure used to stabilize a <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">sample <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> in such a way that the properties under examination are maintained stable from the collection step until preparation for analysis"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.401" ;
        skos:prefLabel   "conservation d'un échantillon"@fr , "sample preservation"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.316>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.316> ;
        skos:definition  "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.86\">concentration&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.86)</span></a></span> d'une substance présente dans un sol du fait de processus géologiques et pédologiques naturels, à l'exception des substances d'origine anthropique introduites dans les sols"@fr , "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.86\">concentration <span class=\"sts-tbx-entailedTerm-num\">(3.86)</span></a></span> of a substance in a soil resulting from natural geological and pedological processes, excluding any addition of anthropogenic origin"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.316" ;
        skos:note        "Note 1 to entry: It is difficult to determine the precise pedo-geochemical concentration of certain substances in soil due to the presence of anthropogenic diffuse contamination (3.93)."@en , "Note 1 à l’article: Il est difficile de déterminer avec précision la concentration pédo-géochimique de certaines substances dans un sol en raison de la présence d'une contamination (3.93) anthropique diffuse."@fr ;
        skos:prefLabel   "concentration pédo-géochimique"@fr , "pedo-geochemical concentration"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.20>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.20> ;
        skos:definition  "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.116\">dégradation&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.116)</span></a></span> microbienne de l'azote organique en ammoniaque"@fr , "microbial <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.116\">degradation <span class=\"sts-tbx-entailedTerm-num\">(3.116)</span></a></span> of organic nitrogen to ammonia"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.20" ;
        skos:prefLabel   "ammonification"@fr , "ammonification"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.105>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.105> ;
        skos:definition  "résultat indésirable provenant: <div class=\"list\"> <ul style=\"list-style-type: none\">  <li>   <div class=\"sts-p\" style=\"text-indent:5px\">    <span class=\"sts-label\">—</span> du <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.272\">mélange  <span class=\"sts-tbx-entailedTerm-num\">(3.272)</span></a></span> accidentel de <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.459\">matériaux  <span class=\"sts-tbx-entailedTerm-num\">(3.459)</span></a></span> provenant de différents horizons/couches de sol, lors du prélèvement de l'<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">échantillon  <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span>;   </div></li>  <li>   <div class=\"sts-p\" style=\"text-indent:5px\">    <span class=\"sts-label\">—</span> de l'adjonction de substances chimiques dans un échantillon de sol par les <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.412\">dispositifs d'échantillonnage  <span class=\"sts-tbx-entailedTerm-num\">(3.412)</span></a></span>, les conteneurs, les réactifs de conservation, les conditions de transport ou les moyens de préparation, ainsi qu'au cours de l'analyse   </div></li> </ul></div>"@fr , "undesired result due to: <div class=\"list\"> <ul style=\"list-style-type: none\">  <li>   <div class=\"sts-p\" style=\"text-indent:5px\">    <span class=\"sts-label\">—</span> collection of a <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">sample <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> with uncontrolled <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.272\">mixing <span class=\"sts-tbx-entailedTerm-num\">(3.272)</span></a></span> of <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.459\">soil material <span class=\"sts-tbx-entailedTerm-num\">(3.459)</span></a></span> from different soil horizons/layers;   </div></li>  <li>   <div class=\"sts-p\" style=\"text-indent:5px\">    <span class=\"sts-label\">—</span> addition of chemical substances to a soil sample from <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.412\">sampling devices <span class=\"sts-tbx-entailedTerm-num\">(3.412)</span></a></span>, containers, reagents of preservation, by transport conditions, means of preparation, and during analytical processing   </div></li> </ul></div>"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.105" ;
        skos:prefLabel   "contamination croisée"@fr , "cross contamination"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.292>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.292> ;
        skos:definition  "apport d’une substance par toute <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.484\">source&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.484)</span></a></span> autre qu'une source ponctuelle"@fr , "input of a substance from a <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.484\">source <span class=\"sts-tbx-entailedTerm-num\">(3.484)</span></a></span> other than a point source"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.292" ;
        skos:note        "Note 1 à l’article: Voir apport dû à une source diffuse (3.124)."@fr , "Note 1 to entry: See diffuse source input (3.124)."@en ;
        skos:prefLabel   "non-point source input"@en , "apport dû à une source non ponctuelle"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.473>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.473> ;
