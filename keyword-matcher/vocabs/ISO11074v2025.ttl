        skos:definition  "qualité d'eau produite, par exemple, par monodistillation, déionisation, ultra-filtration ou osmose inverse"@fr , "grade of water, produced, for example, by single distillation, by de-ionization, by ultra-filtration or by reverse osmosis"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.358" ;
        skos:prefLabel   "pure water"@en , "eau pure"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.232>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.232> ;
        skos:definition  "personne, groupe et/ou institution impliqués dans le processus (itératif) de définition et d'exécution du <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.420\">programme d'échantillonnage&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.420)</span></a></span>"@fr , "individual, group, and/or institution involved in the (iterative) process of defining and executing the <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.420\">sampling programme <span class=\"sts-tbx-entailedTerm-num\">(3.420)</span></a></span>"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.232" ;
        skos:prefLabel   "involved party"@en , "partie impliquée"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.62>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.62> ;
        skos:definition  "ratio of the mass of a quantity of material (or one phase) and the total volume occupied by this material (including other phases)"@en , "rapport de la masse d'une quantité de matériau (ou d'une phase) et du volume total occupé par ce matériau (comprenant d'autres phases)"@fr ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.62" ;
        skos:note        "Note 1 à l’article: Il s'agit en toute rigueur de la masse volumique mais le terme communément usité est «densité». La valeur numérique est identique ou divisée par la masse volumique de l'eau (1 t ∙ m−3) à 4 °C."@fr , "Note 1 to entry: This is typically a volumetric mass, but it is commonly named as “density”. The numerical values are identical or divided by the volumetric mass of water (1 t ∙ m−3) at 4 °C."@en ;
        skos:prefLabel   "bulk density"@en , "masse volumique"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.147>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.147> ;
        skos:definition  "sol, matériaux sous-jacents, <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.433\">sédiments&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.433)</span></a></span>, eau de surface, <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.191\">eaux souterraines&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.191)</span></a></span>, <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.454\">gaz du sol&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.454)</span></a></span> et air pouvant contenir des <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.91\">contaminants&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.91)</span></a></span>"@fr , "soil, underlying material, <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.433\">sediments <span class=\"sts-tbx-entailedTerm-num\">(3.433)</span></a></span>, surface water, <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.191\">groundwater <span class=\"sts-tbx-entailedTerm-num\">(3.191)</span></a></span>, <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.454\">soil gas <span class=\"sts-tbx-entailedTerm-num\">(3.454)</span></a></span>, and air that can contain <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.91\">contaminants <span class=\"sts-tbx-entailedTerm-num\">(3.91)</span></a></span>"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.147" ;
        skos:prefLabel   "environmental medium"@en , "environmental medium"@fr ;
        <https://w3id.org/dpv#hasContext>
                "contaminated sites"@en , "sites contaminés"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.539>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.539> ;
        skos:altLabel    "COT"@fr , "TOC"@en ;
        skos:definition  "all carbon present in <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.301\">organic matter <span class=\"sts-tbx-entailedTerm-num\">(3.301)</span></a></span>"@en , "ensemble du carbone présent dans la <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.301\">matière organique&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.301)</span></a></span>"@fr ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.539" ;
        skos:prefLabel   "carbone organique total"@fr , "total organic carbon"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.413>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.413> ;
        skos:definition  "partie de l'erreur totale (écart entre l'estimation à partir d'un <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">échantillon&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> et la valeur réelle de la <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.331\">population&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.331)</span></a></span>) associée à l'extrapolation, à l'ensemble d'une population, des résultats d'une étude portant sur une petite fraction de la population; à ne pas confondre avec une erreur d'analyse ou une erreur d'essai"@fr , "part of the total error (the estimate from a <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">sample <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> minus the <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.331\">population <span class=\"sts-tbx-entailedTerm-num\">(3.331)</span></a></span> value) associated with using only a fraction of the population and extrapolating to the whole, as distinct from analytical or test error"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.413" ;
        skos:note        "Note 1 to entry: It arises from a lack of homogeneity in the investigated population."@en , "Note 1 à l’article: Elle est due à un manque d'homogénéité de la population étudiée."@fr ;
        skos:prefLabel   "sampling error"@en , "erreur d'échantillonnage"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.328>
        a                skos:Concept ;
        <http://www.loc.gov/mads/rdf/v1#deprecatedLabel>
                "contaminant"@fr ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.328> ;
        skos:definition  "substance ou agent présent(e) dans un <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.147\">milieu environnemental  <span class=\"sts-tbx-entailedTerm-num\">(3.147)</span></a></span> et qui, du fait de ses propriétés, de sa quantité ou de sa <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.86\">concentration  <span class=\"sts-tbx-entailedTerm-num\">(3.86)</span></a></span>, a des effets préjudiciables sur ledit milieu"@fr , "substance or agent present in an <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.147\">environmental medium <span class=\"sts-tbx-entailedTerm-num\">(3.147)</span></a></span>, which, due to its properties, amount or <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.86\">concentration <span class=\"sts-tbx-entailedTerm-num\">(3.86)</span></a></span>, causes adverse impacts on the environmental medium"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.328" ;
        skos:note        "Note 1 à l’article: Le terme «contaminant» est utilisé en anglais"@fr ;
        skos:prefLabel   "pollutant"@en , "polluant"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.202>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.202> ;
        skos:definition  "substance qui, en raison de ses propriétés, de sa quantité ou de sa <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.86\">concentration&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.86)</span></a></span>, a un effet préjudiciable sur les <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.453\">fonctions du sol&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.453)</span></a></span> et sur son utilisation"@fr , "substance which, because of its properties, quantity or <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.86\">concentration <span class=\"sts-tbx-entailedTerm-num\">(3.86)</span></a></span>, has an adverse effect on <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.453\">soil functions <span class=\"sts-tbx-entailedTerm-num\">(3.453)</span></a></span> and soil utilization"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.202" ;
        skos:prefLabel   "hazardous substance"@en , "substance dangereuse"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.32>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.32> ;
        skos:definition  "criteria set up to help decide if a <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.443\">site <span class=\"sts-tbx-entailedTerm-num\">(3.443)</span></a></span> requires further investigation or other action (e.g.&nbsp;<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.380\">remediation <span class=\"sts-tbx-entailedTerm-num\">(3.380)</span></a></span>)"@en , "critères établis pour aider à décider si un <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.443\">site&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.443)</span></a></span> nécessite une étude supplémentaire ou une autre action (par exemple <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.380\">dépollution&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.380)</span></a></span>)"@fr ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.32" ;
        skos:note        "Note 2 à l’article: Dans le cas de l'appréciation du risque (3.395), les critères d'évaluation sont souvent des valeurs seuils (3.534) relatives aux doses (3.131) ou aux concentrations (3.86) de milieux, telles que, par exemple, l'absorption quotidienne admissible ou les concentrations admissibles dans l'air, dans l'eau et dans le sol, fixées par les autorités internationales, nationales ou locales."@fr , "Note 2 to entry: For risk assessments (3.395), assessment criteria are often threshold (3.534) values for doses (3.131) or media concentrations (3.86), such as tolerable daily intake, tolerable air, water, and soil concentrations set by international, national, or local authorities."@en , "Note 1 à l’article: Les critères d'évaluation facilitent l'interprétation des résultats d'une appréciation quantitative du risque (3.393) ou d'un autre type d'évaluation."@fr , "Note 1 to entry: The assessment criteria aid in interpreting the results of a quantitative risk (3.393) or other assessment."@en ;
        skos:prefLabel   "assessment criteria"@en , "critères d'évaluation"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.117>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.117> ;
        skos:definition  "soil whose natural properties and <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.453\">soil functions <span class=\"sts-tbx-entailedTerm-num\">(3.453)</span></a></span> have been damaged by physical, chemical and/or biological processes"@en , "sol dont les propriétés naturelles et les <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.453\">fonctions&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.453)</span></a></span> ont été dégradées par des processus physiques, chimiques et/ou biologiques"@fr ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.117" ;
        skos:note        "Note 1 à l’article: Un sol peut être dégradé à la suite d’une contamination (3.93)."@fr , "Note 1 to entry: A soil can be degraded as a result of contamination (3.93)."@en ;
        skos:prefLabel   "sol dégradé"@fr , "degraded soil"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.509>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.509> ;
        skos:definition  "migration d'une substance du <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.448\">sol&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.448)</span></a></span> vers un autre compartiment de l'environnement"@fr , "movement of a substance from the <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.448\">soil <span class=\"sts-tbx-entailedTerm-num\">(3.448)</span></a></span> into another environmental compartment"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.509" ;
        skos:prefLabel   "substance output"@en , "exportation de substance"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.570>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.570> ;
        skos:definition  "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">échantillon&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> dont les résultats d'analyse sont exprimés, pour l'évaluation, en masse par unité de volume"@fr , "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">sample <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> whose analytical results are expressed for evaluation on the basis of mass per volume"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.570" ;
        skos:prefLabel   "volumetric sample"@en , "échantillon volumétrique"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.485>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.485> ;
        skos:definition  "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.83\">composite sample <span class=\"sts-tbx-entailedTerm-num\">(3.83)</span></a></span> (<a class=\"sts-xref\" href=\"#iso:std:iso:11074:ed-3:v1:en:sec:3.84\">3.84</a>) formed from small incremental point <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">samples <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> taken over an area (such as a field)"@en , "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.83\">échantillon composite&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.83)</span></a></span>&nbsp;(<a class=\"sts-xref\" href=\"#iso:std:iso:11074:ed-3:v1:fr:sec:3.84\">3.84</a>) constitué de petits <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">prélèvements élémentaires&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> effectués sur une zone (par exemple un terrain)"@fr ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.485" ;
        skos:note        "Note 1 to entry: The general premise is that the distribution of soil (3.448) constituents is relatively homogeneous (3.204). The increments (3.218) may be located according to a regular grid, random, or other pattern. In agricultural/horticultural land investigations “N”, “S”, “W” and “X” sampling patterns (3.416) are commonly used. Along the outline of such a pattern, a number of samples or increments are taken which are bulked and mixed to provide one (composite) sample for analysis."@en , "Note 1 à l’article: Le postulat de base est que la répartition des constituants du sol (3.448) est relativement homogène (3.204). La localisation des prélèvements élémentaires (3.218) peut correspondre à une grille régulière, être aléatoire ou suivre un autre schéma. Dans les études de terrains agricoles/horticoles, des grilles d'échantillonnage (3.416) en «N», en «S», en «W» ou en «X» sont couramment utilisées. Un certain nombre d'échantillons ou de prélèvements élémentaires sont collectés le long du tracé d'une grille de ce type et sont homogénéisés et mélangés pour obtenir un échantillon (composite) à des fins d'analyse."@fr ;
        skos:prefLabel   "échantillon composite spatial"@fr , "spatial composite sample"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.274>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.274> ;
        skos:definition  "passage de substances ou de particules du sol vers une forme mobile"@fr , "conversion of substances or soil particles into a mobile form"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.274" ;
        skos:prefLabel   "mobilisation"@fr , "mobilization"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.540>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.540> ;
        skos:definition  "expression, définie selon une méthode, de la quantité totale d'<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.323\">hydrocarbures pétroliers&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.323)</span></a></span> présents dans le <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.448\">sol&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.448)</span></a></span>"@fr , "method-defined expression of the total amount of <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.323\">petroleum hydrocarbons <span class=\"sts-tbx-entailedTerm-num\">(3.323)</span></a></span> in the <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.448\">soil <span class=\"sts-tbx-entailedTerm-num\">(3.448)</span></a></span>"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.540" ;
        skos:note        "Note 1 à l’article: L'expression utilisée est: «hydrocarbures pétroliers totaux, déterminés par (méthode)»."@fr , "Note 3 à l’article: Le terme «hydrocarbures pétroliers totaux» (HPT) est utilisé pour décrire une vaste famille de plusieurs centaines de composés chimiques dérivés à l'origine du pétrole brut. La quantification analytique des HPT passe par leur division en groupes d'hydrocarbures pétroliers ayant un comportement similaire dans le sol ou dans l'eau (fractions (3.172) d'hydrocarbures de pétrole); chaque fraction peut comprendre un grand nombre de substances chimiques différentes."@fr , "Note 3 to entry: Total petroleum hydrocarbons (TPH) is a term used to describe a large family of several hundred chemical compounds that originally come from crude oil. For analytical quantification, TPH is divided into groups of petroleum hydrocarbons that act alike in soil or water (petroleum hydrocarbon fractions (3.172)), and each fraction contains many individual chemicals."@en , "Note 2 to entry: The value depends on the analytical method used to measure it."@en , "Note 1 to entry: Expressed as “total petroleum hydrocarbons determined by (method)”."@en , "Note 2 à l’article: La valeur varie en fonction de la méthode d'analyse utilisée pour la mesurer."@fr ;
        skos:prefLabel   "hydrocarbures pétroliers totaux"@fr , "total petroleum hydrocarbons"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.189>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.189> ;
        skos:definition  "matériau textile perméable tissé, non tissé ou maillé, utilisé en génie civil et activités connexes, généralement constitué de matériaux synthétiques (tels que le polypropylène), mais pouvant également être constitué de matériaux naturels"@fr , "woven, non-woven, or knitted permeable textile used in civil engineering and related activities, usually made from synthetic materials (such as polypropylene) but that can also be made from natural materials"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.189" ;
        skos:prefLabel   "geotextile"@en , "géotextile"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.455>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.455> ;
        skos:altLabel    "soil gas monitoring installation"@en , "installation de surveillance des gaz du sol"@fr ;
        skos:definition  "dispositif permanent ou temporaire utilisé pour l'<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.410\">échantillonnage&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.410)</span></a></span> des <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.454\">gaz du sol&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.454)</span></a></span>"@fr , "permanent or temporary device used for <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.454\">soil gas <span class=\"sts-tbx-entailedTerm-num\">(3.454)</span></a></span><span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.410\">sampling <span class=\"sts-tbx-entailedTerm-num\">(3.410)</span></a></span>"@en ;
        skos:example     "Sonde de gaz (3.456) du sol sous dalle."@fr , "Sub-slab, soil gas probe (3.456)."@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.455" ;
        skos:prefLabel   "soil gas monitoring device"@en , "dispositif de surveillance des gaz du sol"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025>
        a                               reg:Register , ldp:Container , skos:ConceptScheme ;
        dct:modified                    "2025-04-24T05:56:06.741Z"^^xsd:dateTime ;
        reg:category                    <https://data.geoscience.earth/ncl/structure/Category/5> ;
        reg:inverseMembershipPredicate  skos:inScheme ;
        reg:owner                       <https://data.geoscience.earth/ncl/structure/Owner/4> ;
        owl:sameAs                      <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en> ;
        owl:versionInfo                 4 ;
        skos:definition                 "This document defines soil quality terms. The previous editions (ISO 11074:2015 and ISO 11074/Amd 1:2020) presented terms and definitions in separate clauses to differentiate the terms about e.g. sampling, remediation. This became more and more artificial, since soil quality experts with different expertise need to work closely together and there is a greater need for one term list instead of multiple ones, where experts first need to find out in which clause a specific term is located. In this edition, all the terms are included in Clause 3. For some terms, there are different definitions, depending on the context. These terms are presented after each other, with the differentiating domains between brackets: <context>. Often these are a general domain and a specific domain, resulting in different definitions. Though the terms apply to all other ISO/TC 190 soil quality standards, this document does not cover all the terms used in ISO/TC 190 soil quality standards. New and revised standards are published continuously though time. The revision periods of soil quality standards differ. That means that definitions of the same terms can be different in specific soil quality standard and in this document."@en , "Le présent document définit les termes relatifs à la qualité du sol. Les éditions précédentes (ISO 11074:2015 et ISO 11074/Amd 1:2020) présentaient les termes et les définitions au sein d'articles distincts afin d'établir différentes catégories de termes ayant trait à l'échantillonnage ou à la dépollution, par exemple. Cette distinction est devenue de plus en plus artificielle dans la mesure où une collaboration étroite entre experts de la qualité du sol, aux domaines de compétence variés, s'avère nécessaire; une liste unique de termes devient de ce fait incontournable pour remplacer les subdivisions qui obligent les experts à rechercher d'abord dans quel article se trouve un terme spécifique. Dans la présente édition, tous les termes sont inclus dans l’Article 3. Certains termes ont des définitions différentes en fonction du contexte. Ils sont présentés les uns à la suite des autres, leurs domaines respectifs étant indiqués entre crochets angulaires: <contexte>. Il s'agit dans la plupart des cas d'un domaine général et d'un domaine spécifique, donnant lieu à des définitions différentes. Bien que ces termes s'appliquent à toutes les autres normes relevant de l'ISO/TC 190, Qualité du sol, le présent document ne couvre pas la totalité des termes utilisés dans les normes sur la qualité du sol relevant de l'ISO/TC 190. La publication de nouvelles normes et de normes révisées est continuelle. Les périodes de révision des normes relatives à la qualité du sol sont différées, ce qui signifie que les définitions de termes identiques peuvent présenter des différences dans une norme spécifique sur la qualité du sol et dans le présent document."@fr ;
        skos:notation                   "ISO11074v2025" ;
        skos:note                       "For general terms relating to quality, see ISO 9000."@en , "Pour les termes généraux relatifs à la qualité, voir l’ISO 9000."@fr ;
        skos:prefLabel                  "ISO 11074:2025, Qualité du sol — Vocabulaire"@fr , "ISO 11074:2025, Soil quality — Vocabulary"@en ;
        ldp:isMemberOfRelation          skos:inScheme .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.244>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.244> ;
        skos:altLabel    "CLx"@fr , "LCx"@en ;
        skos:definition  "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.86\">concentration&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.86)</span></a></span> d'une <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.530\">substance d'essai&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.530)</span></a></span> ou pourcentage de dilution du sol contaminé qui provoque la mort de <i>x</i>&nbsp;% des organismes d'essai pendant la période d'expérimentation"@fr , "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.86\">concentration <span class=\"sts-tbx-entailedTerm-num\">(3.86)</span></a></span> of a <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.530\">test substance <span class=\"sts-tbx-entailedTerm-num\">(3.530)</span></a></span> or percent dilution of contaminated soil, which kills <i>x</i>&nbsp;% of the test organisms within the test period"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.244" ;
        skos:note        "Note 1 à l’article: x correspond au pourcentage (10, 20, 25, 50) de cet effet."@fr , "Note 1 to entry: x is the percentage (10, 20, 25, 50) of this effect."@en ;
        skos:prefLabel   "lethal concentration x"@en , "concentration létale x"@fr ;
        <https://w3id.org/dpv#hasContext>
                "fauna"@en , "faune"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.74>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.74> ;
        skos:definition  "fraction de particules du sol de granulométrie inférieure à 2&nbsp;µm"@fr , "proportion of soil particles with a particle size &lt;&nbsp;2&nbsp;µm"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.74" ;
        skos:prefLabel   "clay content"@en , "teneur en argile"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.510>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.510> ;
        skos:altLabel    "SIR"@en , "SIR (de l’anglais «substrate-induced respiration»)"@fr ;
        skos:definition  "respiration microbienne du <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.448\">sol&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.448)</span></a></span> après ajout de nutriments"@fr , "microbial <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.448\">soil <span class=\"sts-tbx-entailedTerm-num\">(3.448)</span></a></span> respiration after addition of nutrients"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.510" ;
        skos:note        "Note 1 à l’article: Le glucose est un exemple de nutriment ajouté."@fr , "Note 1 to entry: Glucose is an example of an added nutrient."@en ;
        skos:prefLabel   "substrate-induced respiration"@en , "respiration induite par le substrat"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.159>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.159> ;
        skos:definition  "taux ou <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.86\">concentration&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.86)</span></a></span> d'une substance ou d'un agent atteignant un <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.370\">récepteur&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.370)</span></a></span> ou une partie définie d'un récepteur par des <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.162\">voies d'exposition&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.162)</span></a></span> spécifiées ou à la suite de certains événements"@fr , "rate or <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.86\">concentration <span class=\"sts-tbx-entailedTerm-num\">(3.86)</span></a></span> of a substance or agent reaching a <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.370\">receptor <span class=\"sts-tbx-entailedTerm-num\">(3.370)</span></a></span> or defined part of a receptor via specified <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.162\">exposure pathways <span class=\"sts-tbx-entailedTerm-num\">(3.162)</span></a></span> or subsequent on certain events"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.159" ;
        skos:prefLabel   "exposure"@en , "exposition"@fr ;
        <https://w3id.org/dpv#hasContext>
                "appréciation du risque, général"@fr , "risk assessment, general"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.425>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.425> ;
        skos:definition  "ensemble de modes opératoires et de <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.412\">dispositifs d'échantillonnage&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.412)</span></a></span> appropriés permettant d'obtenir et de décrire des <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">échantillons&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> de sol ou de <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.459\">matériau du sol&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.459)</span></a></span>, que ce soit sur le terrain, au cours du transport ou en laboratoire"@fr , "appropriate procedures and <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.412\">sampling devices <span class=\"sts-tbx-entailedTerm-num\">(3.412)</span></a></span> to obtain and describe <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">samples <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> of soil or <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.459\">soil material <span class=\"sts-tbx-entailedTerm-num\">(3.459)</span></a></span>, either in the field or during transportation and in laboratory"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.425" ;
        skos:note        "Note 1 to entry: The manner of selection of the sampling technique should be described in the sampling plan (3.417)."@en , "Note 1 à l’article: Il convient que le plan d'échantillonnage (3.417) comporte une description de la méthode de sélection de la technique d’échantillonnage."@fr ;
        skos:prefLabel   "technique d'échantillonnage"@fr , "sampling technique"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.9>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.9> ;
        skos:definition  "action conçue, par exemple, pour maîtriser le transfert des <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.191\">eaux souterraines&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.191)</span></a></span> ou le <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.178\">transfert des gaz&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.178)</span></a></span>"@fr , "process designed, for example, to control <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.191\">groundwater <span class=\"sts-tbx-entailedTerm-num\">(3.191)</span></a></span> migration or <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.178\">gas migration <span class=\"sts-tbx-entailedTerm-num\">(3.178)</span></a></span>"@en ;
        skos:example     "Pumped water extraction or gas extraction system."@en , "Systèmes d'extraction d'eau ou de gaz par pompage."@fr ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.9" ;
        skos:prefLabel   "mesure de protection active"@fr , "active protective measure"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.214>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.214> ;
        skos:definition  "measure required to counteract immediate threats to human health or the environment"@en , "mesure requise pour contrer une menace immédiate pesant sur la santé humaine ou l'environnement"@fr ;
        skos:example     "Clôturage, élimination des dépôts superficiels, barrage de protection des eaux de surface."@fr , "Fencing, removal of surface deposits, bunding to protect surface waters."@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.214" ;
        skos:prefLabel   "mesure d'urgence"@fr , "immediate measure"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.44>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.44> ;
        skos:definition  "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.116\">dégradation&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.116)</span></a></span> moléculaire d'une substance organique résultant des actions complexes d'organismes vivants"@fr , "molecular <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.116\">degradation <span class=\"sts-tbx-entailedTerm-num\">(3.116)</span></a></span> of an organic substance resulting from the complex actions of living organisms"@en ;
