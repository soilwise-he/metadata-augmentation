<https://data.geoscience.earth/ncl/ISO11074v2025/3.160>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.160> ;
        skos:definition  "rate or <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.86\">concentration <span class=\"sts-tbx-entailedTerm-num\">(3.86)</span></a></span> of a substance or agent reaching a body or a defined organ via specified <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.162\">exposure pathways <span class=\"sts-tbx-entailedTerm-num\">(3.162)</span></a></span>"@en , "taux ou <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.86\">concentration&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.86)</span></a></span> d'une substance ou d'un agent atteignant le corps ou un organe déterminé par des <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.162\">voies d'exposition&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.162)</span></a></span> spécifiées"@fr ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
