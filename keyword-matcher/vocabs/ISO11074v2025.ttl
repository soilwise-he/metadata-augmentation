<https://data.geoscience.earth/ncl/ISO11074v2025/3.164>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.164> ;
        skos:definition  "quantité d'un élément extraite dans des conditions définies, par exemple, au moyen d'un agent complexant, de solutions salines ou d'eau, utilisée pour reproduire différents types de <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.41\">biodisponibilité&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.41)</span></a></span> (<a class=\"sts-xref\" href=\"#iso:std:iso:11074:ed-3:v1:fr:sec:3.42\">3.42</a>), incluant l'absorption par les plantes ou les <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.162\">voies d'exposition&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.162)</span></a></span>, en rapport avec la <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.86\">concentration&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.86)</span></a></span> d'une substance dans l'<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.333\">eau interstitielle&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.333)</span></a></span>"@fr , "amount of an element extracted under defined conditions, e.g. with a complexing agent, salt solutions, or water used to mimic different kinds of <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.41\">bioavailability <span class=\"sts-tbx-entailedTerm-num\">(3.41)</span></a></span> (<a class=\"sts-xref\" href=\"#iso:std:iso:11074:ed-3:v1:en:sec:3.42\">3.42</a>) including plant uptake or <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.162\">exposure routes <span class=\"sts-tbx-entailedTerm-num\">(3.162)</span></a></span> related to the <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.333\">pore water <span class=\"sts-tbx-entailedTerm-num\">(3.333)</span></a></span><span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.86\">concentration <span class=\"sts-tbx-entailedTerm-num\">(3.86)</span></a></span> of a substance"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.164" ;
        skos:prefLabel   "extractable fraction"@en , "fraction extractible"@fr .

