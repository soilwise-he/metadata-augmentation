<https://data.geoscience.earth/ncl/ISO11074v2025/3.199>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.199> ;
        skos:definition  "condition in which the application of a <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.459\">soil material <span class=\"sts-tbx-entailedTerm-num\">(3.459)</span></a></span> does not result in damage, as defined by specific criteria, to the functions of the soil already at the <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.522\">target site <span class=\"sts-tbx-entailedTerm-num\">(3.522)</span></a></span>"@en , "état selon lequel l'application d'un <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.459\">matériau du sol&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.459)</span></a></span> n'entraîne pas une dégradation, telle que définie par des critères spécifiques, des fonctions du sol déjà présent au niveau du <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.522\">site cible&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.522)</span></a></span>"@fr ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.199" ;
        skos:prefLabel   "harmlessness"@en , "innocuité"@fr ;
        <https://w3id.org/dpv#hasContext>
                "application des matériaux du sol"@fr , "application of soil materials"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.465>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.465> ;
        skos:definition  "capacité d'un sol à fournir un rendement dans les conditions du moment considéré"@fr , "ability of a soil to produce yields under current conditions"@en ;
