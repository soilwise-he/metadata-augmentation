<https://data.geoscience.earth/ncl/ISO11074v2025/3.474>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.474> ;
        skos:definition  "collection systématique ou permanente et stockage à long terme d'<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">échantillons  <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> de sol représentatifs pour <div class=\"list\"> <ul style=\"list-style-type: none\">  <li>   <div class=\"sts-p\" style=\"text-indent:5px\">    <span class=\"sts-label\">—</span> la documentation de l'état du matériau à la date de l'<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.410\">échantillonnage  <span class=\"sts-tbx-entailedTerm-num\">(3.410)</span></a></span>;   </div></li>  <li>   <div class=\"sts-p\" style=\"text-indent:5px\">    <span class=\"sts-label\">—</span> le contrôle des méthodes d'analyse.   </div></li> </ul></div>"@fr , "systematic or permanent collection and long-term storage of representative soil <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">samples <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> for <div class=\"list\"> <ul style=\"list-style-type: none\">  <li>   <div class=\"sts-p\" style=\"text-indent:5px\">    <span class=\"sts-label\">—</span> documentation of the state of the material at the time of <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.410\">sampling <span class=\"sts-tbx-entailedTerm-num\">(3.410)</span></a></span>, and   </div></li>  <li>   <div class=\"sts-p\" style=\"text-indent:5px\">    <span class=\"sts-label\">—</span> control of analytical methods   </div></li> </ul></div>"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.474" ;
        skos:prefLabel   "banque d'échantillons de sol"@fr , "soil specimen bank"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.389>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.389> ;
        skos:altLabel    "QR"@en , "QR"@fr ;
        skos:definition  "<i>taux de respiration basale (R</i><sub>B</sub><span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.38\">)  <span class=\"sts-tbx-entailedTerm-num\">(3.38)</span></a></span> divisé par le taux de <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.510\">respiration induite par le substrat  <span class=\"sts-tbx-entailedTerm-num\">(3.510)</span></a></span> (<i>R<sub>S</sub></i>) <div class=\"sts-disp-formula-panel\"> <a id=\"a_iso_std_iso_11074_ed-3_v1_fr_d495344e11842\"></a><img class=\"math\" alt=\"mml_m2\" src=\"/obp/graphics/std/iso_std_iso_11074_ed-3_v1_fr/mml_m2.png\"> <div class=\"sts-disp-formula-label\"></div></div>"@fr , "<i>basal respiration rate (R</i><sub>B</sub><span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.38\">) <span class=\"sts-tbx-entailedTerm-num\">(3.38)</span></a></span> divided by <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.510\">substrate-induced respiration <span class=\"sts-tbx-entailedTerm-num\">(3.510)</span></a></span> rate (<i>R</i><sub>S</sub>) <div class=\"sts-disp-formula-panel\"> <a id=\"a_iso_std_iso_11074_ed-3_v1_en_d495280e11825\"></a><img class=\"math\" alt=\"mml_m2\" src=\"/obp/graphics/std/iso_std_iso_11074_ed-3_v1_en/mml_m2.png\"> <div class=\"sts-disp-formula-label\"></div></div>"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.389" ;
        skos:prefLabel   "quotient d'activation respiratoire"@fr , "respiratory activation quotient"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.263>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.263> ;
        skos:altLabel    "q"@fr , "q"@en ;
        skos:definition  "activité métabolique spécifique des <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.266\">micro-organismes&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.266)</span></a></span> du sol, qui peut être calculée sous forme de quotient <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.37\">respiration basale&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.37)</span></a></span>/<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.47\">biomasse&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.47)</span></a></span> (<a class=\"sts-xref\" href=\"#iso:std:iso:11074:ed-3:v1:fr:sec:3.48\">3.48</a>) (<a class=\"sts-xref\" href=\"#iso:std:iso:11074:ed-3:v1:fr:sec:3.49\">3.49</a>) microbienne"@fr , "specific metabolic activity of soil <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.266\">microorganisms <span class=\"sts-tbx-entailedTerm-num\">(3.266)</span></a></span>, which can be calculated as the quotient <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.37\">basal respiration <span class=\"sts-tbx-entailedTerm-num\">(3.37)</span></a></span>: microbial <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.47\">biomass <span class=\"sts-tbx-entailedTerm-num\">(3.47)</span></a></span> (<a class=\"sts-xref\" href=\"#iso:std:iso:11074:ed-3:v1:en:sec:3.48\">3.48</a>) (<a class=\"sts-xref\" href=\"#iso:std:iso:11074:ed-3:v1:en:sec:3.49\">3.49</a>)"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.263" ;
        skos:note        "Note 1 à l’article: Le quotient métabolique est généralement exprimé en milligrammes de carbone de CO2 produit par heure par gramme de carbone de biomasse microbienne."@fr , "Note 1 to entry: Metabolic quotient is usually expressed as milligrams of CO2 carbon released per hour per gram of microbial biomass carbon."@en ;
        skos:prefLabel   "metabolic quotient"@en , "quotient métabolique"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.93>
        a                skos:Concept ;
