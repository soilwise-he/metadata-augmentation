<https://data.geoscience.earth/ncl/ISO11074v2025/3.154>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.154> ;
        skos:definition  "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.459\">soil material <span class=\"sts-tbx-entailedTerm-num\">(3.459)</span></a></span> extracted from the ground"@en , "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.459\">matériau du sol&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.459)</span></a></span> extrait de la terre"@fr ;
        skos:example     "Horizon superficiel (3.536), sous-sol (3.506) (3.507), roche mère altérée, mis au jour généralement lors de chantiers (3.89)."@fr , "Topsoil (3.536), subsoil (3.506) (3.507), altered parent rock, typically arising during construction works (3.89)."@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.154" ;
        skos:prefLabel   "excavated soil"@en , "terre excavée"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.546>
        a                skos:Concept ;
