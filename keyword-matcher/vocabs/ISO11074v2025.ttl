        skos:example     "Le remplissage d'une coupelle ou d'une tarière."@fr , "The filling of a scoop or auger."@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.218" ;
        skos:prefLabel   "increment"@en , "prélèvement élémentaire"@fr .

