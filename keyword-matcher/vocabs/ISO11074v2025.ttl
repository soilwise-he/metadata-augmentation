        skos:definition  "selected part of a <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">sample <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span>"@en , "partie tirée d'un <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">échantillon&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span>"@fr ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.503" ;
        skos:note        "Note 1 à l’article: Le sous-échantillon peut être choisi par la même méthode que celle utilisée pour la sélection de l'échantillon d'origine, sans nécessairement que cela soit le cas."@fr , "Note 1 to entry: The subsample can be selected by the same method that was used in selecting the original sample, but need not be so."@en ;
        skos:prefLabel   "subsample"@en , "sous-échantillon"@fr .

