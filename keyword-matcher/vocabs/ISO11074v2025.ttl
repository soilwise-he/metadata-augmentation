        skos:definition  "ajout d'un électron à un atome ou à un groupe d'atomes"@fr , "addition of an electron to an atom or group"@en ;
        skos:example     "Changement d'état d'oxydation (3.305) d'un atome [par exemple, As(V) devenant As(III)]."@fr , "Change in oxidation (3.305) stage of an atom (e.g. As(V) to As(III))."@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.373" ;
        skos:prefLabel   "réduction"@fr , "reduction"@en .

