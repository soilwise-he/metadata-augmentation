        skos:prefLabel   "post-treatment measure"@en , "mesure de post-traitement"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.210>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.210> ;
        skos:definition  "composé constitué d'hydrogène et de carbone, principal constituant du pétrole brut, des produits pétroliers raffinés et des produits dérivés de la carbonisation du charbon"@fr , "compound of hydrogen and carbon which are the principal constituents of crude oil, refined petroleum products, and products derived from the carbonization of coal"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.210" ;
        skos:note        "Note 1 to entry: Hydrocarbons can derive from the carbonization of coal at high or low temperatures."@en , "Note 1 à l’article: Les hydrocarbures peuvent résulter de la carbonisation du charbon à haute ou à basse température."@fr ;
        skos:prefLabel   "hydrocarbure"@fr , "hydrocarbon"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.40>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.40> ;
        skos:definition  "fraction d'une substance d'une substance dans un sol ou un <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.459\">matériau du sol&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.459)</span></a></span>, libérée dans les sucs gastrointestinaux (humains) et donc disponible pour absorption"@fr , "fraction of a substance in soil or <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.459\">soil material <span class=\"sts-tbx-entailedTerm-num\">(3.459)</span></a></span> that is liberated in (human) gastrointestinal juices and thus available for absorption"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.40" ;
        skos:prefLabel   "bioaccessibility"@en , "bioaccessibilité"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.125>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.125> ;
        skos:altLabel    "direct measuring method"@en , "méthode de mesurage directe"@fr ;
        skos:definition  "méthode d'analyse dans laquelle l'<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">échantillon&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> de <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.454\">gaz du sol&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.454)</span></a></span> (<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.19\">aliquote&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.19)</span></a></span>) est introduit directement dans un dispositif approprié, sans concentration préalable, et est ensuite soumis à une analyse"@fr , "method of analysis where the <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.454\">soil gas <span class=\"sts-tbx-entailedTerm-num\">(3.454)</span></a></span><span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">sample <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> (<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.19\">aliquot <span class=\"sts-tbx-entailedTerm-num\">(3.19)</span></a></span>) is directly introduced into a suitable equipment without first being concentrated and subjected to analysis"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.125" ;
        skos:prefLabel   "direct method"@en , "méthode directe"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.517>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.517> ;
        skos:definition  "composante du <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.515\">développement durable&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.515)</span></a></span> qui met fin au déclin économique, social et environnemental des zones considérées"@fr , "component of <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.515\">sustainable development <span class=\"sts-tbx-entailedTerm-num\">(3.515)</span></a></span> that reverses the economic, social and environmental decline of places"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.517" ;
        skos:prefLabel   "sustainable regeneration"@en , "requalification durable"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.493>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.493> ;
        skos:definition  "composé cible, de la plus grande pureté possible, qui peut être utilisé comme une référence au cours de l'analyse"@fr , "target compound with the highest possible purity, which can be used as a reference during the analysis"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.493" ;
        skos:prefLabel   "standard compound"@en , "composé étalon"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.306>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.306> ;
        skos:definition  "unweathered organic or inorganic solid or unconsolidated rock from which soil developed or originated"@en , "formation rocheuse organique ou inorganique, non altérée, solide ou meuble, à partir de laquelle le sol s'est développé ou s'est formé"@fr ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.306" ;
        skos:note        "Note 1 to entry: It can include material from alluvial, colluvial, and aeolian origins."@en , "Note 1 à l’article: La roche mère peut inclure des matériaux d'origine alluviale, colluviale et éolienne."@fr ;
        skos:prefLabel   "roche mère"@fr , "parent material"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.10>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.10> ;
        skos:definition  "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.410\">échantillonnage&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.410)</span></a></span> par extraction d'un certain volume de <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.454\">gaz du sol&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.454)</span></a></span>"@fr , "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.410\">sampling <span class=\"sts-tbx-entailedTerm-num\">(3.410)</span></a></span> by extracting a certain volume of <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.454\">soil gas <span class=\"sts-tbx-entailedTerm-num\">(3.454)</span></a></span>"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.10" ;
        skos:prefLabel   "échantillonnage actif des gaz du sol"@fr , "active soil gas sampling"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.282>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.282> ;
        skos:definition  "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.266\">micro-organisme&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.266)</span></a></span> ubiquiste formant une association symbiotique avec les racines d'espèces de plantes vasculaires"@fr , "ubiquitous <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.266\">microorganism <span class=\"sts-tbx-entailedTerm-num\">(3.266)</span></a></span> forming symbiotic association with the roots of vascular plant species"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.282" ;
        skos:prefLabel   "mycorrhizal fungus"@en , "champignon mycorhizogène"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.197>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.197> ;
        skos:definition  "aptitude du sol/des <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.459\">matériaux du sol&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.459)</span></a></span> à servir d’habitat aux micro-organismes, aux végétaux et aux animaux vivant dans le sol et à permettre leurs interactions (biocénose)"@fr , "ability of soil/<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.459\">soil materials <span class=\"sts-tbx-entailedTerm-num\">(3.459)</span></a></span> to serve as a habitat for micro-organisms, plants, soil living animals, and their interactions (biocenosis)"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.197" ;
        skos:prefLabel   "fonction d'habitat"@fr , "habitat function"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.463>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.463> ;
        skos:definition  "dispositions prises pour la conservation à long terme ou la restauration du sol et de ses <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.453\">fonctions&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.453)</span></a></span>"@fr , "measures for long-term maintenance or restoration of soils and <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.453\">soil functions <span class=\"sts-tbx-entailedTerm-num\">(3.453)</span></a></span>"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.463" ;
        skos:prefLabel   "protection du sol"@fr , "soil protection"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.378>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.378> ;
        skos:definition  "fluorescence mesurée pour chaque traitement (témoin et essai), de laquelle est soustraite la fluorescence du blanc&nbsp;A correspondant"@fr , "fluorescence measured for each treatment (control and test) after subtracting the fluorescence of the respective blank A"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.378" ;
        skos:prefLabel   "relative fluorescence"@en , "fluorescence relative"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.252>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.252> ;
        skos:altLabel    "DMSE"@fr , "LID"@en ;
        skos:definition  "lowest value of the dilution factor above which the test gives an ecotoxicological relevant <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.373\">reduction <span class=\"sts-tbx-entailedTerm-num\">(3.373)</span></a></span> (e.g.&nbsp;20&nbsp;% inhibition of luminescence)"@en , "valeur minimale du facteur de dilution au-dessus de laquelle l'essai révèle une <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.373\">réduction&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.373)</span></a></span> pertinente d'un point de vue écotoxicologique (par exemple inhibition de la luminescence de 20&nbsp;%)"@fr ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.252" ;
        skos:prefLabel   "lowest ineffective dilution"@en , "dilution minimale sans effet"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.82>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.82> ;
        skos:definition  "extract obtained by <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.272\">mixing <span class=\"sts-tbx-entailedTerm-num\">(3.272)</span></a></span> two or more extracts from different <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.528\">test samples <span class=\"sts-tbx-entailedTerm-num\">(3.528)</span></a></span> in an equivalent manner"@en , "extrait obtenu en <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.272\">mélangeant&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.272)</span></a></span> au moins deux extraits, provenant de différents <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.528\">échantillons pour essai&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.528)</span></a></span>, en proportions équivalentes"@fr ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.82" ;
        skos:note        "Note 1 to entry: Composite extracts are used instead of composite samples (3.83) (3.84) if mixing influences the composition of a composite sample, as is to be expected for e.g. volatile components."@en , "Note 1 à l’article: Les extraits composites remplacent les échantillons composites (3.83) (3.84) si le mélange affecte la composition d'un échantillon composite, ce qui peut se produire en présence d'éléments volatils, par exemple."@fr ;
        skos:prefLabel   "composite extract"@en , "extrait composite"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.167>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.167> ;
        skos:definition  "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">sample <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> obtained and/or formed on-site during an investigation intended for laboratory analysis or testing following any necessary pretreatment in the laboratory"@en , "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">échantillon&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> obtenu et/ou constitué sur site au cours d'une investigation et destiné à être analysé au laboratoire ou soumis à essai après tout prétraitement nécessaire en laboratoire"@fr ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.167" ;
        skos:note        "Note 2 to entry: Sometimes not all field samples are sent to the laboratory to become laboratory samples (3.236). The unused samples are discarded or appropriately stored in case they are required at a later date."@en , "Note 1 à l’article: Il arrive parfois qu'un échantillon d'origine prélevé dans le sol soit soumis à un prétraitement sur le terrain afin d'obtenir un échantillon de taille et de nature appropriées avant envoi au laboratoire (voir l'ISO 18400-201)."@fr , "Note 3 à l’article: Les échantillons de terrain sont parfois utilisés directement sur site, par exemple lorsque des mesurages sont effectués à l'aide d'un spectromètre de fluorescence X portatif (voir l'ISO 13196)."@fr , "Note 1 to entry: A sample as originally obtained from the ground can sometimes undergo pretreatment in the field to obtain a sample of suitable size and character to be sent to a laboratory (see ISO 18400-201)."@en , "Note 3 to entry: Field samples are sometimes employed directly on-site, for example, when measurements are made using a portable X-ray fluorescence instrument (see ISO 13196)."@en , "Note 2 à l’article: Tous les échantillons de terrain ne sont pas forcément envoyés au laboratoire pour devenir des échantillons pour laboratoire (3.236); les échantillons non utilisés sont jetés ou conservés dans des conditions appropriées pour le cas où ils pourraient servir ultérieurement."@fr ;
        skos:prefLabel   "field sample"@en , "échantillon de terrain"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.559>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.559> ;
        skos:altLabel    "portion"@en , "portion"@fr , "entité"@fr , "individu"@fr , "item"@en , "individual"@en ;
        skos:definition  "toute quantité distincte et identifiable de matériau pouvant être prélevée dans une <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.331\">population&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.331)</span></a></span> pour constituer un <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">échantillon&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> complet ou partiel et pouvant être individuellement considérée, étudiée, analysée ou combinée"@fr , "each of the discrete, identifiable portions of material suitable for removal from a <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.331\">population <span class=\"sts-tbx-entailedTerm-num\">(3.331)</span></a></span> as a <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">sample <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> or as a portion of a sample and which can be individually considered, examined, tested, or combined"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.559" ;
        skos:prefLabel   "unité"@fr , "unit"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.433>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.433> ;
        skos:definition  "matériau solide, tant minéral qu'organique, qui est en suspension ou a été entraîné depuis son <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.443\">site&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.443)</span></a></span> d'origine par l'eau ou d'autres processus"@fr , "solid material, both mineral and organic, that is in suspension or has been moved from its <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.443\">site <span class=\"sts-tbx-entailedTerm-num\">(3.443)</span></a></span> of origin by water or other processes"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.433" ;
        skos:prefLabel   "sediment"@en , "sédiment"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.348>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.348> ;
        skos:definition  "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">échantillon&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> pris dans une <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.331\">population&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.331)</span></a></span> lors de la première étape d'un <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.280\">échantillonnage à plusieurs degrés&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.280)</span></a></span>"@fr , "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">sample <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> taken from a <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.331\">population <span class=\"sts-tbx-entailedTerm-num\">(3.331)</span></a></span> during the first stage of <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.280\">multi-stage sampling <span class=\"sts-tbx-entailedTerm-num\">(3.280)</span></a></span>"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.348" ;
        skos:note        "Note 1 to entry: Primary samples can be either combined (composite sample (3.83) (3.84)) or kept separate (gross sample)."@en , "Note 1 à l’article: Les échantillons primaires peuvent être combinés (échantillon composite (3.83) (3.84)) ou conservés séparément (échantillon brut)."@fr ;
        skos:prefLabel   "échantillon primaire"@fr , "primary sample"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.222>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.222> ;
        skos:definition  "organisme qui s’est développé naturellement dans un milieu donné et dont la présence ne résulte pas d'un apport anthropique"@fr , "organism which has developed naturally in a given area and not as a consequence of artificial introduction"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.222" ;
        skos:prefLabel   "indigène"@fr , "indigenous"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.52>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.52> ;
        skos:definition  "produit organique appliqué sur un sol"@fr , "organic product applied to soil"@en ;
        skos:example     "Boues d'épuration, compost, fumier, produits industriels."@fr , "Sewage sludge, compost, manure, industrial products."@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.52" ;
        skos:note        "Note 1 à l’article: En l’absence de contexte spécifique, un biosolide est souvent considéré comme un constituant des boues d’épuration."@fr , "Note 1 to entry: Without giving a specific context, biosolid is often regarded as a component of sewage sludge."@en ;
        skos:prefLabel   "biosolid"@en , "biosolide"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.137>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.137> ;
        skos:definition  "temps nécessaire à la <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.86\">concentration <span class=\"sts-tbx-entailedTerm-num\">(3.86)</span></a></span> d'un composé donné pour être réduite de 90&nbsp;% de sa valeur d'origine"@fr , "time taken for the <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.86\">concentration <span class=\"sts-tbx-entailedTerm-num\">(3.86)</span></a></span> of a given compound to be reduced by 90&nbsp;% of its original value"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.137" ;
        skos:prefLabel   "DT-90"@en , "DT-90"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.529>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.529> ;
        skos:altLabel    "analytical solution"@en , "solution pour analyse"@fr ;
        skos:definition  "solution préparée par dissolution (avec ou sans réaction) de la <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.527\">prise d'essai&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.527)</span></a></span> dans un liquide"@fr , "solution prepared by dissolving (with or without reaction) the <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.527\">test portion <span class=\"sts-tbx-entailedTerm-num\">(3.527)</span></a></span> in a liquid"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.529" ;
        skos:note        "Note 1 to entry: The solution can also be obtained by extraction with appropriate liquid of one or several constituent(s) of test portion."@en , "Note 1 à l’article: La solution peut également être obtenue par extraction, à l'aide d'un liquide approprié, d'un ou de plusieurs constituants de la prise d'essai."@fr ;
        skos:prefLabel   "solution pour essai"@fr , "test solution"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.403>
        a                skos:Concept ;
