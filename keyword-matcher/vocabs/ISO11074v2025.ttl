<https://data.geoscience.earth/ncl/ISO11074v2025/3.439>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.439> ;
        skos:definition  "units, <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.218\">increments <span class=\"sts-tbx-entailedTerm-num\">(3.218)</span></a></span>, or <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">samples <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> taken one at a time or in successive predetermined groups until the cumulative result of their measurements (typically applied to attributes), as assessed against predetermined limits, permits a decision to accept or reject the <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.331\">population <span class=\"sts-tbx-entailedTerm-num\">(3.331)</span></a></span> or to continue <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.410\">sampling <span class=\"sts-tbx-entailedTerm-num\">(3.410)</span></a></span>"@en , "unités, <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.218\">prélèvements élémentaires&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.218)</span></a></span> ou <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">échantillons&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> prélevés un par un ou en groupes successifs prédéterminés, jusqu'à ce que le résultat cumulé de leurs mesures (essentiellement appliquées à des attributs), évalué par rapport à des limites prédéterminées, permette de décider de l'acceptation ou du rejet de la <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.331\">population&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.331)</span></a></span>, ou de la poursuite de l'<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.410\">échantillonnage&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.410)</span></a></span>"@fr ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.439" ;
        skos:note        "Note 1 to entry: The number of observations required is not determined in advance, but the decision to terminate the operation depends, at each stage, on the results of previous observations. The plan can have a practical, automatic termination after a certain number of units have been examined."@en , "Note 1 à l’article: Le nombre d'observations nécessaires n'est pas déterminé à l'avance, mais la décision de mettre fin à l'opération dépend, à chaque étape, des résultats des observations antérieures. Le plan peut être, pour des raisons pratiques, automatiquement arrêté après l'examen d'un certain nombre d'unités."@fr ;
        skos:prefLabel   "sequential sample"@en , "échantillon séquentiel"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.313>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.313> ;
        skos:definition  "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.354\">mesure de protection&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.354)</span></a></span> dont la seule présence assure une protection"@fr , "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.354\">protective measure <span class=\"sts-tbx-entailedTerm-num\">(3.354)</span></a></span> that provides protection solely through its presence"@en ;
        skos:example     "Soil cover system (3.102), a containment (3.90) barrier system designed to protect groundwater (3.191) from migrating chemicals, a barrier system designed to prevent migration of gas towards housing, a coating system for concrete to protect it against attack by an aggressive chemical."@en , "Système de couverture (3.102) du sol, barrière de confinement (3.90) destinée à protéger les eaux souterraines (3.191) du transfert de produits chimiques, barrière destinée à empêcher le transfert des gaz vers les habitations, système de revêtement du béton destiné à protéger les structures de l'attaque d'un produit chimique agressif."@fr ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.313" ;
        skos:prefLabel   "mesure de protection passive"@fr , "passive protective measure"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.228>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.228> ;
        skos:definition  "suspension de cellules, de tissus, de champignons ou de <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.266\">micro-organismes&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.266)</span></a></span> utilisée pour ensemencer une solution nutritive"@fr , "suspension of cells, tissue, fungi or <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.266\">microorganisms <span class=\"sts-tbx-entailedTerm-num\">(3.266)</span></a></span> used to inoculate a nutrient solution"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.228" ;
        skos:prefLabel   "inoculum"@en , "inoculum"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.58>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.58> ;
        skos:altLabel    "résidus non extractibles"@fr , "non-extractable residues"@en ;
        skos:definition  "chemical species in plants and soils, that cannot be extracted without significantly changing the chemical nature of these residues"@en , "espèces chimiques présentes dans les végétaux et dans les sols, qui ne peuvent pas être extraites sans changement significatif de la nature chimique de ces résidus"@fr ;
        skos:example     "Chemical species originating from organic molecules."@en , "Espèces chimiques issues de molécules organiques."@fr ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.58" ;
        skos:note        "Note 1 à l’article: Ces résidus non extractibles sont considérés exclure des fragments recyclés par des voies métaboliques menant aux produits naturels."@fr , "Note 1 to entry: These non-extractable residues are considered to exclude fragments recycled through metabolic pathways leading to natural products."@en ;
        skos:prefLabel   "résidus liés"@fr , "bound residues"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.102>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.102> ;
        skos:definition  "système composé d'une ou de plusieurs couches de matériaux tels que terre, déchets minéraux adaptés ou <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.188\">matériaux géosynthétiques&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.188)</span></a></span> (par exemple membranes, <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.189\">géotextiles&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.189)</span></a></span>) étalés en surface d'un <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.443\">site&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.443)</span></a></span> (parfois après une <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.155\">excavation&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.155)</span></a></span> partielle) et destiné à bloquer le transfert des <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.91\">contaminants&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.91)</span></a></span> vers la surface et l'infiltration des eaux de pluie et autres substances, et souvent à remplir d'autres fonctions telles que celles de support de végétation ou de plate-forme de construction"@fr , "one or more layers of materials, such as soils, suitable mineral wastes, and <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.188\">geosynthetics <span class=\"sts-tbx-entailedTerm-num\">(3.188)</span></a></span> (e.g.&nbsp;membranes, <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.189\">geotextiles <span class=\"sts-tbx-entailedTerm-num\">(3.189)</span></a></span>) superimposed on the surface of a <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.443\">site <span class=\"sts-tbx-entailedTerm-num\">(3.443)</span></a></span> (sometimes following partial <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.155\">excavation <span class=\"sts-tbx-entailedTerm-num\">(3.155)</span></a></span>) designed to control migration of <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.91\">contaminants <span class=\"sts-tbx-entailedTerm-num\">(3.91)</span></a></span> upwards and infiltration of rainfall,&nbsp;etc. downwards, and often to perform other functions such as to sustain vegetation or to provide a platform on which construction can take place"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.102" ;
        skos:prefLabel   "couverture"@fr , "cover system"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.409>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.409> ;
        skos:definition  "volume de l'<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">échantillon&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> qui est prélevé dans le sol"@fr , "volume of <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">sample <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> which is taken from soil"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.409" ;
        skos:prefLabel   "sample volume"@en , "volume d'échantillon"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.470>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.470> ;
        skos:definition  "volume de dioxyde de carbone produit et/ou d’oxygène consommé par unité de masse de sol par unité de temps"@fr , "volume of carbon dioxide released and/or oxygen consumed per unit mass of soil per unit time"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.470" ;
        skos:prefLabel   "soil respiration rate"@en , "taux de respiration du sol"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.385>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.385> ;
        skos:definition  "technologie qui prétraite, traite ou post-traite la terre ou le <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.91\">contaminant&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.91)</span></a></span>"@fr , "technology that pre-processes, processes or post-processes the ground or <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.91\">contaminant <span class=\"sts-tbx-entailedTerm-num\">(3.91)</span></a></span>"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.385" ;
        skos:prefLabel   "remediation technology"@en , "technique de dépollution"@fr .

