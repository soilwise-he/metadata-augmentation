        skos:prefLabel   "exposition"@fr , "exposure"@en ;
        <https://w3id.org/dpv#hasContext>
                "appréciation du risque, santé humaine"@fr , "risk assessment, human health"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.552>
        a                skos:Concept ;
        dct:source       "ISO 6107:2021, 3.594"@fr , "ISO 6107:2021, 3.594"@en ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.552> ;
        skos:definition  "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.44\">biodegradation <span class=\"sts-tbx-entailedTerm-num\">(3.44)</span></a></span> leading to complete <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.269\">mineralization <span class=\"sts-tbx-entailedTerm-num\">(3.269)</span></a></span>"@en , "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.44\">biodégradation&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.44)</span></a></span> conduisant à une <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.269\">minéralisation&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.269)</span></a></span> complète"@fr ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.552" ;
        skos:prefLabel   "ultimate biodegradation"@en , "biodégradation ultime"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.467>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.467> ;
        skos:definition  "characterizing property of the acid base state of soils, which is determined by hydrogen ion <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.86\">concentration <span class=\"sts-tbx-entailedTerm-num\">(3.86)</span></a></span> of an aqueous soil extract under defined conditions"@en , "propriété caractérisant l'état acido-basique des sols, déterminée par la <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.86\">concentration&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.86)</span></a></span> en ions hydrogène d'un extrait aqueux de sol dans des conditions définies"@fr ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.467" ;
        skos:note        "Note 1 à l’article: La valeur du pH correspond au cologarithme décimal de la concentration en ions hydrogène d'une solution aqueuse, exprimée en moles par litre (mol/l)."@fr , "Note 1 to entry: The pH value is stated as negative 10-logarithm of the concentration of hydrogen ions as expressed in mol/l in aqueous solution."@en ;
        skos:prefLabel   "réaction du sol"@fr , "soil reaction"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.341>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.341> ;
        skos:definition  "desktop <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.395\">risk assessment <span class=\"sts-tbx-entailedTerm-num\">(3.395)</span></a></span> based on the possible <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.93\">contamination <span class=\"sts-tbx-entailedTerm-num\">(3.93)</span></a></span>, its release, and effect taking into account similar situations and <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.443\">site <span class=\"sts-tbx-entailedTerm-num\">(3.443)</span></a></span><span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.70\">characteristics <span class=\"sts-tbx-entailedTerm-num\">(3.70)</span></a></span> from existing databases such as site history, <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.91\">contaminant <span class=\"sts-tbx-entailedTerm-num\">(3.91)</span></a></span> characteristics, geological maps, or weather records"@en , "<i>appréciation</i> documentaire <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.395\">du risque&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.395)</span></a></span>, fondée sur la <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.93\">contamination&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.93)</span></a></span> potentielle, sa diffusion et son effet en tenant compte de situations et de <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.70\">caractéristiques&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.70)</span></a></span> de <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.443\">site&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.443)</span></a></span> similaires, à partir de bases de données existantes, telles que, par exemple, l'historique du site, les caractéristiques du ou des <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.91\">contaminants&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.91)</span></a></span>, les cartes géologiques ou les données météorologiques"@fr ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.341" ;
        skos:note        "Note 1 to entry: The preliminary assessment does not require site specific data, such as soil sampling. The purpose of the preliminary assessment is to decide about the need for further study."@en , "Note 1 à l’article: L'évaluation préliminaire ne requiert aucune donnée spécifique au site, telle que, par exemple, l'échantillonnage du sol. Cette évaluation a pour objectif de déterminer la nécessité ou non d'une étude complémentaire."@fr ;
        skos:prefLabel   "preliminary assessment"@en , "évaluation préliminaire"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.256>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.256> ;
        skos:definition  "produit artificiel censé remplir des <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.453\">fonctions du sol&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.453)</span></a></span> déterminées, formé en mélangeant des matériaux naturels, des déchets ou d'autres matériaux du sol auxquels ont été ajoutés, si nécessaire, des nutriments ou d'autres additifs"@fr , "manufactured product intended to perform specified <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.453\">soil functions <span class=\"sts-tbx-entailedTerm-num\">(3.453)</span></a></span> produced by blending combinations of natural, waste, or other <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.459\">soil materials <span class=\"sts-tbx-entailedTerm-num\">(3.459)</span></a></span> with the addition of nutrients or other additives, when necessary"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.256" ;
        skos:prefLabel   "manufactured soil"@en , "matériau artificiel"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.86>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.86> ;
        skos:definition  "masse de <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.530\">substance d'essai&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.530)</span></a></span> par unité de masse de matériau"@fr , "mass of <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.530\">test substance <span class=\"sts-tbx-entailedTerm-num\">(3.530)</span></a></span> per unit mass of material"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.86" ;
        skos:note        "Note 1 to entry: Concentration is expressed as a mass fraction, in milligrams per kilogram (mg/kg) of dry soil."@en , "Note 1 à l’article: La concentration est exprimée en fraction massique, en milligrammes par kilogramme (mg/kg) de sol sec."@fr ;
        skos:prefLabel   "concentration"@en , "concentration"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.130>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.130> ;
        skos:definition  "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.443\">site&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.443)</span></a></span> sur lequel sont prélevés des <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.459\">matériaux du sol&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.459)</span></a></span> destinés à être utilisés sur un <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.522\">site cible&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.522)</span></a></span>"@fr , "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.443\">site <span class=\"sts-tbx-entailedTerm-num\">(3.443)</span></a></span> from which <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.459\">soil material <span class=\"sts-tbx-entailedTerm-num\">(3.459)</span></a></span> is removed for use on a <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.522\">target site <span class=\"sts-tbx-entailedTerm-num\">(3.522)</span></a></span>"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.130" ;
        skos:prefLabel   "donor site"@en , "site donneur"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.522>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.522> ;
        skos:definition  "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.443\">site&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.443)</span></a></span> sur lequel du <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.448\">sol&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.448)</span></a></span> doit être réutilisé"@fr , "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.443\">site <span class=\"sts-tbx-entailedTerm-num\">(3.443)</span></a></span> at which <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.448\">soil <span class=\"sts-tbx-entailedTerm-num\">(3.448)</span></a></span> is to be reused"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.522" ;
        skos:prefLabel   "target site"@en , "site cible"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.437>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.437> ;
        skos:definition  "séparation d'une partie d'un <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">échantillon&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> en fonction de son classement (c'est-à-dire au-dessus ou en dessous d'une granulométrie définie), de son aspect ou de tout autre attribut"@fr , "separation of part of a <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">sample <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> on the basis of grading (i.e. above or below a defined particle size), appearance or some other attribute"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.437" ;
        skos:prefLabel   "sous-échantillonnage sélectif"@fr , "selective subsampling"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.311>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.311> ;
        skos:definition  "rapport de la <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.86\">concentration&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.86)</span></a></span> d'une substance contenue dans la fraction du sol correspondant à la <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.301\">matière organique&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.301)</span></a></span> à celle contenue dans la phase aqueuse du sol"@fr , "ratio of the <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.86\">concentration <span class=\"sts-tbx-entailedTerm-num\">(3.86)</span></a></span> of a substance in the soil <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.301\">organic matter <span class=\"sts-tbx-entailedTerm-num\">(3.301)</span></a></span> fraction to that in the soil-water phase"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.311" ;
        skos:note        "Note 1 à l’article: Ce coefficient de répartition (3.309) est souvent exprimé par rapport à la teneur du sol en carbone organique (3.300) (d'où le symbole Koc)."@fr , "Note 1 to entry: This partition coefficient (3.309) is often expressed in relation to the soil organic carbon (3.300) content (hence: Koc)."@en ;
        skos:prefLabel   "coefficient de répartition entre la matière organique du sol et l'eau du sol"@fr , "partition coefficient between soil organic matter and soil water"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.226>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.226> ;
        skos:altLabel    "ID"@en , "DI"@fr ;
        skos:definition  "quantité de <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.530\">substance d'essai&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.530)</span></a></span> ajoutée au sol qui inhibe effectivement l'activité biologique d'un pourcentage fixé, à l'issue d'un temps donné, par rapport à un échantillon témoin non traité"@fr , "amount of a <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.530\">test substance <span class=\"sts-tbx-entailedTerm-num\">(3.530)</span></a></span> added to soil that effectively inhibits biological activity by a stated percentage after a given time, in comparison to an untreated control"@en ;
        skos:example     "ID25 and ID50 indicate 25 % and 50 % inhibition of biological activity respectively."@en , "DI25 et DI50 indiquent respectivement 25 % et 50 % d'inhibition de l'activité biologique."@fr ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.226" ;
        skos:note        "Note 1 à l’article: Elle est exprimée en pourcentage."@fr , "Note 1 to entry: It is expressed as a percentage."@en ;
        skos:prefLabel   "inhibitory dose"@en , "dose inhibitrice"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.56>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.56> ;
        skos:altLabel    "forage"@fr , "perçage"@fr , "bore"@en , "borehole"@en ;
        skos:definition  "trou de diamètre et de profondeur prédéfinis, creusé par <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.134\">forage&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.134)</span></a></span> dans tout type de sol, de formation géologique ou de matériau artificiel"@fr , "hole of any predetermined diameter and length formed in any soil, geological formation, or man-made material by <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.134\">drilling <span class=\"sts-tbx-entailedTerm-num\">(3.134)</span></a></span>"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.56" ;
        skos:prefLabel   "boring"@en , "sondage"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.100>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.100> ;
        skos:definition  "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">échantillon&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> prélevé dans une <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.99\">carotte&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.99)</span></a></span>"@fr , "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">sample <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> obtained from a <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.99\">core <span class=\"sts-tbx-entailedTerm-num\">(3.99)</span></a></span>"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.100" ;
        skos:prefLabel   "core sample"@en , "échantillon de carotte"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.407>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.407> ;
        skos:definition  "processus, et son résultat, consistant à garder un échantillon de sol disponible dans des conditions prédéfinies, en général pour un laps de temps déterminé, entre le prélèvement et le traitement de cet <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">échantillon&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span>"@fr , "process and the result of keeping a soil sample available under predefined conditions, usually for a specified time interval between collection and further treatment of a <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">sample <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span>"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.407" ;
        skos:prefLabel   "sample storage"@en , "stockage d'un échantillon"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.383>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.383> ;
        skos:definition  "combinaison de techniques de dépollution et de programmes de travaux connexes visant à atteindre des objectifs de <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.380\">dépollution&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.380)</span></a></span> spécifiés liés à la <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.93\">contamination&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.93)</span></a></span> ainsi que d'autres objectifs (par exemple exécution des travaux), et à surmonter les éventuelles contraintes"@fr , "combination of remedial techniques and associated work programmes that will meet specified <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.93\">contamination <span class=\"sts-tbx-entailedTerm-num\">(3.93)</span></a></span>-related <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.380\">remediation <span class=\"sts-tbx-entailedTerm-num\">(3.380)</span></a></span> objectives and other objectives (e.g. engineering-related ones), and overcome possible restraints"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.383" ;
        skos:prefLabel   "remediation strategy"@en , "scénario de gestion"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.26>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.26> ;
        skos:definition  "portion de matériau, obtenue à partir de l'<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">échantillon&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> d'origine ou d'un <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.83\">échantillon composite&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.83)</span></a></span> (<a class=\"sts-xref\" href=\"#iso:std:iso:11074:ed-3:v1:fr:sec:3.84\">3.84</a>) au moyen d'une méthode appropriée de <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.402\">prétraitement des échantillons&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.402)</span></a></span>, et ayant la taille (volume/masse) nécessaire pour les essais ou l'analyse souhaités"@fr , "portion of material, resulting from the original <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">sample <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> or <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.83\">composite sample <span class=\"sts-tbx-entailedTerm-num\">(3.83)</span></a></span> (<a class=\"sts-xref\" href=\"#iso:std:iso:11074:ed-3:v1:en:sec:3.84\">3.84</a>) by means of an appropriate method of <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.402\">sample pretreatment <span class=\"sts-tbx-entailedTerm-num\">(3.402)</span></a></span> and having the size (volume/mass) necessary for the desired testing or analysis"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.26" ;
        skos:prefLabel   "analytical sample"@en , "échantillon pour analyse"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.298>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.298> ;
        skos:definition  "traitement appliqué sur le <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.443\">site&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.443)</span></a></span> à réhabiliter"@fr , "treatment applied on the <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.443\">site <span class=\"sts-tbx-entailedTerm-num\">(3.443)</span></a></span> being remediated"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.298" ;
        skos:prefLabel   "traitement sur site"@fr , "on-site treatment"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.172>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.172> ;
        skos:definition  "groupe d'<i>hydrocarbures</i> aromatiques et/ou <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.18\">aliphatiques&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.18)</span></a></span> ayant des propriétés physico-chimiques similaires"@fr , "group of aromatic or <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.18\">aliphatic hydrocarbons <span class=\"sts-tbx-entailedTerm-num\">(3.18)</span></a></span>, or both, with similar physic-chemical properties"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.172" ;
        skos:note        "Note 1 à l’article: Par exemple, groupe de composés aromatiques ou aliphatiques dont les facteurs de lixiviation (3.240) (3.241) et de volatilisation diffèrent d'un ordre de grandeur d'environ 1."@fr , "Note 1 to entry: For example, group of aromatic or aliphatic compounds with leaching (3.240) (3.241) and volatilization factors differ by approximately one order of magnitude."@en ;
        skos:prefLabel   "fraction"@en , "fraction"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.564>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.564> ;
        skos:definition  "zone du <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.448\">sol&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.448)</span></a></span> reliée à l'atmosphère et ventilée de façon continue ou régulière"@fr , "zone of the <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.448\">soil <span class=\"sts-tbx-entailedTerm-num\">(3.448)</span></a></span> which is connected to the atmosphere, and which is aerated either permanently or regularly"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.564" ;
        skos:prefLabel   "vadose zone"@en , "zone non saturée en eau, zone vadose"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.479>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.479> ;
        skos:definition  "totalité de l'eau des zones non saturée et <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.428\">saturée&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.428)</span></a></span>"@fr , "all water of the unsaturated and <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.428\">saturated zone <span class=\"sts-tbx-entailedTerm-num\">(3.428)</span></a></span>"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.479" ;
        skos:prefLabel   "soil water"@en , "eau du sol"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.353>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.353> ;
        skos:definition  "personne responsable de l'élaboration du <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.420\">programme d'échantillonnage&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.420)</span></a></span> et également de celle du <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.417\">plan d’échantillonnage&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.417)</span></a></span>"@fr , "individual responsible for the development of both the <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.420\">sampling programme <span class=\"sts-tbx-entailedTerm-num\">(3.420)</span></a></span> and the <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.417\">sampling plan <span class=\"sts-tbx-entailedTerm-num\">(3.417)</span></a></span>"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.353" ;
        skos:prefLabel   "chef de projet"@fr , "project manager"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.268>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.268> ;
        skos:altLabel    "grinding"@en , "crushing"@en , "écrasement"@fr , "concassage"@fr ;
        skos:definition  "réduction mécanique de la granulométrie d'un <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">échantillon&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> par frottement (friction), choc ou coupe"@fr , "mechanical reduction of the particle size of a <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">sample <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> by attrition (friction), impact, or cutting"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.268" ;
        skos:note        "Note 1 to entry: Depending on the nature of the material and of the treatment, one of these techniques is used."@en , "Note 1 à l’article: Selon la nature du matériau et du traitement, une de ces techniques est utilisée."@fr ;
        skos:prefLabel   "milling"@en , "broyage"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.98>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.98> ;
        skos:definition  "prélèvement d'<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">échantillons&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> basé sur l'accessibilité, l'adéquation, les coûts, l'efficacité ou tout autre motif sans rapport direct avec les paramètres d'échantillonnage"@fr , "process of taking <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">samples <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> based on accessibility, expediency, cost, efficiency, or other reason not directly concerned with sampling parameters"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.98" ;
        skos:note        "Note 1 à l’article: Les échantillons peuvent être prélevés suivant un plan prédéterminé (emplacements, profondeurs, etc.) ou à des emplacements et/ou des profondeurs décidés sur le site (3.443) (le terme «échantillonnage ad hoc» est parfois appliqué à ce type d'échantillonnage)."@fr , "Note 1 to entry: The samples can be taken to a predetermined plan (locations, depths etc.) or taken from locations and/or depths decided on site (3.443) (the term “ad hoc sampling” is sometimes applied to this type of sampling)."@en ;
        skos:prefLabel   "échantillonnage de commodité"@fr , "convenience sampling"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.142>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.142> ;
        skos:definition  "measure of the ability of a <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.380\">remediation <span class=\"sts-tbx-entailedTerm-num\">(3.380)</span></a></span> method to achieve required performance"@en , "mesure de la capacité d'une méthode de <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.380\">dépollution&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.380)</span></a></span> à donner les résultats requis"@fr ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.142" ;
        skos:note        "Note 1 à l’article: Pour une méthode de traitement technologique, l’efficacité peut être exprimée par la concentration (3.86) en polluant(s) correspondant à la contamination résiduelle (3.388) à laquelle il est possible de parvenir"@fr , "Note 1 to entry: In the case of a process-based method, effectiveness can be expressed in terms of the achievable residual contamination (3.388)concentrations (3.86)."@en ;
        skos:prefLabel   "efficacité"@fr , "effectiveness"@en ;
        <https://w3id.org/dpv#hasContext>
                "remediation method"@en , "méthode de dépollution"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.534>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.534> ;
        skos:definition  "limite d'acceptabilité d'un <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.219\">indicateur&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.219)</span></a></span> dont le dépassement n'est pas autorisé ou qui, s'il est franchi, entraîne des conséquences inacceptables telles qu'une non-conformité réglementaire"@fr , "limit of acceptability for an <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.219\">indicator <span class=\"sts-tbx-entailedTerm-num\">(3.219)</span></a></span> that is not allowed to be crossed or carries an unacceptable consequence if it is crossed, such as regulatory non-compliance"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.534" ;
        skos:prefLabel   "threshold"@en , "seuil"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.449>
