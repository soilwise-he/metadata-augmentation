<https://data.geoscience.earth/ncl/ISO11074v2025/3.155>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.155> ;
        skos:definition  "extraction de sol, de <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.30\">terre anthropique&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.30)</span></a></span> (par exemple, de <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.169\">remblai&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.169)</span></a></span>, de <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.254\">matériau de remblayage&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.254)</span></a></span>), de <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.433\">sédiments&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.433)</span></a></span>, etc., pour traitement ou mise en décharge"@fr , "removal of soil, <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.30\">anthropogenic ground <span class=\"sts-tbx-entailedTerm-num\">(3.30)</span></a></span> (e.g. <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.169\">fill <span class=\"sts-tbx-entailedTerm-num\">(3.169)</span></a></span>, <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.254\">made ground <span class=\"sts-tbx-entailedTerm-num\">(3.254)</span></a></span>), <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.433\">sediment <span class=\"sts-tbx-entailedTerm-num\">(3.433)</span></a></span>,&nbsp;etc., from the ground for treatment or disposal"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.155" ;
        skos:prefLabel   "excavation"@en , "excavation"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.547>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.547> ;
        skos:definition  "succession des opérations de traitement appliquées à un <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.448\">sol&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.448)</span></a></span>, à un matériau analogue au sol ou à l'eau, pour en séparer les fractions granulométriques ou autres fractions et pour éliminer, détruire ou immobiliser les <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.91\">contaminants&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.91)</span></a></span>"@fr , "sequence of treatment processes applied to a <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.448\">soil <span class=\"sts-tbx-entailedTerm-num\">(3.448)</span></a></span>, soil-like material, or water to separate out size or other fractions, remove, destroy, or immobilise <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.91\">contaminants <span class=\"sts-tbx-entailedTerm-num\">(3.91)</span></a></span>"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.547" ;
        skos:prefLabel   "chaîne de traitement"@fr , "treatment line"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.421>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.421> ;
        skos:definition  "ensemble de données brutes collectées sur le terrain"@fr , "set of raw data gathered in the field"@en ;
