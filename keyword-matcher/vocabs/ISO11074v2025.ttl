<https://data.geoscience.earth/ncl/ISO11074v2025/3.231>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.231> ;
        skos:definition  "investigation, or programme of ongoing inspection, testing or <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.276\">monitoring <span class=\"sts-tbx-entailedTerm-num\">(3.276)</span></a></span>, to confirm that a <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.383\">remediation strategy <span class=\"sts-tbx-entailedTerm-num\">(3.383)</span></a></span> has been properly implemented and/or, when a <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.90\">containment <span class=\"sts-tbx-entailedTerm-num\">(3.90)</span></a></span> approach has been adopted, that this continues to perform to the specified level"@en , "étude ou programme de contrôle, d'essais ou de <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.276\">surveillance&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.276)</span></a></span> effectué en continu pour vérifier qu’un <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.383\">scénario de gestion&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.383)</span></a></span> a été convenablement mis en œuvre et/ou, quand l'approche adoptée est celle du <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.90\">confinement&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.90)</span></a></span>, que les résultats sont maintenus au niveau prévu"@fr ;
        skos:example     "Essais pour confirmer que tous les matériaux contaminés ont été éliminés."@fr , "Testing to confirm that all contaminated material has been removed."@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.231" ;
        skos:prefLabel   "investigation for compliance or performance"@en , "diagnostic de conformité ou de performance"@fr ;
        <https://w3id.org/dpv#hasContext>
                "remediation strategy"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.61>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.61> ;
        skos:definition  "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.443\">site <span class=\"sts-tbx-entailedTerm-num\">(3.443)</span></a></span> which: <div class=\"list\"> <ul style=\"list-style-type: none\">  <li>   <div class=\"sts-p\" style=\"text-indent:5px\">    <span class=\"sts-label\">—</span> has been affected by former uses of the site or surrounding land;   </div></li>  <li>   <div class=\"sts-p\" style=\"text-indent:5px\">    <span class=\"sts-label\">—</span> is derelict or underused;   </div></li>  <li>   <div class=\"sts-p\" style=\"text-indent:5px\">    <span class=\"sts-label\">—</span> is mainly in fully developed or partly developed urban areas;   </div></li>  <li>   <div class=\"sts-p\" style=\"text-indent:5px\">    <span class=\"sts-label\">—</span> requires intervention to bring it back to beneficial use; and/or   </div></li>  <li>   <div class=\"sts-p\" style=\"text-indent:5px\">    <span class=\"sts-label\">—</span> can have real or perceived <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.93\">contamination <span class=\"sts-tbx-entailedTerm-num\">(3.93)</span></a></span> problems   </div></li> </ul></div>"@en , "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.443\">site  <span class=\"sts-tbx-entailedTerm-num\">(3.443)</span></a></span> qui: <div class=\"list\"> <ul style=\"list-style-type: none\">  <li>   <div class=\"sts-p\" style=\"text-indent:5px\">    <span class=\"sts-label\">—</span> a subi les effets d'utilisations antérieures du site ou des terrains environnants;   </div></li>  <li>   <div class=\"sts-p\" style=\"text-indent:5px\">    <span class=\"sts-label\">—</span> est dégradé ou sous-utilisé;   </div></li>  <li>   <div class=\"sts-p\" style=\"text-indent:5px\">    <span class=\"sts-label\">—</span> se situe principalement dans des zones urbaines partiellement ou pleinement développées;   </div></li>  <li>   <div class=\"sts-p\" style=\"text-indent:5px\">    <span class=\"sts-label\">—</span> nécessite une intervention pour être réaffecté à d'autres usages utiles et productifs; et/ou   </div></li>  <li>   <div class=\"sts-p\" style=\"text-indent:5px\">    <span class=\"sts-label\">—</span> peut présenter des problèmes réels ou perçus de <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.93\">contamination  <span class=\"sts-tbx-entailedTerm-num\">(3.93)</span></a></span>.   </div></li> </ul></div>"@fr ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.61" ;
        skos:prefLabel   "friche"@fr , "brownfield"@en ;
        <https://w3id.org/dpv#hasContext>
                "dépollution durable"@fr , "sustainable remediation"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.146>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.146> ;
        skos:definition  "combinaison de droits environnementaux et de responsabilités environnementales qui affirme que toute personne: <div class=\"list\"> <ul style=\"list-style-type: none\">  <li>   <div class=\"sts-p\" style=\"text-indent:5px\">    <span class=\"sts-label\">—</span> a droit à des lieux sains de vie, de travail, de loisirs, d'apprentissage et de distraction;   </div></li>  <li>   <div class=\"sts-p\" style=\"text-indent:5px\">    <span class=\"sts-label\">—</span> a droit à un partage équitable des bienfaits de la nature et des <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.140\">services écosystémiques  <span class=\"sts-tbx-entailedTerm-num\">(3.140)</span></a></span>, comme la nourriture et l'eau;   </div></li>  <li>   <div class=\"sts-p\" style=\"text-indent:5px\">    <span class=\"sts-label\">—</span> a le devoir de veiller sur la planète pour les autres et pour les générations futures.   </div></li> </ul></div>"@fr , "combination of environmental rights and environmental responsibilities that asserts that everyone has: <div class=\"list\"> <ul style=\"list-style-type: none\">  <li>   <div class=\"sts-p\" style=\"text-indent:5px\">    <span class=\"sts-label\">—</span> a right to healthy places to live, work, play, learn and enjoy oneself;   </div></li>  <li>   <div class=\"sts-p\" style=\"text-indent:5px\">    <span class=\"sts-label\">—</span> a right to a fair share of nature’s benefits and <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.140\">ecosystem services <span class=\"sts-tbx-entailedTerm-num\">(3.140)</span></a></span>, such as food and water;   </div></li>  <li>   <div class=\"sts-p\" style=\"text-indent:5px\">    <span class=\"sts-label\">—</span> a responsibility to look after the planet for others and for future generations   </div></li> </ul></div>"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.146" ;
        skos:prefLabel   "environmental justice"@en , "justice environnementale"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.538>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.538> ;
        skos:definition  "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.86\">concentration <span class=\"sts-tbx-entailedTerm-num\">(3.86)</span></a></span> derived by applying an analytical technique that cannot distinguish between similar compounds"@en , "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.86\">concentration&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.86)</span></a></span> obtenue en appliquant une méthode d'analyse ne pouvant faire la distinction entre des composés similaires"@fr ;
        skos:example     "Pour les phénols, la technique ne permet pas de faire la distinction entre les composés monohydriques, dihydriques et trihydriques."@fr , "For the phenols, the technique cannot distinguish between monohydric, dihydric, and trihydric compounds."@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.538" ;
        skos:note        "Note 1 à l’article: Le terme «totale» peut être trompeur; par exemple, la méthode employée ne permet pas de détecter tous les phénols et différentes méthodes peuvent donner des résultats différents."@fr , "Note 1 to entry: The term ‘total’ can be misleading, e.g. not all phenols can be detected by the method and different methods can give different results."@en ;
        skos:prefLabel   "total concentration"@en , "concentration totale"@fr ;
        <https://w3id.org/dpv#hasContext>
                "for organics"@en , "pour les matières organiques"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.412>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.412> ;
        skos:definition  "appareillage ou outil permettant d'obtenir un <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">échantillon&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> de sol ou de <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.459\">matériau du sol&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.459)</span></a></span>"@fr , "apparatus or tool used to obtain a <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.398\">sample <span class=\"sts-tbx-entailedTerm-num\">(3.398)</span></a></span> from soil or <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.459\">soil material <span class=\"sts-tbx-entailedTerm-num\">(3.459)</span></a></span>"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.412" ;
        skos:prefLabel   "sampling device"@en , "dispositif d'échantillonnage"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.327>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.327> ;
        skos:definition  "input of a substance from a stationary discrete <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.484\">source <span class=\"sts-tbx-entailedTerm-num\">(3.484)</span></a></span> of definite size"@en , "apport d'une substance par une <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.484\">source&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.484)</span></a></span> ponctuelle fixe de taille définie"@fr ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.327" ;
        skos:note        "Note 2 à l’article: L'apport dû à une source ponctuelle peut être à l'origine de sites localement contaminés (3.248) comme de sites contaminés de manière relativement uniforme (3.558)."@fr , "Note 1 à l’article: Les sources peuvent être les émissions d'une cheminée, des déversements accidentels, des dépôts d'ordures, des déversements sur sites (3.443) industriels, ou encore des fuites importantes provenant des égouts et d'autres canalisations."@fr , "Note 2 to entry: Point source input can cause both locally contaminated sites (3.248) and relatively uniformly contaminated sites (3.558)."@en , "Note 1 to entry: The sources can be stack emissions, accidental spills, waste dumps, spills on industrial site (3.443), major leaks from sewers and other pipelines."@en ;
        skos:prefLabel   "point source input"@en , "apport dû à une source ponctuelle"@fr .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.201>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.201> ;
        skos:definition  "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.443\">site&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.443)</span></a></span> jugé dangereux pour la santé et la <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.397\">sécurité&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.397)</span></a></span> humaine ou pour l'environnement, en raison des substances ou des agents présents"@fr , "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.443\">site <span class=\"sts-tbx-entailedTerm-num\">(3.443)</span></a></span> which, by reason of the substances or agents present, is judged to be hazardous to human health and <span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.397\">safety <span class=\"sts-tbx-entailedTerm-num\">(3.397)</span></a></span> or to the environment"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.201" ;
        skos:prefLabel   "site dangereux"@fr , "hazardous site"@en .

<https://data.geoscience.earth/ncl/ISO11074v2025/3.31>
        a                skos:Concept ;
        owl:sameAs       <https://www.iso.org/obp/ui/en/#iso:std:iso:11074:ed-3:v1:en:term:3.31> ;
        skos:definition  "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.210\">hydrocarbure&nbsp; <span class=\"sts-tbx-entailedTerm-num\">(3.210)</span></a></span> dont la structure moléculaire comprend un ou plusieurs cycles planaires de six atomes de carbone, liés par des électrons délocalisés dont le nombre est le même que s'ils formaient une alternance de liaisons covalentes simples et doubles"@fr , "<span class=\"sts-tbx-entailedTerm\"><a href=\"https://data.geoscience.earth/ncl/ISO11074v2025/3.210\">hydrocarbon <span class=\"sts-tbx-entailedTerm-num\">(3.210)</span></a></span> of which the molecular structure incorporates one or more planar sets of six carbon atoms that are connected by delocalized electrons, numbering the same as if they consisted of alternating single and double covalent bonds"@en ;
        skos:inScheme    <https://data.geoscience.earth/ncl/ISO11074v2025> ;
        skos:notation    "3.31" ;
        skos:prefLabel   "aromatic hydrocarbon"@en , "hydrocarbure aromatique"@fr .

